# 开发环境配置（本地开发，非敏感）
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# 开发用 SQLite 免装 MySQL（切换 MySQL 时置空 DATABASE_URL）
DATABASE_URL=sqlite:///./pinglu_didi_dev.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pinglu_didi_dev
DB_USER=root
DB_PASSWORD=dev_password_change_me

# JWT（本地开发占位值；生产由 secrets 注入）
JWT_SECRET_KEY=dev-only-secret-key
JWT_EXPIRE_MINUTES=720

REDIS_URL=redis://127.0.0.1:6379/0
MATCH_STAGE1_TIMEOUT_MS=200

# 微信：无 appid 时开启 Mock 登录（openid=mock-openid-{code}）
WECHAT_MOCK=true
WX_APP_ID=
WX_APP_SECRET=
WX_MCH_ID=
WX_PAY_KEY=

# 智能体：开发环境默认走内置规则模板（零网络、零 Key）
# clone 即得完整演示态：四个智能入口（客服/一句话发货/合规预检/统一路由）全部可用且输出可复现。
# 需接真实大模型时，在 .env.local（不入库，优先级高于本文件）写：
#   LLM_MOCK=false
#   LLM_API_KEY=sk-xxx
LLM_MOCK=true
LLM_GATEWAY_URL=
VECTOR_DB_URL=
