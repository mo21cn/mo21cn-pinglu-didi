      "expect": {
        "cargo_name": { "keywords": ["水泥"] },
        "cargo_type": "bulk",
        "weight_t": 30,
        "origin_port": "NNG",
        "dest_port": "GGU",
        "expect_date": { "ymd": "10-08" },
        "offer_price": 8000
      }
    },
    {
