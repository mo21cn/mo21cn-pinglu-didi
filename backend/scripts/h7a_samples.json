{
  "_comment": "H7a 真实模型质量验证样本集（cargo_parse）。expect 为参考答案，评分为机器判定，不需要人工逐条看。",
  "_grading": {
    "cargo_name": "参考答案 keywords 任一出现在模型输出里（去空格、忽略大小写）",
    "cargo_type": "枚举精确匹配",
    "weight_t": "数值相对容差 0.5%；null 与非 null 不一致即判错",
    "origin_port": "13 个港口代码精确匹配",
    "dest_port": "13 个港口代码精确匹配",
    "expect_date": "字符串完全相等；{ymd} 按运行年份展开；{next_weekday} 按运行日期推算",
    "offer_price": "数值相对容差 0.5%；null 与非 null 不一致即判错",
    "hallucination": "期望 null 却给出非 null，单独计数（硬指标，不折算成分数）"
  },
  "samples": [
    {
      "id": "S01",
      "note": "完整信息·散货",
