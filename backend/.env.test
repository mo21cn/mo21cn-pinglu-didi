# 测试环境配置（CI / 测试环境，非敏感）
APP_ENV=test
DEBUG=false
LOG_LEVEL=INFO

# 测试/CI 用 SQLite 内存库
DATABASE_URL=sqlite:///./pinglu_didi_test.db
JWT_SECRET_KEY=test-only-secret-key-0123456789abcdef0123456789

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pinglu_didi_test
