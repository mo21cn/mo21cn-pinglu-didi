DB_PASSWORD=test_password_change_me

# CI 无微信 appid，一律 Mock
WECHAT_MOCK=true

REDIS_URL=redis://127.0.0.1:6379/1
MATCH_STAGE1_TIMEOUT_MS=200

WX_APP_ID=
WX_APP_SECRET=
LLM_GATEWAY_URL=
