# ===== 环境配置模板（.env.example）=====
# 复制为 .env 使用；各环境基线见 .env.development / .env.test / .env.production
# 敏感值（密钥/密码）一律留空，由 CI/CD secrets 或部署环境注入，禁止写死。

# ===== 基础 =====
APP_NAME=pinglu-didi
APP_ENV=development          # development | test | production
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000

# ===== 数据库（MySQL） =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pinglu_didi
DB_USER=root
DB_PASSWORD=

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== 微信生态 =====
WX_APP_ID=
WX_APP_SECRET=
WX_MCH_ID=
WX_PAY_KEY=

# ===== 撮合引擎 =====
MATCH_STAGE1_TIMEOUT_MS=200

# ===== 智能体 =====
LLM_GATEWAY_URL=
VECTOR_DB_URL=
