# ===== 环境配置模板（.env.example）=====
# 复制为 .env 使用；各环境基线见 .env.development / .env.test / .env.production
# 敏感值（密钥/密码）一律留空，由 CI/CD secrets 或部署环境注入，禁止写死。

# ===== 基础 =====
APP_NAME=pinglu-didi
APP_ENV=development          # development | test | production
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000

# ===== 数据库（MySQL） =====
# 开发/测试可用 SQLite 覆盖：DATABASE_URL=sqlite:///./pinglu_didi_dev.db
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pinglu_didi
DB_USER=root
DB_PASSWORD=

# ===== 认证（JWT） =====
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== 微信生态 =====
# 本地开发无 appid 时可设 WECHAT_MOCK=true（openid=mock-openid-{code}）
WECHAT_MOCK=false
WX_APP_ID=
WX_APP_SECRET=
WX_MCH_ID=
WX_PAY_KEY=

# ===== 撮合引擎 =====
MATCH_STAGE1_TIMEOUT_MS=200

# ===== 智能体 =====
# LLM_MOCK=true → 内置规则模板，无 Key / 零网络也能完整演示（各环境基线见 .env.development）
# 接真实模型：LLM_MOCK=false 且填 LLM_API_KEY（DeepSeek 等 OpenAI 兼容协议）
LLM_MOCK=false
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_GATEWAY_URL=
VECTOR_DB_URL=
