# 统一行尾为 LF，避免 Windows CRLF 与 Linux 部署冲突
* text=auto eol=lf

# 二进制文件不进行行尾/文本转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

# 脚本与源码强制 LF
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
