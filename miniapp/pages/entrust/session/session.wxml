<!--
  委托发货 · 专业会话屏（UI-03 / DR-0015 / ENT-033 / **S2 首片 + 第二片 + 第三片**）

  本页三块内容：
    1. 报价单附件：上传 → 提取 → 引用（BP-02 的 attachment selection，演示第 2 步）；
    2. 真实会话：消息时间线 + 输入框 + 作业卡（S2 首片）；
    3. 成果卡：与工作台、成果页同源同版本（AC-05 的聊天侧）。

  四处刻意的写法
  --------------
  * 作业卡写「**提案**」而不是「解析结果」：作业成功只产出 envelope，
    它变成成果要再走一次**人工采纳**（AC-09）。写成"结果"会让人以为已落库。
  * 提案内容**逐字段列出**（价格/单位/有效期/含与不含…）：BP-02 要求"类型化提案"，
    而"人工采纳"的前提正是**人看过了内容** —— 只显示"提案 1 条"等于把该看的东西藏起来。
  * 采纳用**页内确认条**，不用原生 `wx.showModal`：它是本页唯一改变业务状态的动作，
    而原生弹层不在渲染树里（工具点不到确认键）⇒ 关键路径拿不到设备证据。
  * fixture 模式有独立提示条：结构与真实模式同构，但**不是真实模型输出**，
    混在一起报就等于拿假证据充数。

  编译禁形：条件与循环**分两层**，绝不把 `wx:for` 写到带 `wx:if` 的元素上
  （`wx:else` 会绑不到 `wx:if` ⇒ 整页编译失败，见 verify_wxml_directives.js）。
-->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-inner">
      <view class="nav-back" bindtap="onBack">返回</view>
      <view class="nav-title">专业会话</view>
      <view class="nav-slot"></view>
    </view>
  </view>

  <view class="session-head">
    <text class="session-title">委托 #{{assignmentId}}</text>
    <text class="session-sub">{{sessionTitle}} · {{sessionStatusLabel}} · {{attachmentText}}</text>
  </view>

  <view wx:if="{{adoptNotice}}" class="adopt-note">
    <text class="adopt-note-text">{{adoptNotice}}</text>
  </view>

  <view wx:if="{{mockedNote}}" class="mock-note">
    <text class="mock-note-text">{{mockedNote}}</text>
  </view>

  <view wx:if="{{view === 'loading'}}" class="state">
    <view class="state-title">{{viewTitle}}</view>
    <view class="state-hint">{{viewHint}}</view>
  </view>
  <view wx:elif="{{view === 'expired'}}" class="state">
    <view class="state-title">{{viewTitle}}</view>
    <view class="state-hint">{{viewHint}}</view>
  </view>
  <view wx:elif="{{view === 'denied'}}" class="state">
    <view class="state-title">{{viewTitle}}</view>
    <view class="state-hint">{{viewHint}}</view>
  </view>
  <view wx:elif="{{view === 'error'}}" class="state">
    <view class="state-title">{{viewTitle}}</view>
    <view class="state-hint">{{viewHint}}</view>
  </view>
  <view wx:elif="{{view === 'empty'}}" class="state">
    <view class="state-title">{{viewTitle}}</view>
    <view class="state-hint">{{viewHint}}</view>
  </view>
  <view wx:else>
    <!-- 报价单附件（BP-02 的 attachment selection / 演示第 2 步）。
         ⚠️ 这里刻意把「已上传」与「Agent 读得到」做成两行不同的信息：
         只有提取完成（done）的附件才有文本进 Agent 的来源目录，
         未提取的附件对 Agent 而言只是"一个文件名"。
         把这两件事合成一句"上传成功"，就是拿一件没发生的事当事实说。 -->
    <view class="section">
      <view class="section-title">报价单附件（{{attachments.length}}）</view>

      <view wx:if="{{attachNotice}}" class="attach-note">
        <text class="attach-note-text">{{attachNotice}}</text>
      </view>

      <block wx:for="{{attachments}}" wx:key="attachmentId">
        <view class="att">
          <view class="att-head">
            <text class="att-name">{{item.name}}</text>
            <text class="att-size">{{item.sizeText}}</text>
          </view>
          <view class="att-meta">
            <text class="att-status">{{item.extractLabel}}</text>
            <text class="att-src">文本来源：{{item.textSourceLabel}}</text>
          </view>
          <view class="att-hint-row">
            <text class="att-hint">{{item.referenceHint}}</text>
          </view>

          <!-- 三个动作各自带条件：可引用（有文本）/ 重抽 / 人工转录。
               条件写在**子元素**上，不写在这个 wx:for 的元素上（编译禁形）。 -->
          <view class="att-actions">
            <view
              wx:if="{{item.canReference}}"
              class="att-btn"
              data-act-use-attachment="1"
              data-attachment_id="{{item.attachmentId}}"
              hover-class="hover-dim"
              bindtap="onUseAttachment"
            >让 Agent 解析这份报价单</view>
            <view
              class="att-btn"
              data-act-reextract-open="1"
              data-attachment_id="{{item.attachmentId}}"
              hover-class="hover-dim"
              bindtap="onReextractAsk"
            >{{item.extractStatus === 'not_requested' ? '提取文本' : '重新提取'}}</view>
            <view
              wx:if="{{item.canTranscribe}}"
              class="att-btn"
              data-act-transcribe-open="1"
              data-attachment_id="{{item.attachmentId}}"
              hover-class="hover-dim"
              bindtap="onTranscribeOpen"
            >人工转录</view>
          </view>

          <!-- 重抽前先问一句：这份文本是人工转录的，覆盖不可恢复 -->
          <view wx:if="{{reextractId === item.attachmentId}}" class="confirm-bar">
            <text class="confirm-text">这份附件的文本来自人工转录，重新提取会覆盖它且不可恢复（提取失败时还会删掉）。确认覆盖？</text>
            <view class="confirm-actions">
              <view
                class="confirm-cancel"
                data-act-reextract-cancel="1"
                bindtap="onReextractCancel"
              >取消</view>
              <view
                class="confirm-ok"
                data-act-reextract-confirm="1"
                bindtap="onReextractConfirm"
              >确认重抽</view>
            </view>
          </view>

          <!-- 人工转录录入（图片/扫描件的降级通道） -->
          <view wx:if="{{transcribeId === item.attachmentId}}" class="confirm-bar">
            <text class="confirm-text">人工转录：把这份文件的内容抄进来。提交后来源标记为「人工转录」，Agent 就能读到它。</text>
            <textarea
              class="transcribe-input"
              value="{{transcribeDraft}}"
              bindinput="onTranscribeInput"
              placeholder="粘贴或输入报价单内容"
            />
            <view class="confirm-actions">
              <view
                class="confirm-cancel"
                data-act-transcribe-cancel="1"
                bindtap="onTranscribeCancel"
              >取消</view>
              <view
                class="confirm-ok"
                data-act-transcribe-submit="1"
                bindtap="onTranscribeSubmit"
              >提交转录</view>
            </view>
          </view>
        </view>
      </block>

      <view wx:if="{{attachments.length === 0}}" class="empty-line">
        <text class="empty-line-text">还没有附件。上传一份样报价单，Agent 才能按文件内容解析，而不是靠手打</text>
      </view>

      <view
        class="att-upload"
        data-act-pick-quote="1"
        hover-class="hover-dim"
        bindtap="onPickQuote"
      >
        <text class="att-upload-text">{{uploading ? '上传并提取中…' : '上传报价单（文件）'}}</text>
      </view>

      <!-- 内置示例报价单。
           为什么必须有这条通路：原生文件选择器（`chooseMessageFile`）是 **OS 级弹层**，
           不在小程序渲染树里 ⇒ 自动走查够不着它的选择项（技能 `miniapp-device-walkthrough`
           的负面清单实测过），"演示第 2 步上传样报价单"就永远拿不到设备证据。
           技能把这条写成**界面要求**：附件入口要另给一个"预置样本"的页内通路。
           它同时也是给演示者的便利 —— 不必先把文件塞进模拟器才能演。
           ⚠️ 样本内容与后端 canonical 夹具同源，逐格比对在 `verify_entrust_ui.js`。 -->
      <view
        class="att-sample"
        data-act-sample-quote="1"
        hover-class="hover-dim"
        bindtap="onUseSampleQuote"
      >
        <text class="att-sample-text">{{uploading ? '上传并提取中…' : '用内置示例报价单（合成样件，不必选文件）'}}</text>
      </view>

      <!-- 拍照上传（调 OS 摄像头）：扫描件/纸质报价单的真机入口。
           ⚠️ 范围只到"调起摄像头拿一张图"，⛔ 不做 OCR、不做识别转换 ——
           拿不到机读文本时的出路是**人工转录**（附件行上的那个按钮）。
           摄像头是 OS 级弹层 ⇒ 走查够不着，该格记 LIMITATION（见下一条页内通路）。 -->
      <view
        class="att-sample"
        data-act-capture-scan="1"
        hover-class="hover-dim"
        bindtap="onCaptureScan"
      >
        <text class="att-sample-text">{{uploading ? '上传并提取中…' : '拍照上传（扫描件 / 纸质报价单）'}}</text>
      </view>

      <!-- 内置**扫描件样本**：一张真 PNG 字节流，走与"上传文件"完全同一条链。
           存在的理由与上面的示例报价单一样（真机通路在渲染树之外、走查够不着），
           它让「图片 ⇒ needs_transcription ⇒ 人工转录 ⇒ 可引用」这一段**可断言**。
           ⚠️ 后端**魔数优先**（AC-18）⇒ 真 PNG 本就该被判成图片，不是骗过嗅探。 -->
      <view
        class="att-sample"
        data-act-sample-scan="1"
        hover-class="hover-dim"
        bindtap="onUseSampleScan"
      >
        <text class="att-sample-text">{{uploading ? '上传并提取中…' : '用内置扫描件样本（合成 PNG，验证人工转录）'}}</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title">对话（{{messages.length}}）</view>

      <block wx:for="{{messages}}" wx:key="messageId">
        <view class="msg {{item.role === 'user' ? 'msg-me' : 'msg-agent'}}">
          <view class="msg-head">
            <text class="msg-role">{{item.roleLabel}}</text>
            <text class="msg-source">{{item.sourceLabel}}</text>
          </view>
          <view class="msg-body">{{item.content}}</view>
        </view>
      </block>

      <view wx:if="{{messages.length === 0}}" class="empty-line">
        <text class="empty-line-text">还没有消息。在下方粘贴一段报价文本，Agent 会解析它</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title">作业（{{jobs.length}}）</view>

      <!-- WP-1（2026-09-21）**对客报价金额**（可选，元）：填了它，
           「发送并解析」/「让 Agent 解析这份报价单」才会产出**对客报价**提案
           （后端 `ag02` 只在 `amount` 非空时产出该提案）；留空 ＝ 只解析、不报价。
           ⛔ 不是模型调用费；⛔ 也不替用户发明金额。 -->
      <view class="job-amount">
        <text class="job-amount-label">对客报价金额（元，可选）</text>
        <input
          class="job-amount-input"
          data-act-job-amount="1"
          value="{{jobAmount}}"
          placeholder="如 38000.00；留空则只解析、不报价"
          bindinput="onJobAmountInput"
        />
      </view>

      <block wx:for="{{jobs}}" wx:key="jobId">
        <view class="job">
          <view class="job-head">
            <text class="job-title">作业 #{{item.jobId}}</text>
            <text class="{{item.statusClass}}">{{item.statusLabel}}</text>
          </view>

          <view wx:if="{{item.status === 'failed'}}" class="job-fail">
            <text class="job-fail-text">{{item.errorKind ? '失败类型 ' + item.errorKind : '失败'}}{{item.errorMessage ? '：' + item.errorMessage : ''}}</text>
          </view>

          <view wx:elif="{{item.status === 'succeeded'}}" class="job-ok">
            <text class="job-ok-text">已产出提案 {{item.proposalCount}} 条（提案 ≠ 成果，需人工采纳）</text>
          </view>

          <view wx:else class="job-pending">
            <text class="job-pending-text">{{item.statusLabel}}，可再次进入本页查看结果</text>
          </view>

          <view wx:if="{{item.mocked}}" class="job-mock">
            <text class="job-mock-text">fixture 输出（LLM_MOCK），不是真实模型结果</text>
          </view>

          <!-- 来源（HO 0917-3 裁定二第 3 条）。
               ⚠️「附件」与「附件文本」必须分开显示：前者说"这个附件存在"，
               后者说"它的文本被读进来了"—— 画成一个样子等于替 Agent 把
               "读了"说成"有"。 -->
          <block wx:if="{{item.sources.length > 0}}">
            <view class="src-row">
              <text class="src-label">来源</text>
              <block wx:for="{{item.sources}}" wx:key="key" wx:for-item="src">
                <text class="src-chip">{{src.text}}</text>
              </block>
            </view>
          </block>

          <!-- 服务端**核不上**的引用（含 findings 内的嵌套引用）⇒ 必须警示 -->
          <block wx:if="{{item.unverified.length > 0}}">
            <view class="src-warn">
              <text class="src-warn-title">以下来源在服务端核不上，采纳前请先核对</text>
              <block wx:for="{{item.unverified}}" wx:key="key" wx:for-item="uv">
                <text class="src-warn-text">· {{uv.text}}</text>
              </block>
            </view>
          </block>

          <!-- 提案内容（类型化）。⚠️ 条件与循环分两层：外层 wx:if 的 block 只做判断，
               内层 block 只做循环 —— 写在同一个元素上会让 wx:else 绑不到 wx:if。 -->
          <block wx:if="{{item.proposalCount > 0}}">
            <block wx:for="{{item.proposals}}" wx:key="artifactType" wx:for-item="prop">
              <view class="prop">
                <view class="prop-head">
                  <text class="prop-title">{{prop.typeLabel}}</text>
                  <text class="prop-chip">{{prop.artifactType}}</text>
                </view>

                <block wx:for="{{prop.rows}}" wx:key="key" wx:for-item="row">
                  <view class="prop-row">
                    <text class="prop-key">{{row.label}}</text>
                    <text class="prop-val">{{row.value}}</text>
                  </view>
                </block>

                <view wx:if="{{prop.note}}" class="prop-note">
                  <text class="prop-note-text">{{prop.note}}</text>
                </view>

                <!-- 采纳不等于已核实：有核不上的来源时，采纳条上也要说清 -->
                <view wx:if="{{item.unverified.length > 0}}" class="src-warn">
                  <text class="src-warn-text">采纳不等于已核实：这份提案有 {{item.unverified.length}} 条来源核不上，采纳后仍是待核对草稿</text>
                </view>

                <view
                  wx:if="{{adoptingJobId === item.jobId && adoptingType === prop.artifactType}}"
                  class="confirm-bar"
                >
                  <text class="confirm-text">采纳「{{prop.typeLabel}}」为成果？这会新建一份成果（提案 ≠ 成果）。</text>
                  <view class="confirm-actions">
                    <view
                      class="confirm-cancel"
                      data-act-adopt-cancel="1"
                      bindtap="onAdoptCancel"
                    >取消</view>
                    <view class="confirm-ok" data-act-adopt-confirm="1" bindtap="onAdoptConfirm">确认采纳</view>
                  </view>
                </view>

                <view wx:elif="{{item.canAdopt}}" class="prop-actions">
                  <view
                    class="adopt-btn"
                    data-act-adopt="1"
                    data-job_id="{{item.jobId}}"
                    data-artifact_type="{{prop.artifactType}}"
                    hover-class="hover-dim"
                    bindtap="onAdoptAsk"
                  >采纳为成果</view>
                </view>
              </view>
            </block>
          </block>
        </view>
      </block>

      <view wx:if="{{jobs.length === 0}}" class="empty-line">
        <text class="empty-line-text">还没有作业</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title">本单成果（{{cards.length}}）</view>

      <block wx:for="{{cards}}" wx:key="artifactId">
        <view
          class="card"
          data-act-open-artifact="1"
          data-artifact_id="{{item.artifactId}}"
          hover-class="hover-dim"
          bindtap="onOpenArtifact"
        >
          <view class="card-head">
            <text class="card-title">成果 #{{item.artifactId}}</text>
            <text class="chip">v{{item.currentRevisionNo}}</text>
          </view>
          <view class="card-sub">{{item.typeLabel}} · {{item.statusLabel}}</view>

          <view class="card-rows">
            <block wx:for="{{item.preview}}" wx:for-item="f" wx:key="name">
              <view class="card-row">
                <text class="card-row-label">{{f.label}}</text>
                <text class="card-row-value">{{f.value}}</text>
              </view>
            </block>
          </view>

          <view class="card-actions">
            <text class="link">查看 / 编辑 →</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="composer">
    <input
      class="composer-input"
      value="{{draft}}"
      placeholder="粘贴报价文本，例如：贵港到梧州 500 吨水泥，单价 42 元/吨"
      bindinput="onDraft"
      confirm-type="send"
      bindconfirm="onSend"
    />
    <view
      class="composer-send {{sending ? 'composer-send-off' : ''}}"
      data-act-send="{{sending ? 0 : 1}}"
      bindtap="onSend"
    >
      <text class="composer-send-text">{{sending ? '执行中' : '发送并解析'}}</text>
    </view>
  </view>
</view>
