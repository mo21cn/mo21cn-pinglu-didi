/* 委托发货 · 专业会话屏（DR-0015 / ENT-033）
 *
 * 类**全部在本页定义**，不依赖全局样式兜底 —— `verify_entrust_ui.js` 会逐页核对
 * 模板里出现的类名是否有定义，`hover-dim` 这类 `hover-class` 漏定义只会静默无反馈。
 */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  background: #f5f6f8;
}

.nav {
  background: #ffffff;
  border-bottom: 1rpx solid #ececf0;
}

.nav-inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 120rpx;
  font-size: 28rpx;
  color: #576b95;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.nav-slot {
  width: 120rpx;
}

.session-head {
  padding: 28rpx 32rpx 8rpx;
}

.session-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.session-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8a;
}

/* ── 五态（错误优先于空，与其它委托页同口径） ───────────────────── */

.state {
  padding: 80rpx 48rpx;
  text-align: center;
}

.state-title {
  display: block;
  font-size: 30rpx;
  color: #333333;
}

.state-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a8a8a;
}

/* ── 成果卡 ──────────────────────────────────────────────────────── */

.section {
  padding: 16rpx 32rpx 0;
}

.section-title {
  display: block;
  margin: 12rpx 0 16rpx;
  font-size: 26rpx;
  color: #8a8a8a;
}

.card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.hover-dim {
  background: #f0f1f3;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.chip {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: #eef2ff;
  font-size: 22rpx;
  color: #3b5bdb;
}

.card-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a8a8a;
}

.card-rows {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f3;
}

.card-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.card-row-label {
  flex: 0 0 200rpx;
  font-size: 26rpx;
  color: #8a8a8a;
}

.card-row-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #333333;
  word-break: break-all;
}

.card-actions {
  margin-top: 14rpx;
  text-align: right;
}

.link {
  font-size: 26rpx;
  color: #576b95;
}

/* ── S2 首片：消息 / 作业 / 输入条 ──────────────────────────────── */

.mock-note {
  margin: 8rpx 32rpx 0;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: #fff7e6;
}

.mock-note-text {
  font-size: 24rpx;
  color: #a86400;
}

.msg {
  margin-bottom: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.msg-me {
  background: #e8f0fe;
}

.msg-agent {
  background: #ffffff;
}

.msg-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.msg-role {
  font-size: 24rpx;
  font-weight: 600;
  color: #333333;
}

.msg-source {
  font-size: 22rpx;
  color: #9a9a9a;
}

.msg-body {
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1a1a1a;
  word-break: break-all;
}

.empty-line {
  padding: 18rpx 4rpx;
}

.empty-line-text {
  font-size: 25rpx;
  color: #9a9a9a;
}

.job {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.job-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.job-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 状态 chip **不在本页定义** —— 用 `app.wxss` 的 `chip-*` 一族，
   由 `jobStatusClass()` 返回完整类名串。在本页另起一份就是第二份真相：
   全局改了颜色，本页不会跟着变（与其它委托页同口径）。 */

.job-fail {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: #fdecec;
}

.job-fail-text {
  font-size: 25rpx;
  color: #a5281b;
  word-break: break-all;
}

.job-ok {
  margin-top: 14rpx;
}

.job-ok-text {
  font-size: 25rpx;
  color: #1f7a36;
}

.job-pending {
  margin-top: 14rpx;
}

.job-pending-text {
  font-size: 25rpx;
  color: #8a8a8a;
}

.job-mock {
  margin-top: 12rpx;
}

.job-mock-text {
  font-size: 23rpx;
  color: #a86400;
}

.composer {
  position: sticky;
  bottom: 0;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #ececf0;
}

.composer-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 36rpx;
  background: #f3f4f6;
  font-size: 27rpx;
  color: #1a1a1a;
}

.composer-send {
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #2b6cb0;
}

.composer-send-off {
  background: #a9bdd4;
}

.composer-send-text {
  font-size: 27rpx;
  color: #ffffff;
}

/* ── 提案内容（BP-02「类型化提案」）───────────────────────────────────────
   提案要**逐字段可读**：人工采纳的前提是人看过了内容。字段值可能很长
   （航线、包含项清单），所以用两列布局 + 允许折行，而不是挤成一行。 */
.prop {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  border: 1rpx solid #e3e8ef;
}

.prop-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.prop-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.prop-chip {
  font-size: 22rpx;
  color: #5a6b82;
}

.prop-row {
  display: flex;
  margin-top: 10rpx;
}

.prop-key {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 25rpx;
  color: #8a8a8a;
}

.prop-val {
  flex: 1;
  font-size: 25rpx;
  color: #1a1a1a;
  word-break: break-all;
}

.prop-note {
  margin-top: 10rpx;
}

.prop-note-text {
  font-size: 24rpx;
  color: #8a8a8a;
}

.prop-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.adopt-btn {
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  background: #2b6cb0;
  font-size: 25rpx;
  color: #ffffff;
}

/* 采纳确认条：本页唯一改变业务状态的动作，**不用原生弹窗**
   （原生弹层不在渲染树里，工具点不到确认键 ⇒ 拿不到设备证据）。 */
.confirm-bar {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #fff8e6;
  border: 1rpx solid #f0d9a8;
}

.confirm-text {
  font-size: 25rpx;
  color: #7a5b12;
  line-height: 1.5;
}

.confirm-actions {
  margin-top: 14rpx;
  display: flex;
  justify-content: flex-end;
}

.confirm-cancel {
  padding: 10rpx 26rpx;
  border-radius: 28rpx;
  background: #eceef2;
  font-size: 25rpx;
  color: #4a4a4a;
}

.confirm-ok {
  margin-left: 16rpx;
  padding: 10rpx 26rpx;
  border-radius: 28rpx;
  background: #1f7a36;
  font-size: 25rpx;
  color: #ffffff;
}

/* 采纳结果提示：必须点名**成果编号**，否则用户无法确认"就是刚才那一份" */
.adopt-note {
  margin: 0 24rpx 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 10rpx;
  background: #e6f6ea;
}

.adopt-note-text {
  font-size: 25rpx;
  color: #1f7a36;
}

/* 附件区：上传 / 提取状态 / 引用入口。
   ⚠️ 状态与"能不能被引用"分成两行显示：只有提取完成（done）的附件才有文本
   进 Agent 的来源目录，未提取的附件对 Agent 只是文件名。合成一行会让人
   以为"传上去就完事了"。 */
.attach-note {
  margin: 0 0 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 10rpx;
  background: #fff4e0;
}

.attach-note-text {
  font-size: 25rpx;
  color: #b26a00;
}

.att {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f2;
}

.att-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.att-name {
  flex: 1;
  font-size: 27rpx;
  color: #1a1a1a;
}

.att-size {
  margin-left: 12rpx;
  font-size: 23rpx;
  color: #8a8a8a;
}

.att-meta {
  margin-top: 8rpx;
}

.att-status {
  font-size: 24rpx;
  color: #576b95;
}

.att-hint-row {
  margin-top: 6rpx;
}

.att-hint {
  font-size: 23rpx;
  color: #8a8a8a;
}

.att-actions {
  margin-top: 12rpx;
}

.att-btn {
  display: inline-block;
  padding: 10rpx 26rpx;
  border-radius: 28rpx;
  background: #eef1f8;
  font-size: 25rpx;
  color: #2b4b8f;
}

.att-upload {
  margin-top: 16rpx;
  padding: 18rpx 0;
  border-radius: 12rpx;
  border: 1rpx dashed #c8c8cc;
  text-align: center;
}

.att-upload-text {
  font-size: 26rpx;
  color: #4a4a4a;
}

/* 内置示例报价单入口：与「上传」并列，但视觉上更弱一档 ——
   它是便捷通路，不是主通路（真实演示仍以上传真文件为主）。 */
.att-sample {
  margin-top: 12rpx;
  padding: 18rpx 24rpx;
  border: 1rpx dashed #c9ccd4;
  border-radius: 10rpx;
  background: #fafbfc;
}

.att-sample-text {
  font-size: 25rpx;
  color: #576b95;
}

/* 附件行的文本来源标记（机读提取 / 人工转录）。
   它决定"重抽要不要先问"——所以不能省：省了用户就是在不知情下覆盖掉人写的内容。 */
.att-src {
  margin-left: 14rpx;
  font-size: 23rpx;
  color: #8a8a8a;
}

/* 多个动作按钮同行时的间距 */
.att-btn + .att-btn {
  margin-left: 12rpx;
}

/* 人工转录录入框 */
.transcribe-input {
  width: 100%;
  min-height: 160rpx;
  margin: 12rpx 0 4rpx;
  padding: 12rpx;
  box-sizing: border-box;
  border: 1rpx solid #dcdce0;
  border-radius: 8rpx;
  background: #ffffff;
  font-size: 25rpx;
  color: #1a1a1a;
}

/* 来源行与未核验警告。
   「附件」与「附件文本」在界面上必须是两种不同的东西：前者=附件存在，
   后者=文本被读进来了。合成一个"来源"笼统显示，等于替 Agent 把"读了"说成"有"。 */
.src-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 10rpx;
}

.src-label {
  margin-right: 10rpx;
  font-size: 23rpx;
  color: #8a8a8a;
}

.src-chip {
  margin: 0 10rpx 6rpx 0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #f0f0f2;
  font-size: 22rpx;
  color: #4a4a4a;
}

.src-warn {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  background: #fdecec;
}

.src-warn-title {
  display: block;
  font-size: 24rpx;
  color: #c0392b;
}

.src-warn-text {
  display: block;
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #c0392b;
}

/* WP-1（2026-09-21）：作业区的**对客报价金额**（可选）。
   视觉语言与 composer 一致，但**不放进**底部输入条 —— 它回答的是
   "这次作业要报多少"，属于「作业」这一节，不属于"我在说什么"。 */
.job-amount {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 12rpx 0 16rpx;
}

.job-amount-label {
  font-size: 24rpx;
  color: #6B7A90;
}

.job-amount-input {
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #1F2A37;
  background: #F2F5FA;
}
