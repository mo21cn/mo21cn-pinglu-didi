/* 委托发货 · 客户委托草稿 / 提交（UI-07 · S1）—— 只写本页特有排版，其余复用 app.wxss */

.head-bg {
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  padding-bottom: 24rpx;
}

.nav-inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  font-size: 48rpx;
  line-height: 1;
  color: #FFFFFF;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.nav-spacer {
  width: 64rpx;
}

.head-sub {
  padding: 0 28rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.85);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ── 表单 ─────────────────────────────────────────────────────────────
   表单块之间靠 `.card` 的外边距分开，块内不画分隔线：
   分隔线会把"同一件事的三个字段"切成三块，而这里每一张卡就是一件事。 */

.form-card {
  margin-top: 20rpx;
}

.form-label {
  font-size: 27rpx;
  font-weight: 600;
  color: #0F2540;
}

.form-gap {
  margin-top: 28rpx;
}

/* 选择条：与工作台的筛选条同形（`.filter-pill`），但选中态用主色填充 ——
   筛选条是"看哪一档"，这里是"交给谁"，后者必须一眼看出已选 */
.pick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.pick-pill {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #F1F4F8;
  font-size: 25rpx;
  color: #6B7A8C;
}

.pick-pill-on {
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  color: #FFFFFF;
  font-weight: 500;
}

.form-input {
  margin-top: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1F4F8;
  font-size: 28rpx;
  color: #0F2540;
}

.form-textarea {
  margin-top: 16rpx;
  width: 100%;
  min-height: 140rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #F7F9FC;
  font-size: 27rpx;
  color: #0F2540;
  box-sizing: border-box;
}

.form-tip {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #98A6B8;
  line-height: 1.6;
}

.form-tip-inline {
  font-size: 23rpx;
  color: #98A6B8;
}

/* 草稿已建立：这张卡整体处于"锁定待提交"状态，必须**显式说出来** ——
   否则用户会以为输入框坏掉了（点了没反应）。 */
.draft-note {
  margin-bottom: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #FFF7E6;
  font-size: 24rpx;
  color: #96601C;
  line-height: 1.6;
  /* 文字 + 「重新填写」并排：按钮必须留在这一块里，否则用户读到"内容已锁定"时
     看不到任何脱身出口（只能返回，而返回会触发放弃确认）。 */
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 文字占满剩余宽度，按钮不被挤走（长文案下按钮换行会看起来像页脚而不是操作） */
.draft-note-text {
  flex: 1;
  padding-right: 16rpx;
}

/* 「重新填写」：明确的**次要**动作 —— 有边框、可点，但不与主按钮抢视觉权重 */
.draft-note-act {
  flex: none;
  padding: 6rpx 16rpx;
  border: 1rpx solid #96601C;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #96601C;
}

/* ── 提交 ───────────────────────────────────────────────────────────── */

.submit-card {
  margin-bottom: 24rpx;
}

.submit-btn {
  padding: 26rpx 0;
  text-align: center;
}

/* ---- 本页 hover 反馈 ----
   `hover-dim` 是页面级类（app.wxss 未定义），用到就自带一份；
   漏声明只会表现为"点了没反馈"，不会报错（verify_entrust_ui.js 有专门检查）。 */
.hover-dim {
  opacity: .6;
}
