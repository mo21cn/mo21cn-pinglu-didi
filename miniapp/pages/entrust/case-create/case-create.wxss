/* 委托发货 · 登记案件（ENT-030 切片四之六）—— 只写本页特有排版，其余复用 app.wxss */

.head-bg {
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  padding-bottom: 24rpx;
}

.nav-inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  font-size: 48rpx;
  line-height: 1;
  color: #FFFFFF;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.nav-spacer {
  width: 64rpx;
}

.head-sub {
  padding: 0 28rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.85);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ── 表单 ─────────────────────────────────────────────────────────────
   表单块之间靠 `.card` 的外边距分开，块内不画分隔线：
   分隔线会把"同一件事的三个字段"切成三块，而这里每一张卡就是一件事。 */

.form-card {
  margin-top: 20rpx;
}

.form-label {
  font-size: 27rpx;
  font-weight: 600;
  color: #0F2540;
}

.form-gap {
  margin-top: 28rpx;
}

/* 选择条：与工作台的筛选条同形（`.filter-pill`），但选中态用主色填充 ——
   筛选条是"看哪一档"，这里是"填什么"，后者必须一眼看出已选 */
.pick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.pick-pill {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #F1F4F8;
  font-size: 25rpx;
  color: #6B7A8C;
}

.pick-pill-on {
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  color: #FFFFFF;
  font-weight: 500;
}

.form-input {
  margin-top: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1F4F8;
  font-size: 28rpx;
  color: #0F2540;
}

.form-textarea {
  margin-top: 16rpx;
  width: 100%;
  min-height: 140rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #F7F9FC;
  font-size: 27rpx;
  color: #0F2540;
  box-sizing: border-box;
}

.form-tip {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #98A6B8;
  line-height: 1.6;
}

.form-tip-inline {
  font-size: 23rpx;
  color: #98A6B8;
}

.form-empty {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: #B4BECC;
  line-height: 1.6;
}

/* ── 受影响项 ───────────────────────────────────────────────────────── */

.link-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F4F6FB;
}

.link-main {
  flex: 1;
  min-width: 0;
}

.link-text {
  font-size: 27rpx;
  color: #3D4C63;
}

.link-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #98A6B8;
}

.link-remove {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(59, 91, 219, .25);
  font-size: 23rpx;
  color: #3B5BDB;
}

.link-add {
  margin-top: 20rpx;
  padding: 20rpx 0;
  text-align: center;
  border-radius: 12rpx;
  border: 1rpx dashed rgba(59, 91, 219, .35);
  font-size: 26rpx;
  color: #3B5BDB;
}

.cand-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx solid #F4F6FB;
}

.cand-add {
  flex-shrink: 0;
  width: 52rpx;
  text-align: center;
  font-size: 34rpx;
  color: #3B5BDB;
}

/* ── 截止时间 ───────────────────────────────────────────────────────── */

.due-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.due-value {
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: #F7F9FC;
  font-size: 27rpx;
  color: #0F2540;
}

.due-value-empty {
  color: #B7C2D0;
}

/* ── 提交 ───────────────────────────────────────────────────────────── */

.submit-card {
  margin-bottom: 24rpx;
}

.submit-btn {
  padding: 26rpx 0;
  text-align: center;
}

/* ---- 本页 hover 反馈 ----
   `hover-dim` 是页面级类（app.wxss 未定义），用到就自带一份；
   漏声明只会表现为"点了没反馈"，不会报错（verify_entrust_ui.js 有专门检查）。 */
.hover-dim {
  opacity: .6;
}
