<!--
  委托发货 · 经理工作台（ENT-012 / AC-04）
  五态（AC-21）：loading / error / expired / denied / empty / ready —— 由 `view` 一个字段驱动。
  判定集中在 utils/entrust.js（可被 scripts/verify_entrust_ui.js 在 CI 里直接驱动），
  模板本身不做判断，只做映射。
-->
<view class="page">
  <view class="head-bg" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-inner">
      <view class="nav-back" bindtap="onBack" hover-class="hover-dim">‹</view>
      <text class="nav-title">委托发货</text>
      <view class="nav-spacer"></view>
    </view>
    <view class="head-sub">经理工作台 · 组织委托队列</view>

    <!--
      组织选择器（ENT-012 第二切片）：只在**多于一个组织**时出现 ——
      唯一组织时让用户做一次没有选择余地的选择，是纯噪音。
      候选来自服务端 `GET /my-orgs`：前端无法自行枚举（本地角色字段可篡改，
      且它表达的从来不是"我属于哪些组织"）。
    -->
    <view wx:if="{{orgs.length > 1}}" class="org-bar">
      <scroll-view class="org-scroll" scroll-x="true" enable-flex="true">
        <view class="org-pills">
          <view
            wx:for="{{orgs}}"
            wx:key="orgId"
            class="org-pill {{activeOrgId === item.orgId ? 'org-pill-active' : ''}}"
            data-org="{{item.orgId}}"
            bindtap="onPickOrg"
            hover-class="hover-dim"
          >{{item.name}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!--
    队列切换（UI-04 / 切片四之六）：委托队列 ↔ 异常与变更。
    它是**视图切换**而不是筛选 —— 两个队列的数据源与筛选维度都不同，所以放在
    筛选条之上并与它视觉分层（与组织选择器的分层理由相同：三层切换不能长得一样）。
  -->
  <view class="queue-bar">
    <view
      class="queue-pill {{queue === 'assignment' ? 'queue-pill-active' : ''}}"
      data-queue="assignment"
      bindtap="onSwitchQueue"
      hover-class="hover-dim"
    >委托队列</view>
    <view
      class="queue-pill {{queue === 'case' ? 'queue-pill-active' : ''}}"
      data-queue="case"
      bindtap="onSwitchQueue"
      hover-class="hover-dim"
    >异常与变更</view>
  </view>

  <!-- 委托队列的状态筛选：错误/空态下也保留，用户要先能改条件再重试 -->
  <scroll-view wx:if="{{queue === 'assignment'}}" class="filter-scroll" scroll-x="true" enable-flex="true">
    <view class="filter-bar">
      <view
        wx:for="{{filters}}"
        wx:key="key"
        class="filter-pill {{activeStatus === item.key ? 'filter-pill-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onFilter"
        hover-class="hover-dim"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <!--
    案件队列的两行筛选：第一行开闭范围，第二行案件类型。
    刻意**不合成一行**：合成一行后「全部」会出现两次，用户分不清自己点的是哪一个。
    这两行是 `scope` 与 `kind` 两个正交维度，不是同一列候选项。
  -->
  <block wx:else>
    <scroll-view class="filter-scroll" scroll-x="true" enable-flex="true">
      <view class="filter-bar">
        <view
          wx:for="{{caseScopes}}"
          wx:key="key"
          class="filter-pill {{activeCaseScope === item.key ? 'filter-pill-active' : ''}}"
          data-case-scope="{{item.key}}"
          bindtap="onCaseScope"
          hover-class="hover-dim"
        >{{item.label}}</view>
      </view>
    </scroll-view>
    <scroll-view class="filter-scroll" scroll-x="true" enable-flex="true">
      <view class="filter-bar">
        <view
          wx:for="{{caseKinds}}"
          wx:key="key"
          class="filter-pill {{activeCaseKind === item.key ? 'filter-pill-active' : ''}}"
          data-case-kind="{{item.key}}"
          bindtap="onCaseKind"
          hover-class="hover-dim"
        >{{item.label}}</view>
      </view>
    </scroll-view>
  </block>

  <view class="page-content">
    <!-- 加载中 -->
    <view wx:if="{{view === 'loading'}}" class="empty">
      <text class="empty-icon">⏳</text>
      {{viewTitle}}
    </view>

    <!-- 登录过期 -->
    <view wx:elif="{{view === 'expired'}}" class="err-card">
      <view class="err-title">{{viewTitle}}</view>
      <view class="err-detail">{{viewHint}}</view>
      <view class="err-btn" bindtap="onRelogin" hover-class="hover-dim">返回首页重新进入</view>
    </view>

    <!-- 无权限 / 需选组织 / 功能未开放 -->
    <view wx:elif="{{view === 'denied'}}" class="err-card">
      <view class="err-title">{{viewTitle}}</view>
      <view class="err-detail">{{viewHint}}</view>
    </view>

    <!-- 其它失败 -->
    <view wx:elif="{{view === 'error'}}" class="err-card">
      <view class="err-title">{{viewTitle}}</view>
      <view class="err-detail">{{viewHint}}</view>
      <view class="err-btn" bindtap="onRetry" hover-class="hover-dim">重试</view>
    </view>

    <!-- 空 -->
    <view wx:elif="{{view === 'empty'}}" class="empty">
      <text class="empty-icon">📭</text>
      {{viewTitle}}
      <view class="empty-hint">{{viewHint}}</view>
    </view>

    <!-- 正常 -->
    <block wx:else>
      <view class="list-head row-between">
        <text class="result-count">{{pageHint}}</text>
        <!-- 「只读」要说清是哪一种只读：本队列**没有**登记/处置入口（那在案件页与
             登记表单，由 `capabilities` 决定可用性），避免用户以为卡片点不动是坏了 -->
        <text class="chip chip-muted">{{queue === 'assignment' ? '只读列表' : '只读清单'}}</text>
      </view>

      <!-- 委托队列 -->
      <block wx:if="{{queue === 'assignment'}}">
        <view
          wx:for="{{items}}"
          wx:key="assignmentId"
          class="card list-card"
          data-id="{{item.assignmentId}}"
          bindtap="onOpen"
          hover-class="row-hover"
        >
          <view class="row-between">
            <text class="card-title">{{item.title}}</text>
            <text class="{{item.statusClass}}">{{item.statusLabel}}</text>
          </view>
          <view class="card-line">{{item.cargoSummary}}</view>
          <view class="card-line card-line-weak">{{item.quantityText}}</view>
          <view class="card-foot row-between">
            <text class="card-meta">#{{item.assignmentId}} · {{item.createdAt}}</text>
            <view class="card-acts">
              <!-- 「受理」（S1 工作项 4 / D1-02）：只在**待受理**（`submitted`）时出现。
                   是否真有权限由服务端判定 —— 与详情页 `canClaim` 同一条判据，
                   前端不假装知道（无权限时服务端 403，请求层如实提示）。
                   确认条做成**页内 DOM** 而不是 `wx.showModal`：原生弹层不在渲染树里，
                   走查工具点不到它的确认键 ⇒ "确认之后"那一步就永远拿不到设备证据
                   （同 ENT-041 案件页「应用变更」的取向；受理是本页唯一会改变业务状态
                   的动作，不可回退，所以它必须可验证）。
                   三个属性名两两不同：`onToggleClaim` 被两个元素共用，若都写
                   `data-act-claim` 会让"展开"与"取消"在断言里同形，登记表也按
                   file|attr 去重、只能登记一个。 -->
              <block wx:if="{{item.canClaim}}">
                <!-- ⚠️ 比较前必须把卡片 id **字符串化**：`claimOpenId` 来自 dataset
                     （显式 `String()` 归一），而投影层的 `assignmentId` 是数字。
                     WXML 的 `===` 是严格比较，一边字符串一边数字会**永远不相等** ——
                     表现是"点了受理没反应"（确认条不显示），且静态门禁查不出来。 -->
                <block wx:if="{{claimOpenId === item.assignmentId + ''}}">
                  <view
                    class="card-act card-act-strong"
                    data-act-claim-submit="{{item.assignmentId}}"
                    catchtap="onSubmitClaim"
                    hover-class="hover-dim"
                  >确认受理</view>
                  <view
                    class="card-act"
                    data-act-claim-cancel="{{item.assignmentId}}"
                    catchtap="onToggleClaim"
                    hover-class="hover-dim"
                  >取消</view>
                </block>
                <view
                  wx:else
                  class="card-act"
                  data-act-claim="{{item.assignmentId}}"
                  catchtap="onToggleClaim"
                  hover-class="hover-dim"
                >受理</view>
              </block>
              <!-- 「打开会话」（DR-0015 / AC-05 的聊天侧入口）：
                   用 `catchtap` 而不是 `bindtap` —— 卡片整体已 bindtap="onOpen"，
                   用 bindtap 会**同时**跳详情与会话（两个动作都跑，看起来像"点一次跳了两页"）。
                   锚点 `data-act-session` 与卡片自己的 `data-id` 分开，才能让走查
                   **唯一命中**这个动作（同名属性复用会让"点第 i 个动作"失去意义）。 -->
              <view
                class="card-act"
                data-act-session="{{item.assignmentId}}"
                catchtap="onOpenSession"
                hover-class="hover-dim"
              >会话 ›</view>
            </view>
          </view>
        </view>
      </block>

      <!-- 异常 / 变更队列（UI-04）：跨委托，所以每一行都写明「是哪张单的」 -->
      <block wx:else>
        <view
          wx:for="{{items}}"
          wx:key="caseId"
          class="card list-card"
          data-case-id="{{item.caseId}}"
          bindtap="onOpenCase"
          hover-class="row-hover"
        >
          <view class="row-between">
            <text class="card-title">{{item.title}}</text>
            <text class="{{item.statusClass}}">{{item.statusLabel}}</text>
          </view>
          <view class="list-chips">
            <text class="{{item.impactClass}}">{{item.impactLabel}}</text>
            <text class="chip chip-muted">{{item.kindLabel}}</text>
          </view>
          <!-- 阻断是流程后果（相关任务直接 409），在清单里就要看得见，
               不能让用户点进去才发现这单走不动 -->
          <view wx:if="{{item.blocking}}" class="case-block-flag">阻断执行中：相关任务无法完成，直到案件关闭</view>
          <view class="card-line card-line-weak">{{item.assignmentText}} · {{item.affectedText}} · {{item.dueText}}</view>
          <view class="card-foot row-between">
            <text class="card-meta">{{item.caseNo}} · 更新 {{item.updatedAt}}</text>
            <text class="card-caret">›</text>
          </view>
        </view>
      </block>
    </block>
  </view>
</view>
