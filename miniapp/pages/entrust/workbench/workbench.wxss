/* 委托发货 · 经理工作台（ENT-012）
   只写本页特有部分：顶栏 / 筛选条滚动容器 / 卡片内的排版。
   颜色、圆角、阴影、chip、err-card、filter-pill 全部复用 app.wxss，避免第二套设计语言。 */

.head-bg {
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  padding-bottom: 24rpx;
}

.nav-inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  font-size: 48rpx;
  line-height: 1;
  color: #FFFFFF;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* 与 nav-back 等宽，保证标题真正居中 */
.nav-spacer {
  width: 64rpx;
}

.head-sub {
  padding: 0 28rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

/* ---- 组织选择器（ENT-012 第二切片）----
   位于顶栏渐变之内，只在多组织时出现。沿用筛选条的 pill 语言，
   但以半透明白底把「我在哪个组织」与「我在看哪个状态」分成视觉两层，
   避免用户把两层切换混淆成同一个筛选条。 */
.org-bar {
  margin-top: 16rpx;
}

.org-scroll {
  white-space: nowrap;
}

.org-scroll .org-pills {
  display: inline-flex;
  padding: 0 24rpx;
}

.org-pill {
  margin-right: 12rpx;
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  font-size: 25rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.22);
}

.org-pill-active {
  background: #FFFFFF;
  color: #3B5BDB;
  font-weight: 600;
}

.filter-scroll {
  white-space: nowrap;
  padding-top: 20rpx;
}

.filter-scroll .filter-bar {
  display: inline-flex;
  padding: 0 24rpx 20rpx;
}

.list-head {
  padding: 8rpx 4rpx 16rpx;
}

.list-card {
  margin-bottom: 20rpx;
}

.card-title {
  flex: 1;
  margin-right: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #0F2540;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-line {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #3D4C63;
}

.card-line-weak {
  color: #6B7A8C;
}

.card-foot {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EEF1F6;
}

.card-meta {
  font-size: 23rpx;
  color: #98A6B8;
}

.card-caret {
  font-size: 30rpx;
  color: #C2CCDA;
}

.empty-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #B4BECC;
}

/* ---- 本页 hover 反馈 ----
   `hover-dim` / `row-hover` 是**页面级**类（app.wxss 里没有，各页面自己声明），
   所以每个用到 hover-class 的页面都必须自带一份。漏声明不会报错，
   只在点击时没有任何视觉反馈 —— 静默失效，肉眼很难发现，
   由 scripts/verify_entrust_ui.js 的"hover-class 类存在性"检查兜住。 */
.hover-dim {
  opacity: .6;
}

.row-hover {
  background: #F5F8FF;
}

/* ---- 队列切换（UI-04 / 切片四之六）----
   两个队列是**视图切换**而不是筛选：所以做成实心分段控件（比筛选 pill 更"重"、等分宽度），
   并放在筛选条之上 —— 本页现在有三层切换（队列 / 组织 / 筛选），三层不能长得一样，
   否则用户分不清"我现在点的是换了队列，还是只换了个筛选条件"。 */
.queue-bar {
  display: flex;
  padding: 20rpx 24rpx 0;
}

.queue-pill {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  margin-right: 12rpx;
  border-radius: 14rpx;
  text-align: center;
  font-size: 27rpx;
  color: #3D4C63;
  background: #F4F6FB;
}

.queue-pill:last-child {
  margin-right: 0;
}

.queue-pill-active {
  color: #FFFFFF;
  font-weight: 600;
  background: #3B5BDB;
}

/* 案件行的两个徽标（影响类型 + 案件类型）排一行，不挤进 .row-between */
.list-chips {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

/* 阻断后果单独一行：它是"相关任务现在完成不了"这个**流程事实**，混在徽标里
   会被当成又一个标签（徽标说"是什么"，这句说"会怎样"）。配色与案件页
   `.case-blocking` 一致 —— 同一件事在两个页面上不该是两种颜色。 */
.case-block-flag {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(250, 82, 82, .08);
  font-size: 24rpx;
  color: #C92A2A;
  line-height: 1.6;
}
