/* 委托发货 · 案件详情（UI-08 / ENT-030 切片四之四）—— 只写本页特有排版，其余复用 app.wxss */

.head-bg {
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  padding-bottom: 24rpx;
}

.nav-inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  font-size: 48rpx;
  line-height: 1;
  color: #FFFFFF;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.nav-spacer {
  width: 64rpx;
}

.head-sub {
  padding: 0 28rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.85);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ── 案件头卡 ─────────────────────────────────────────────────────────── */

.case-top {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #EEF1F6;
}

.case-title {
  flex: 1;
  margin-right: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #0F2540;
}

.case-chips {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

/* 阻断后果单独一行：它是"相关任务现在完成不了"这个**流程事实**，
   混在徽标里会被当成又一个标签（徽标说"是什么"，这句说"会怎样"）。 */
.case-blocking {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(250, 82, 82, .08);
  font-size: 24rpx;
  color: #C92A2A;
  line-height: 1.6;
}

/* 头卡与要素卡里的字段行：`.card` 已有 28rpx 内边距，
   沿用 app.wxss 的 min-height/padding 会在卡内再缩进一层（同 detail.wxss 的口径）。 */
.field-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F4F6FB;
}

.field-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.field-label {
  font-size: 25rpx;
  color: #98A6B8;
}

.field-value {
  max-width: 420rpx;
  font-size: 26rpx;
  color: #3D4C63;
  text-align: right;
}

/* ── 六要素 ───────────────────────────────────────────────────────────── */

.element-card {
  margin-top: 20rpx;
}

.element-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #EEF1F6;
}

/* 序号让"六要素齐不齐"在一屏里看得出来（不是装饰：缺一块时序号会跳号） */
.element-no {
  font-size: 22rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

.element-title {
  flex: 1;
  font-size: 29rpx;
  font-weight: 600;
  color: #0F2540;
}

.element-count {
  font-size: 23rpx;
  color: #98A6B8;
}

.element-text {
  padding-top: 16rpx;
  font-size: 27rpx;
  color: #3D4C63;
  line-height: 1.7;
  word-break: break-all;
}

/* 要素为空的说法：与有值内容在视觉上分开，且六句各不相同（是"还没到那一步"，
   不是空白、也不是"暂无数据"） */
.element-empty {
  padding-top: 16rpx;
  font-size: 25rpx;
  color: #B4BECC;
  line-height: 1.6;
}

.element-item {
  padding-top: 16rpx;
}

.element-item-text {
  font-size: 27rpx;
  color: #3D4C63;
  word-break: break-all;
}

.element-item-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #98A6B8;
}

/* 受影响项里**已写入应用版本**的那条：有据可查的事实才着色 */
.element-item-done .element-item-sub {
  color: #12B886;
}

/* ── 处置能力提示 ─────────────────────────────────────────────────────── */

.case-note {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #6B7A8C;
  line-height: 1.6;
}

/* ── 处置区（切片四之六）──────────────────────────────────────────────── */

.act-label {
  margin-top: 24rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #0F2540;
}

.act-hint {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #98A6B8;
  line-height: 1.6;
}

/* 受影响项的**可移除**形态：与要素②的只读条目分开 —— 那边说"有哪些"，
   这边说"能改哪个"。同一份数据、两种用途，混在一起会看不出哪个能点。 */
.act-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.act-chip {
  display: flex;
  align-items: center;
  padding: 10rpx 8rpx 10rpx 20rpx;
  border-radius: 999rpx;
  background: #F1F4F8;
}

.act-chip-text {
  font-size: 24rpx;
  color: #3D4C63;
}

.act-chip-x {
  padding: 0 14rpx;
  font-size: 24rpx;
  color: #98A6B8;
}

.pick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.act-btn {
  padding: 14rpx 26rpx;
  border-radius: 12rpx;
  background: #F1F4F8;
  font-size: 25rpx;
  color: #3B5BDB;
}

/* 已选中的处置选项：处置是"先选后填"的两步，选中态必须一眼看得出，
   否则用户不知道下面那个输入框为什么冒出来（也就不会去填） */
.act-btn-on {
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  color: #FFFFFF;
  font-weight: 500;
}

.act-input {
  margin-top: 16rpx;
  width: 100%;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #F7F9FC;
  font-size: 26rpx;
  color: #0F2540;
  box-sizing: border-box;
}

/* 页内表单的校验提示：与 `.act-hint` 同尺寸但着色 —— 它说的是"你这一步还不行"，
   不是"这里是说明"。两者混同会让用户把错误提示当成又一段帮助文字划过去。 */
.act-hint-warn {
  color: #C92A2A;
}

.act-btn-wide {
  margin-top: 20rpx;
  padding: 20rpx 0;
  text-align: center;
  border-radius: 12rpx;
  border: 1rpx dashed rgba(59, 91, 219, .35);
  font-size: 26rpx;
  color: #3B5BDB;
}

.cand-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx solid #F4F6FB;
}

.link-main {
  flex: 1;
  min-width: 0;
}

.link-text {
  font-size: 27rpx;
  color: #3D4C63;
}

.link-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #98A6B8;
}

.cand-add {
  flex-shrink: 0;
  width: 52rpx;
  text-align: center;
  font-size: 34rpx;
  color: #3B5BDB;
}

/* ── 应用变更（A2 五之四）────────────────────────────────────────────── */
/* 确认条里摆的是**批准快照摘要**：apply 不接受"改成什么"，所以点之前必须看得到
   将发生什么。摘要只列目标与字段名，值去成果页的版本历史看 —— 这里摆值会排版崩。 */
.apply-box {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #F7F9FD;
}

.apply-line {
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  color: #3D4C63;
}

.apply-key {
  font-size: 25rpx;
  font-weight: 600;
  color: #0F2540;
}

.apply-val {
  font-size: 24rpx;
  color: #3D4C63;
  line-height: 1.6;
}

.apply-sub {
  color: #98A6B8;
}

.apply-note {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #C92A2A;
  line-height: 1.6;
}

.apply-target {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #E6ECF5;
}

/* 取消按钮与「确认应用」分开：两个都是宽按钮，只有取消是虚线的，
   避免在误触时把"取消"当成确认（它们是相邻的整宽元素）。 */
.act-btn-ghost {
  border-style: solid;
  border-color: #DDE3EC;
  color: #6B7A8C;
}

/* ── 复核传播与范围待确认（A2 五之四）────────────────────────────────── */

.rv-item {
  padding: 18rpx 0;
  border-top: 1rpx solid #F4F6FB;
}

.rv-area {
  font-size: 27rpx;
  font-weight: 600;
  color: #0F2540;
}

.rv-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #6B7A8C;
  line-height: 1.6;
}

/* `cancelled` 的原因写在这里 —— 它说的是"复核要求被撤销"，与"已核对"是两件事，
   所以用警示色而非灰色：撤销是需要被看见的。 */
.rv-note {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #C92A2A;
  line-height: 1.6;
}

/* 范围可能不足：这是**提问**不是结论，用警示底色让它无法被忽略 ——
   漏看它的后果是复核范围少了几个对象，而那在界面上看不出来。 */
.note-warn {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #FFF7E6;
  font-size: 24rpx;
  color: #8A5A00;
  line-height: 1.7;
}

/* ---- 本页 hover 反馈 ----
   `hover-dim` 是页面级类（app.wxss 未定义），用到就自带一份；
   漏声明只会表现为"点了没反馈"，不会报错（verify_entrust_ui.js 有专门检查）。 */
.hover-dim {
  opacity: .6;
}
