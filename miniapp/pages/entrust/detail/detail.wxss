/* 委托发货 · 单张委托工作台（UI-05 / ENT-021）—— 只写本页特有排版，其余复用 app.wxss */

.head-bg {
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  padding-bottom: 24rpx;
}

.nav-inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  font-size: 48rpx;
  line-height: 1;
  color: #FFFFFF;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.nav-spacer {
  width: 64rpx;
}

.head-sub {
  padding: 0 28rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.85);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.detail-top {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #EEF1F6;
}

.detail-title {
  flex: 1;
  margin-right: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #0F2540;
}

.field-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F4F6FB;
}

.field-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.field-label {
  font-size: 25rpx;
  color: #98A6B8;
}

.field-value {
  max-width: 420rpx;
  font-size: 26rpx;
  color: #3D4C63;
  text-align: right;
}

/* ── 七槽位（UI-05 / ENT-021）─────────────────────────────────────────────
   每槽一张卡：标题 + 四个派生字段 + 未决明细 + 精确版本 + 计数 + 人工落点。
   空态与警示态用**不同颜色**而不是不同图标 —— 用哪个类由 `utils/entrust.js`
   算好并写进 `cls`，模板不做判断（模板里拼类名会让"类是否存在"变成运行期才知道）。 */

.slot-card {
  margin-top: 20rpx;
}

.slot-head {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #EEF1F6;
}

.slot-title {
  flex: 1;
  margin-right: 16rpx;
  font-size: 29rpx;
  font-weight: 600;
  color: #0F2540;
}

/* 未开放 / 历史存量说明：说清发生了什么，而不是留一个看着像"没数据"的空槽位 */
.slot-note {
  padding-top: 16rpx;
  font-size: 24rpx;
  color: #98A6B8;
  line-height: 1.6;
}

/* 空值四态的文字：与有值内容在视觉上分开（是"暂无记录"，不是空白、也不是 0） */
.slot-empty {
  color: #B4BECC;
}

/* 需要人看一眼的那类（未决问题 / 尚未分配） */
.slot-warn {
  color: #C77700;
}

.slot-issues {
  padding-top: 12rpx;
}

.slot-issue {
  font-size: 24rpx;
  color: #C77700;
  line-height: 1.7;
}

/* 未决问题的类别徽标：让"该去补数据"与"这条路走不通"一眼可分 */
.slot-issue-kind {
  display: inline-block;
  margin-right: 10rpx;
  padding: 0 10rpx;
  border: 1rpx solid #E8B96A;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #A66300;
}

.slot-issue-text {
  font-size: 24rpx;
}

.slot-refs {
  padding-top: 12rpx;
}

.slot-ref {
  font-size: 23rpx;
  color: #6B7A8C;
  line-height: 1.7;
}

/* 成果引用是**可点的**（ENT-023）：给足点击区域并着色，让"能不能点"一眼看得出来。
   只靠 hover 反馈不够 —— hover 在静态截图与走查里都看不见。 */
.slot-ref-link {
  padding: 12rpx 0;
  color: #3B5BDB;
}

/* 阻断执行的案件引用（ENT-030 切片四之五）：颜色是**第二重**信号。
   文案里已经写明"阻断执行"——只靠颜色的话，截图里的红字说不清红在哪，
   而色觉差异的用户会完全看不到这条信息。 */
.slot-ref-block {
  color: #FA5252;
}

.slot-counts {
  padding-top: 12rpx;
  font-size: 23rpx;
  color: #98A6B8;
}

.slot-actions {
  padding-top: 18rpx;
}

/* 任务类型选择条：页内展开，避免弹层里 7 项在真机底部被切断 */
.slot-picks {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-bottom: 16rpx;
}

.slot-pick {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #3D4C63;
  background: #F2F5FA;
}

/* WP-1（2026-09-21）：前置任务与**必需证据多选**需要看得见"我选了哪个"。
   主色与 `.slot-btn-strong` 一致 —— 同一个页面上"确定性的动作/选中的东西"只有一种强调色。 */
.slot-pick-on {
  color: #FFFFFF;
  background: #3B5BDB;
}

/* 前置任务：**选择器与「清除前置」并排**（一条窄行，不占满整张卡） */
.slot-pick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-bottom: 12rpx;
}

.slot-btn {
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #3B5BDB;
  background: #EEF2FF;
}

/* 页内确认条 / 输入条（2026-09-16）—— 关键路径不落在原生弹层上，
   理由与静态防线见 detail.js 头注释。
   `.slot-btn-strong` 是"会改变业务状态、且不可回退"的那一个：与主色一致，
   并在下方留出间距，使「确认」与「取消」不会贴成一块、看不出主次。 */
.slot-btn-strong {
  margin-bottom: 12rpx;
  color: #FFFFFF;
  background: #3B5BDB;
}

/* 页内输入条的容器：把"标题 + 输入框 + 两个按钮"收成一块，
   与它上面那条「记录任务」按钮之间靠 `slot-actions` 的 padding 分开 */
.slot-form {
  padding: 4rpx 0 8rpx;
}

.slot-input {
  margin: 12rpx 0 16rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #DCE3EE;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #0F2540;
  background: #FFFFFF;
}

.status-note {
  margin-top: 20rpx;
}

.status-note-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #0F2540;
}

.status-note-body {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #6B7A8C;
  line-height: 1.6;
}

/* ---- 运力确认与有效期（经理侧；BP-03 第 2、3 条）----
   这一段是内部成本口径（承运人、供应商单价、需求量与缺口吨数），
   整块只在看得到组织侧时渲染（判据在 detail.js 的 canViewCapacity）。 */
.cap-row {
  margin-top: 16rpx;
  padding: 16rpx;
  border: 1rpx solid #DCE3EE;
  border-radius: 12rpx;
  background: #FFFFFF;
}

.cap-carrier {
  font-size: 27rpx;
  font-weight: 600;
  color: #0F2540;
}

.cap-candidate {
  font-size: 24rpx;
  color: #6B7A8C;
}

.cap-confirmed {
  font-size: 24rpx;
  font-weight: 600;
  color: #1D7A4D;
}

.cap-withdrawn {
  font-size: 24rpx;
  color: #8A93A0;
}

.cap-unknown {
  font-size: 24rpx;
  color: #B45309;
}

.cap-warn {
  font-size: 25rpx;
  color: #B45309;
}

/* 选择条（页内展开）。`plan-picks` 与 `cap-picks` 共用同一组声明：本页的 "chip"
   只有一种长相，分成两份写着写着就会漂移（一处改了圆角、另一处没跟上），
   而那类差异没人会当成缺陷。两个类名各自留着，是为了让模板读起来知道它属于哪一块。 */
.cap-picks,
.plan-picks {
  display: flex;
  flex-wrap: wrap;
  margin: 10rpx 0;
}

.cap-pick,
.plan-pick {
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 20rpx;
  border: 1rpx solid #DCE3EE;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #0F2540;
  background: #FFFFFF;
}

.cap-pick-on,
.plan-pick-on {
  border-color: #0F2540;
  background: #0F2540;
  color: #FFFFFF;
}

.cap-verdict {
  margin-top: 16rpx;
  padding: 16rpx;
  border: 1rpx solid #E8B4A0;
  border-radius: 12rpx;
  background: #FFF7F3;
}

.cap-verdict-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #B45309;
}

.cap-verdict-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B7A8C;
  line-height: 1.5;
}

.cap-rule {
  margin-top: 10rpx;
}

.cap-rule-pass {
  font-size: 24rpx;
  color: #1D7A4D;
}

.cap-rule-fail {
  font-size: 24rpx;
  font-weight: 600;
  color: #B45309;
}

.cap-rule-detail {
  margin-left: 8rpx;
  font-size: 23rpx;
  color: #6B7A8C;
  line-height: 1.5;
}

/* ---- 「两家可比」并排表 ----
   列 = 候选，行 = 维度。**列宽固定 + 横向可滚**：三家以上时宁可横滑，
   也不把字压成看不清 —— 这张表的用途就是"一眼比出来"，挤成一团就等于没做。 */
.cap-compare {
  margin-top: 16rpx;
}

.cap-compare-scroll {
  margin-top: 8rpx;
  /* 横向滚动靠 white-space: nowrap + 子元素 inline-block（小程序 scroll-view 的规矩） */
  white-space: nowrap;
}

.cap-compare-grid {
  display: inline-block;
  min-width: 100%;
}

.cap-compare-row {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid #DCE3EE;
}

.cap-compare-headrow {
  border-bottom-color: #0F2540;
}

.cap-compare-label {
  flex: 0 0 150rpx;
  padding: 10rpx 8rpx;
  font-size: 24rpx;
  color: #6B7A8C;
}

.cap-compare-cell {
  flex: 0 0 240rpx;
  padding: 10rpx 8rpx;
  font-size: 26rpx;
  color: #0F2540;
  /* 父级 nowrap 是为了横滑，单元格里的长文案仍要能换行 */
  white-space: normal;
  overflow-wrap: break-word;
}

.cap-compare-head {
  font-size: 24rpx;
  font-weight: 600;
  color: #6B7A8C;
}

/* 差异标记 = 「这两家在这一维上不一样」。**不评价哪边好** —— 只指出分歧点，
   好不好是方案判断（见 utils/entrust.js 的 buildCapacityComparison）。 */
.cap-compare-diff {
  margin-left: 8rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: #B45309;
}

/* ---- 运输计划（三段航段）与必需任务前置（合同 §10.1 第 4 步）----
   段与任务都**按行**渲染：段数是行的属性，样式只管"一行长什么样"，
   不在样式层表达"一共三段"（那会让改数据变成改样式）。 */
/* 一段航段：**头行 + 操作行**两块。头行保持原来的横向布局（序号 / 方式 / 路线），
   操作行（改这一段 / 版本历史）另起一行 —— 挤在同一行时，长路线名会把按钮推出屏幕。 */
.plan-leg {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #DCE3EE;
  border-radius: 12rpx;
  background: #FFFFFF;
}

.plan-leg-head {
  display: flex;
  align-items: center;
}

.plan-leg-seq {
  width: 36rpx;
  font-size: 24rpx;
  color: #6B7A8C;
}

.plan-leg-mode {
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #0F2540;
  background: #EEF2F8;
}

.plan-leg-route {
  flex: 1;
  font-size: 26rpx;
  color: #0F2540;
}

/* 行内小动作（加一段 / 改这一段 / 版本历史）。比 `slot-btn` 小一号：它们是
   **行内操作**，与"提交"不在一个层级 —— 长得一样会让人以为点了就生效。 */
.plan-actions {
  padding-top: 12rpx;
}

.plan-act {
  display: inline-block;
  margin: 0 12rpx 0 0;
  padding: 6rpx 18rpx;
  border: 1rpx solid #DCE3EE;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #3B5BDB;
  background: #FFFFFF;
}

.plan-leg-acts {
  padding-top: 8rpx;
}

/* 版本历史（按段展开）。左缩进一格，让"它属于上面那一段"在版面上就成立。 */
.plan-hist {
  margin-top: 10rpx;
  padding-left: 12rpx;
  border-left: 4rpx solid #EEF2F8;
}

.plan-rev {
  margin-top: 8rpx;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  background: #F7F9FC;
}

.plan-rev-no {
  font-size: 24rpx;
  font-weight: 600;
  color: #0F2540;
}

.plan-rev-body {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #0F2540;
}

.plan-rev-note {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6B7A8C;
}

.plan-rev-at {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #93A0B2;
}

.plan-task-head {
  margin-top: 24rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #0F2540;
}

.plan-task {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #DCE3EE;
  border-radius: 12rpx;
  background: #FFFFFF;
}

.plan-task-title {
  font-size: 26rpx;
  color: #0F2540;
}

/* 前置就是"必需任务前置"要看的**判据**，所以单独成行、不与状态挤在一处：
   没有前置时写「无固定前置」，解析不到标题时写「前置：任务 #<id>」——
   两种说法必须分得开（见 utils/entrust.js 的 decorateAssignmentPlan 第 3 条）。 */
.plan-task-pre {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #6B7A8C;
}

/* ---- 合同核对稿（§10.1 第 7 步）----
   这一块的排版取向与「运输计划」一致：**一行一个事实**，不做合并排版。
   版本的那一列（`contractRevisionNoText` / `sig-rev`）必须单独占位置 ——
   「有合同」与「合同是第几版」是两个问题，挤在一起就没法一眼看出绑的是哪一版。 */

/* 卡片本身不新增视觉（沿用 `.card` + `.slot-card`），声明出来是为了让
   「这张卡在不在」成为渲染树里**数得出来的事实** —— 走查按 `.contract-card` 计数，
   而这类标记类若不在样式表里，静态闸（样式定义检查）会直接把它判为漏定义。 */
.contract-card {
  margin-top: 20rpx;
}

.contract-line {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #0F2540;
}

.contract-sub {
  margin-top: 24rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #0F2540;
}

/* 逐字段来源：三行一块（字段 / 值 / 出处）。出处那行带内部编号
   （`release:12@v3`），是审计信息 —— 所以整表默认收起，只在点了才展开。 */
.contract-src {
  margin-top: 10rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid #DCE3EE;
  border-radius: 10rpx;
  background: #F7F9FC;
}

.contract-src-path {
  display: block;
  font-size: 22rpx;
  color: #6B7A8C;
}

.contract-src-value {
  display: block;
  margin-top: 4rpx;
  font-size: 25rpx;
  color: #0F2540;
}

.contract-src-from {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #93A0B2;
}

/* 一条签署证据 = 一行四个事实：第几版 / 什么形态 / 什么标注 / 说明与时间。 */
.sig-row {
  margin-top: 10rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid #DCE3EE;
  border-radius: 10rpx;
  background: #FFFFFF;
}

.sig-rev {
  font-size: 25rpx;
  font-weight: 600;
  color: #0F2540;
}

.sig-kind {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #0F2540;
}

.sig-mode {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #C2410C;
}

.sig-note {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #6B7A8C;
}

/* ---- 本页 hover 反馈 ----
   `hover-dim` 是页面级类（app.wxss 未定义），用到就自带一份；
   漏声明只会表现为"点了没反馈"，不会报错（verify_entrust_ui.js 有专门检查）。 */
.hover-dim {
  opacity: .6;
}
