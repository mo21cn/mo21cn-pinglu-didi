/* 委托发货 · 单张委托工作台（UI-05 / ENT-021）—— 只写本页特有排版，其余复用 app.wxss */

.head-bg {
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  padding-bottom: 24rpx;
}

.nav-inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  font-size: 48rpx;
  line-height: 1;
  color: #FFFFFF;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.nav-spacer {
  width: 64rpx;
}

.head-sub {
  padding: 0 28rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.85);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.detail-top {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #EEF1F6;
}

.detail-title {
  flex: 1;
  margin-right: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #0F2540;
}

.field-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F4F6FB;
}

.field-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.field-label {
  font-size: 25rpx;
  color: #98A6B8;
}

.field-value {
  max-width: 420rpx;
  font-size: 26rpx;
  color: #3D4C63;
  text-align: right;
}

/* ── 七槽位（UI-05 / ENT-021）─────────────────────────────────────────────
   每槽一张卡：标题 + 四个派生字段 + 未决明细 + 精确版本 + 计数 + 人工落点。
   空态与警示态用**不同颜色**而不是不同图标 —— 用哪个类由 `utils/entrust.js`
   算好并写进 `cls`，模板不做判断（模板里拼类名会让"类是否存在"变成运行期才知道）。 */

.slot-card {
  margin-top: 20rpx;
}

.slot-head {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #EEF1F6;
}

.slot-title {
  flex: 1;
  margin-right: 16rpx;
  font-size: 29rpx;
  font-weight: 600;
  color: #0F2540;
}

/* 未开放 / 历史存量说明：说清发生了什么，而不是留一个看着像"没数据"的空槽位 */
.slot-note {
  padding-top: 16rpx;
  font-size: 24rpx;
  color: #98A6B8;
  line-height: 1.6;
}

/* 空值四态的文字：与有值内容在视觉上分开（是"暂无记录"，不是空白、也不是 0） */
.slot-empty {
  color: #B4BECC;
}

/* 需要人看一眼的那类（未决问题 / 尚未分配） */
.slot-warn {
  color: #C77700;
}

.slot-issues {
  padding-top: 12rpx;
}

.slot-issue {
  font-size: 24rpx;
  color: #C77700;
  line-height: 1.7;
}

/* 未决问题的类别徽标：让"该去补数据"与"这条路走不通"一眼可分 */
.slot-issue-kind {
  display: inline-block;
  margin-right: 10rpx;
  padding: 0 10rpx;
  border: 1rpx solid #E8B96A;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #A66300;
}

.slot-issue-text {
  font-size: 24rpx;
}

.slot-refs {
  padding-top: 12rpx;
}

.slot-ref {
  font-size: 23rpx;
  color: #6B7A8C;
  line-height: 1.7;
}

/* 成果引用是**可点的**（ENT-023）：给足点击区域并着色，让"能不能点"一眼看得出来。
   只靠 hover 反馈不够 —— hover 在静态截图与走查里都看不见。 */
.slot-ref-link {
  padding: 12rpx 0;
  color: #3B5BDB;
}

/* 阻断执行的案件引用（ENT-030 切片四之五）：颜色是**第二重**信号。
   文案里已经写明"阻断执行"——只靠颜色的话，截图里的红字说不清红在哪，
   而色觉差异的用户会完全看不到这条信息。 */
.slot-ref-block {
  color: #FA5252;
}

.slot-counts {
  padding-top: 12rpx;
  font-size: 23rpx;
  color: #98A6B8;
}

.slot-actions {
  padding-top: 18rpx;
}

/* 任务类型选择条：页内展开，避免弹层里 7 项在真机底部被切断 */
.slot-picks {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-bottom: 16rpx;
}

.slot-pick {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #3D4C63;
  background: #F2F5FA;
}

.slot-btn {
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #3B5BDB;
  background: #EEF2FF;
}

/* 页内确认条 / 输入条（2026-09-16）—— 关键路径不落在原生弹层上，
   理由与静态防线见 detail.js 头注释。
   `.slot-btn-strong` 是"会改变业务状态、且不可回退"的那一个：与主色一致，
   并在下方留出间距，使「确认」与「取消」不会贴成一块、看不出主次。 */
.slot-btn-strong {
  margin-bottom: 12rpx;
  color: #FFFFFF;
  background: #3B5BDB;
}

/* 页内输入条的容器：把"标题 + 输入框 + 两个按钮"收成一块，
   与它上面那条「记录任务」按钮之间靠 `slot-actions` 的 padding 分开 */
.slot-form {
  padding: 4rpx 0 8rpx;
}

.slot-input {
  margin: 12rpx 0 16rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #DCE3EE;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #0F2540;
  background: #FFFFFF;
}

.status-note {
  margin-top: 20rpx;
}

.status-note-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #0F2540;
}

.status-note-body {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #6B7A8C;
  line-height: 1.6;
}

/* ---- 运力确认与有效期（经理侧；BP-03 第 2、3 条）----
   这一段是内部成本口径（承运人、供应商单价、需求量与缺口吨数），
   整块只在看得到组织侧时渲染（判据在 detail.js 的 canViewCapacity）。 */
.cap-row {
  margin-top: 16rpx;
  padding: 16rpx;
  border: 1rpx solid #DCE3EE;
  border-radius: 12rpx;
  background: #FFFFFF;
}

.cap-carrier {
  font-size: 27rpx;
  font-weight: 600;
  color: #0F2540;
}

.cap-candidate {
  font-size: 24rpx;
  color: #6B7A8C;
}

.cap-confirmed {
  font-size: 24rpx;
  font-weight: 600;
  color: #1D7A4D;
}

.cap-withdrawn {
  font-size: 24rpx;
  color: #8A93A0;
}

.cap-unknown {
  font-size: 24rpx;
  color: #B45309;
}

.cap-warn {
  font-size: 25rpx;
  color: #B45309;
}

.cap-picks {
  display: flex;
  flex-wrap: wrap;
  margin: 10rpx 0;
}

.cap-pick {
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 20rpx;
  border: 1rpx solid #DCE3EE;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #0F2540;
  background: #FFFFFF;
}

.cap-pick-on {
  border-color: #0F2540;
  background: #0F2540;
  color: #FFFFFF;
}

.cap-verdict {
  margin-top: 16rpx;
  padding: 16rpx;
  border: 1rpx solid #E8B4A0;
  border-radius: 12rpx;
  background: #FFF7F3;
}

.cap-verdict-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #B45309;
}

.cap-verdict-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B7A8C;
  line-height: 1.5;
}

.cap-rule {
  margin-top: 10rpx;
}

.cap-rule-pass {
  font-size: 24rpx;
  color: #1D7A4D;
}

.cap-rule-fail {
  font-size: 24rpx;
  font-weight: 600;
  color: #B45309;
}

.cap-rule-detail {
  margin-left: 8rpx;
  font-size: 23rpx;
  color: #6B7A8C;
  line-height: 1.5;
}

/* ---- 「两家可比」并排表 ----
   列 = 候选，行 = 维度。**列宽固定 + 横向可滚**：三家以上时宁可横滑，
   也不把字压成看不清 —— 这张表的用途就是"一眼比出来"，挤成一团就等于没做。 */
.cap-compare {
  margin-top: 16rpx;
}

.cap-compare-scroll {
  margin-top: 8rpx;
  /* 横向滚动靠 white-space: nowrap + 子元素 inline-block（小程序 scroll-view 的规矩） */
  white-space: nowrap;
}

.cap-compare-grid {
  display: inline-block;
  min-width: 100%;
}

.cap-compare-row {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid #DCE3EE;
}

.cap-compare-headrow {
  border-bottom-color: #0F2540;
}

.cap-compare-label {
  flex: 0 0 150rpx;
  padding: 10rpx 8rpx;
  font-size: 24rpx;
  color: #6B7A8C;
}

.cap-compare-cell {
  flex: 0 0 240rpx;
  padding: 10rpx 8rpx;
  font-size: 26rpx;
  color: #0F2540;
  /* 父级 nowrap 是为了横滑，单元格里的长文案仍要能换行 */
  white-space: normal;
  overflow-wrap: break-word;
}

.cap-compare-head {
  font-size: 24rpx;
  font-weight: 600;
  color: #6B7A8C;
}

/* 差异标记 = 「这两家在这一维上不一样」。**不评价哪边好** —— 只指出分歧点，
   好不好是方案判断（见 utils/entrust.js 的 buildCapacityComparison）。 */
.cap-compare-diff {
  margin-left: 8rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: #B45309;
}

/* ---- 本页 hover 反馈 ----
   `hover-dim` 是页面级类（app.wxss 未定义），用到就自带一份；
   漏声明只会表现为"点了没反馈"，不会报错（verify_entrust_ui.js 有专门检查）。 */
.hover-dim {
  opacity: .6;
}
