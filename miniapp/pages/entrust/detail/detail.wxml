<!--
  委托发货 · 单张委托工作台（UI-05 首片 / ENT-021）
  七槽位骨架 + 空值四态 + 每槽人工落点（记录任务）。
  四态分支（loading / expired / denied / error）一个都不能少：少一个分支就少一种表现，
  失败会被渲染成空白（verify_entrust_ui.js 有专门断言）。
-->
<view class="page">
  <view class="head-bg" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-inner">
      <view class="nav-back" bindtap="onBack" hover-class="hover-dim">‹</view>
      <text class="nav-title">委托工作台</text>
      <view class="nav-spacer"></view>
    </view>
    <view class="head-sub" wx:if="{{detail}}">{{detail.title}}</view>
  </view>

  <view class="page-content">
    <!-- 加载中 -->
    <view wx:if="{{view === 'loading'}}" class="empty">
      <text class="empty-icon">⏳</text>
      {{viewTitle}}
    </view>

    <!-- 登录过期 -->
    <view wx:elif="{{view === 'expired'}}" class="err-card">
      <view class="err-title">{{viewTitle}}</view>
      <view class="err-detail">{{viewHint}}</view>
      <view class="err-btn" bindtap="onRelogin" hover-class="hover-dim">返回首页重新进入</view>
    </view>

    <!-- 无权限 / 不存在（服务端对非参与方统一 404，不泄漏存在性） -->
    <view wx:elif="{{view === 'denied'}}" class="err-card">
      <view class="err-title">{{viewTitle}}</view>
      <view class="err-detail">{{viewHint}}</view>
    </view>

    <!-- 其它失败 -->
    <view wx:elif="{{view === 'error'}}" class="err-card">
      <view class="err-title">{{viewTitle}}</view>
      <view class="err-detail">{{viewHint}}</view>
      <view class="err-btn" bindtap="onRetry" hover-class="hover-dim">重试</view>
    </view>

    <!-- 正常 -->
    <block wx:else>
      <!-- 委托本体（overview 之外的骨架信息；货类/货量在第一个槽位里） -->
      <view class="card">
        <view class="row-between detail-top">
          <text class="detail-title">{{detail.title}}</text>
          <text class="{{detail.statusClass}}">{{detail.statusLabel}}</text>
        </view>
        <view wx:for="{{fields}}" wx:key="label" class="field-row row-between">
          <text class="field-label">{{item.label}}</text>
          <text class="field-value">{{item.value}}</text>
        </view>
      </view>

      <!-- 运输计划（三段航段）与必需任务前置（BP-03 第 1 条 / 合同 §10.1 第 4 步：
           `Show the road–water–road plan and required task prerequisites.`）
           为什么落在这一页、为什么**两侧都显示**：航段是**客户自己交进来的**起讫路线，
           后端那条读通道（`assert_can_view_assignment`）给货主本人放行；
           承运人 / 供应商单价 / 缺口那些内部成本口径在**运力那一组**，那组一条都不放行。
           ⚠️ 模板**不拼**"三段""公路—内河—公路"这类结论：段数是**行**的属性，
              按行渲染；在服务端或投影里拼成一句话，就多一个会与数据脱节的落点。
           ⚠️ 两种空态**分别说话**（见 `decorateAssignmentPlan` 第 4 条）：
              "没有计划"要落方案、"没有任务"要派单，处置完全不同。
           取不到时（`planHint`）**不显示成空计划** —— 那会把"读不到"说成"没有"。 -->
      <view wx:if="{{plan}}" class="card slot-card">
        <view class="row-between slot-head">
          <text class="slot-title">运输计划</text>
          <text class="slot-note">{{plan.legs.length}} 段</text>
        </view>

        <!-- 建段入口。**页内表单**（`legOpen`），不用原生弹层 —— 弹层不在渲染树里，
             真机走查点不到，只能记 LIMITATION（⑧b / ㉕D / 运力确认的先例）。
             判权不在这里：能打开本页就说明看得见这张委托，写端仍按同一个参与方判据。 -->
        <view class="plan-actions">
          <view
            class="plan-act"
            data-act-leg-open="1"
            bindtap="onOpenLeg"
            hover-class="hover-dim"
          >加一段</view>
        </view>

        <view wx:if="{{plan.hasLegs}}">
          <view
            wx:for="{{plan.legs}}"
            wx:key="legId"
            class="plan-leg"
            data-plan-leg="{{item.seqText}}"
          >
            <view class="plan-leg-head">
              <text class="plan-leg-seq">{{item.seqText}}</text>
              <text class="plan-leg-mode">{{item.modeText}}</text>
              <text class="plan-leg-route">{{item.routeText}}</text>
            </view>
            <view class="plan-leg-acts">
              <view
                class="plan-act"
                data-act-leg-edit="{{item.legId}}"
                bindtap="onEditLeg"
                hover-class="hover-dim"
              >改这一段</view>
              <view
                class="plan-act"
                data-act-leg-hist="{{item.legId}}"
                bindtap="onToggleLegHistory"
                hover-class="hover-dim"
              >版本历史</view>
            </view>

            <!-- 版本历史（**按段**展开）。判据是 `legHistoryId === item.legId`：
                 两侧都是字符串（投影里 `legId` 已 `String()`），不是"字符串 vs 数字"。 -->
            <view wx:if="{{legHistoryId === item.legId}}" class="plan-hist">
              <view wx:if="{{legHistoryHint}}" class="slot-note slot-warn">{{legHistoryHint}}</view>
              <block wx:elif="{{legHistory}}">
                <block wx:if="{{legHistory.hasItems}}">
                  <view
                    wx:for="{{legHistory.items}}"
                    wx:for-item="rev"
                    wx:key="revisionIdText"
                    class="plan-rev"
                    data-plan-rev="{{rev.revisionNoText}}"
                  >
                    <view class="row-between">
                      <text class="plan-rev-no">{{rev.revisionNoText}}</text>
                      <text class="slot-note">{{rev.kindText}}</text>
                    </view>
                    <text class="plan-rev-body">{{rev.seqText}} · {{rev.modeText}} · {{rev.routeText}}</text>
                    <text class="plan-rev-note">{{rev.noteText}}</text>
                    <text class="plan-rev-at">{{rev.changedAtText}}</text>
                  </view>
                </block>
                <!-- 空列表要**单独说话**：航段存在就至少有一版（建段即第 1 版），
                     服务端回空列表说明这条响应不是我们以为的那条 —— 不是"没有改动过"。 -->
                <view wx:else class="slot-note">服务端没有返回任何版本 —— 这与「没有改动过」不是一回事</view>
              </block>
            </view>
          </view>
        </view>
        <view wx:else class="slot-note">本单还没有结构化运输计划</view>

        <!-- 建段 / 改段表单（**页内**）。字段名与 handler 的 `data-df` 映射表一一对应 ——
             ⚠️ 少一条映射就是**静默空转**（那一格永远填不上、提交永远说必填，
             而页面看起来完全正常）。`slot-form` / `slot-input` / `slot-btn` 是本页
             通用的表单词汇（与运力登记、记录任务同一套），不另造一套长得像的。 -->
        <view wx:if="{{legOpen}}" class="slot-form">
          <view class="slot-note">{{legEditingId ? '改一段航段（旧版本会保留）' : '加一段航段'}}</view>
          <input
            class="slot-input"
            type="number"
            data-df="leg-seq"
            value="{{legForm.seq}}"
            placeholder="第几段（不小于 1 的整数）"
            placeholder-class="input-ph"
            bindinput="onLegInput"
          />
          <input
            class="slot-input"
            data-df="leg-mode"
            value="{{legForm.mode}}"
            placeholder="运输方式（必填，如 road / water / rail）"
            placeholder-class="input-ph"
            bindinput="onLegInput"
          />
          <!-- 快捷填入**已登记**的方式；这不是取值域 —— 上面那个输入框可以填别的值 -->
          <view class="plan-picks">
            <view
              wx:for="{{legModeOptions}}"
              wx:for-item="option"
              wx:key="key"
              class="plan-pick {{legForm.mode === option.key ? 'plan-pick-on' : ''}}"
              data-act-leg-mode="{{option.key}}"
              bindtap="onPickLegMode"
              hover-class="hover-dim"
            >{{option.label}}</view>
          </view>
          <input
            class="slot-input"
            data-df="leg-from"
            value="{{legForm.from}}"
            placeholder="起点（必填）"
            placeholder-class="input-ph"
            bindinput="onLegInput"
          />
          <input
            class="slot-input"
            data-df="leg-to"
            value="{{legForm.to}}"
            placeholder="终点（必填）"
            placeholder-class="input-ph"
            bindinput="onLegInput"
          />
          <input
            class="slot-input"
            data-df="leg-note"
            value="{{legForm.note}}"
            placeholder="改动说明（选填；会随这一版一起留档）"
            placeholder-class="input-ph"
            bindinput="onLegInput"
          />
          <view wx:if="{{legHint}}" class="slot-note slot-warn">{{legHint}}</view>
          <view class="plan-actions">
            <view
              class="slot-btn slot-btn-strong"
              data-act-leg-submit="1"
              bindtap="onSubmitLeg"
              hover-class="hover-dim"
            >{{legEditingId ? '保存（留新版本）' : '建段'}}</view>
            <view
              class="slot-btn"
              data-act-leg-cancel="1"
              bindtap="onCancelLeg"
              hover-class="hover-dim"
            >取消</view>
          </view>
        </view>

        <!-- 表单收起时的提示（例如「这一段不在当前计划里」）—— 不随表单一起消失，
             否则用户看到的是"点了没反应" -->
        <view wx:if="{{!legOpen && legHint}}" class="slot-note slot-warn">{{legHint}}</view>

        <view class="plan-task-head">必需任务与前置</view>
        <block wx:if="{{plan.hasTasks}}">
          <view
            wx:for="{{plan.tasks}}"
            wx:key="taskIdText"
            class="plan-task"
            data-plan-task="{{item.taskIdText}}"
          >
            <view class="row-between">
              <text class="plan-task-title">{{item.titleText}}</text>
              <text class="slot-note">{{item.statusText}}</text>
            </view>
            <text class="plan-task-pre" data-plan-task-pre="{{item.preText}}">{{item.preText}}</text>
          </view>
        </block>
        <view wx:else class="slot-note">本单还没有派发任务</view>
      </view>

      <view wx:if="{{planHint}}" class="card slot-card">
        <view class="slot-note slot-warn">{{planHint}}</view>
      </view>

      <!-- 对客报价（客户侧 / S3 纵向切片 / BP-03 第 5–10 条）。
           三件必须说清的事：
           ① **内容来自发布那一刻冻结的投影**（`offer.contentRows`），不是"这份成果的最新版"。
              客户是照着当时看到的内容做决定的，读最新版会把两次不同的东西显示成同一份。
           ② **数据来源标注要显示**（第 9 条）：`unknown` 照实显示"来源未标注"，
              不折成"人工录入" —— 折了就等于替审计做了判断。
           ③ **签署是样张模式**（合同 §10.1 第 7 步）：不写这一句，"已接受"会被读成
              一份已生效的法律签署。
           响应表单走**页内展开条**而不用 `wx.showModal`：接受是唯一会改变业务事实、
           且后端用 `UNIQUE(release_id)` 钉死"只能响应一次"的动作，必须可被真机验证。 -->
      <view wx:if="{{offer}}" class="card slot-card">
        <view class="row-between slot-head">
          <text class="slot-title">{{offer.typeLabel}} · v{{offer.revisionNo}}</text>
          <text class="{{offer.statusClass}}">{{offer.statusLabel}}</text>
        </view>
        <view class="slot-note">发布于 {{offer.releasedAt}}（客户看到的内容已在此刻冻结）</view>

        <view wx:for="{{offer.contentRows}}" wx:key="name" class="field-row row-between">
          <text class="field-label">{{item.label}}</text>
          <text class="field-value">{{item.value}}</text>
        </view>
        <view wx:if="{{offer.contentEmpty}}" class="slot-note slot-warn">
          这份发布没有可显示的内容（不应发生，请报障）
        </view>

        <view class="slot-note" data-act-offer-origin="1">数据来源标注：{{offer.dataOriginLabel}}</view>
        <view wx:if="{{offer.signatureHint}}" class="slot-note slot-warn">
          {{offer.signatureLabel}} · {{offer.signatureHint}}
        </view>

        <!-- 授权附件：**只有发布清单里的**能下载，判据在服务端（清单外 404） -->
        <view wx:if="{{offer.attachments.length}}" class="slot-actions">
          <view
            wx:for="{{offer.attachments}}"
            wx:for-item="att"
            wx:key="attachmentId"
            class="slot-btn"
            data-act-offer-download="{{att.attachmentId}}"
            data-id="{{att.attachmentId}}"
            bindtap="onDownloadOfferAttachment"
            hover-class="hover-dim"
          >下载 {{att.label}}</view>
        </view>
        <view wx:if="{{downloadHint}}" class="slot-note">{{downloadHint}}</view>

        <!-- 已响应：显示**当时的决定与说明**（不是"可以改"的表单） -->
        <view wx:if="{{offer.decided}}" class="slot-note">
          客户已于 {{offer.respondedAt}} 「{{offer.decisionLabel}}」该版本{{offer.responseNote ? '：' + offer.responseNote : ''}}
        </view>
        <block wx:elif="{{offer.canRespond}}">
          <view class="slot-actions">
            <view
              wx:if="{{offerForm !== 'accept'}}"
              class="slot-btn slot-btn-strong"
              data-act-offer-accept="1"
              data-decision="accept"
              bindtap="onOfferRespond"
              hover-class="hover-dim"
            >接受这一版</view>
            <view
              wx:if="{{offerForm !== 'reject'}}"
              class="slot-btn"
              data-act-offer-reject="1"
              data-decision="reject"
              bindtap="onOfferRespond"
              hover-class="hover-dim"
            >拒绝</view>
          </view>
          <view wx:if="{{offerForm}}" class="slot-form">
            <view class="slot-note">
              {{offerForm === 'accept' ? '确认接受' : '拒绝'}} v{{offer.revisionNo}} —— 提交后不可修改
            </view>
            <input
              class="slot-input"
              value="{{offerNote}}"
              bindinput="onOfferNoteInput"
              placeholder="{{offerForm === 'reject' ? '请写明拒绝原因（必填）' : '可选：给经理留一句话'}}"
            />
            <view wx:if="{{offerHint}}" class="slot-note slot-warn">{{offerHint}}</view>
            <view class="slot-actions">
              <view
                class="slot-btn slot-btn-strong"
                data-act-offer-submit="1"
                bindtap="onOfferSubmit"
                hover-class="hover-dim"
              >确认提交</view>
              <view
                class="slot-btn"
                data-act-offer-cancel="1"
                bindtap="onOfferCancel"
                hover-class="hover-dim"
              >取消</view>
            </view>
          </view>
        </block>
        <view wx:else class="slot-note">
          这份发布当前不能再响应（已撤回，或已被同一成果的新版本取代）
        </view>
      </view>

      <!-- 待受理：给真实可执行的受理入口（无权限时服务端会如实拒绝）。
           确认条做成**页内 DOM** 而不是 `wx.showModal`：原生弹层不在渲染树里、
           工具点不到它的确认键 ⇒ 受理这条**唯一会改变业务状态、且不可回退**的路径
           就永远拿不到设备证据（D-4 §5 还要求"被拒后要刷新状态"，那一步同样得看得见）。
           与队列卡片同一形态，区别只是本页只有一张委托（不需要 `claimOpenId` 记账）。
           三个锚点两两不同：`onToggleClaim` 被"展开"与"取消"共用，若都写
           `data-act-claim`，两者在断言与锚点登记表里就同形了（登记表按 file|attr 去重）。 -->
      <view wx:if="{{canClaim}}" class="card slot-card">
        <view class="slot-note">该委托已提交，等待组织成员受理</view>
        <view class="slot-actions">
          <block wx:if="{{claimOpen}}">
            <view class="slot-note">受理后该委托进入组织队列，可以派发任务；此操作不可回退。</view>
            <view
              class="slot-btn slot-btn-strong"
              data-act-claim-submit="1"
              bindtap="onSubmitClaim"
              hover-class="hover-dim"
            >确认受理</view>
            <view
              class="slot-btn"
              data-act-claim-cancel="1"
              bindtap="onToggleClaim"
              hover-class="hover-dim"
            >取消</view>
          </block>
          <view
            wx:else
            class="slot-btn"
            data-act-claim-open="1"
            bindtap="onToggleClaim"
            hover-class="hover-dim"
          >受理委托</view>
        </view>
      </view>

      <!-- 已受理：登记异常 / 变更案件（切片四之六）。入口只在 claimed 时出现 ——
           受理前没有责任主体，`raise_case` 会以 409 拒绝，摆一个必然失败的按钮
           等于把服务端规则说成"随机失败"。 -->
      <view wx:if="{{canCreateCase}}" class="card slot-card">
        <view class="slot-note">遇到异常或需要变更时，在这里登记一宗案件；阻断类案件需要同时登记受影响项</view>
        <view class="slot-actions">
          <view
            class="slot-btn"
            data-act-create-case="create-case"
            bindtap="onCreateCase"
            hover-class="hover-dim"
          >登记异常 / 变更</view>
        </view>
      </view>

      <!-- 归属机制上线前的历史成果：如实报数，不静默藏起来 -->
      <view wx:if="{{unassignedHint}}" class="card slot-card">
        <view class="slot-note">{{unassignedHint}}</view>
      </view>

      <!-- 组装对客报价（S3；合同 §10.1 第 6 步 Release the offer 的前置动作）。
           为什么是**页内表单**而不是弹层或跳页：与「受理委托」「记录任务」同一条判据
           —— 原生弹层不在渲染树里，走查工具点不到它的确认键 ⇒ 关键路径拿不到设备证据。
           入口只在「授权可唯一定位 ∧ 我在该组织内有制作报价权限」时出现（判据在 js）。

           ⚠️ 这里是 WXML 文本节点，**不是 Markdown**：文案里不能出现成对星号，
              否则会原样渲染出多余字符（静态闸见 scripts/verify_entrust_ui.js）。 -->
      <view wx:if="{{canAssembleQuote}}" class="card slot-card">
        <view class="row-between slot-head">
          <text class="slot-title">组装对客报价</text>
        </view>
        <view class="slot-note">
          对客报价是客户能看到的成果，必须由经理按已确认口径组装定版后再发布；船东侧的报价解析稿属于内部底稿，不能直接对客发布。
        </view>
        <view wx:if="{{quoteOpen}}" class="slot-form">
          <view class="slot-note">金额（必填，数字）</view>
          <input
            class="slot-input"
            data-df="amount"
            value="{{quoteForm.amount}}"
            placeholder="例如 36000"
            placeholder-class="input-ph"
            type="digit"
            bindinput="onQuoteInput"
          />
          <view class="slot-note">币种（必填）</view>
          <input
            class="slot-input"
            data-df="currency"
            value="{{quoteForm.currency}}"
            placeholder="CNY"
            placeholder-class="input-ph"
            bindinput="onQuoteInput"
          />
          <view class="slot-note">费用包含（必填，多项用逗号分隔）</view>
          <input
            class="slot-input"
            data-df="includes"
            value="{{quoteForm.includes}}"
            placeholder="内河运费,装船,卸船"
            placeholder-class="input-ph"
            bindinput="onQuoteInput"
          />
          <view class="slot-note">有效期（选填）</view>
          <input
            class="slot-input"
            data-df="validUntil"
            value="{{quoteForm.validUntil}}"
            placeholder="2026-12-31"
            placeholder-class="input-ph"
            bindinput="onQuoteInput"
          />
          <view wx:if="{{quoteHint}}" class="slot-note slot-warn">{{quoteHint}}</view>
          <view class="slot-actions">
            <view
              class="slot-btn slot-btn-strong"
              data-act-quote-submit="1"
              bindtap="onSubmitQuote"
              hover-class="hover-dim"
            >提交组装</view>
            <view
              class="slot-btn"
              data-act-quote-cancel="1"
              bindtap="onCancelQuote"
              hover-class="hover-dim"
            >取消</view>
          </view>
        </view>
        <view wx:else class="slot-actions">
          <view
            class="slot-btn"
            data-act-quote-open="1"
            bindtap="onToggleQuote"
            hover-class="hover-dim"
          >组装对客报价</view>
        </view>
      </view>

      <!-- ── 运力确认与有效期（经理侧 / BP-03 第 2、3 条 / D1-06 / 合同 §10.1 第 5 步）──
           这一段是"这份资源能不能用"的全部判据，也是**内部成本口径**：候选行带承运人
           与供应商单价，确认行带需求量与缺口吨数，逐规则判定里还有比较过程。
           所以整块只在看得到组织侧时渲染 —— 判据在 detail.js（本地组织权限投影里有
           entrust:view，且**取数之前**先判：客户侧一次请求都不发，否则每次开页都是
           一个必然 403，而 403 被吞掉就成了一次静默降级）。
           确认条与登记表单都是**页内 DOM**：原生弹层不在渲染树里、走查工具点不到它的
           确认键 ⇒ 这两条关键路径就永远拿不到设备证据（㉓/㉕D 的 LIMITATION 都这么来的）。
           ⚠️ 这里是 WXML 文本节点，**不是 Markdown**：文案里不能出现成对星号。 -->
      <block wx:if="{{canViewCapacity}}">
        <!-- ① 候选运力：两家可比（吨位 / 装载口径 / 单价口径 / 有效期 / 证据） -->
        <view class="card slot-card">
          <view class="row-between slot-head">
            <text class="slot-title">候选运力</text>
            <text class="slot-note">{{capCandidates.length}} 家</text>
          </view>
          <view class="slot-note">
            登记候选运力只说明这份资源存在、口径是什么；确认运力是另一次独立动作，要逐条过规则才算数。
          </view>

          <view wx:for="{{capCandidates}}" wx:key="candidateId" class="cap-row">
            <view class="row-between">
              <text class="cap-carrier">{{item.carrier}}{{item.vesselName ? ' · ' + item.vesselName : ''}}</text>
              <text class="{{item.statusClass}}">{{item.statusLabel}}</text>
            </view>
            <view class="field-row row-between">
              <text class="field-label">运力</text>
              <text class="field-value">{{item.capacityText}} 吨 · {{item.loadBasis}}</text>
            </view>
            <view class="field-row row-between">
              <text class="field-label">单价</text>
              <text class="field-value">{{item.rateText}}{{item.currency ? ' · ' + item.currency : ''}}</text>
            </view>
            <view class="field-row row-between">
              <text class="field-label">有效期至</text>
              <text class="field-value">{{item.validUntil}}</text>
            </view>
            <view class="field-row row-between">
              <text class="field-label">证据</text>
              <text class="{{item.evidenceCls}}">{{item.evidenceText}}</text>
            </view>

            <block wx:if="{{canRecordCapacity && item.confirmable}}">
              <!-- ⚠️ 判据是 `capConfirmKey === item.candidateId`：两侧都是**字符串**
                   （`capConfirmKey` 来自 dataset 并经 `onOpenCapConfirm` 的 `String()` 归一；
                   `decorateCapacityCandidate` 的 `candidateId` 同样 `String()`）。
                   WXML 的 `===` 是严格比较 —— 一边字符串一边数字会**永远不相等**，
                   表现是"点了「确认这一条」什么都不会出现"：范围框、备注框、提交键
                   在渲染树里根本不存在，而静态门禁与 e2e 全绿（它们查得到锚点写在模板里，
                   查不到运行时类型）。2026-09-17 设备走查 ㊺ 章实测到过这一版：
                   内部状态键已置上、三个锚点命中数全为 0。与下方 `taskOpenKey` 同一条口径。 -->
              <view wx:if="{{capConfirmKey === item.candidateId}}" class="slot-form">
                <view class="slot-note">
                  确认 {{item.carrier}} 的 {{item.capacityText}} 吨：通过后产出采购确认成果，且这条候选不能再被确认第二次。
                </view>
                <input
                  class="slot-input"
                  data-df="cap-scope"
                  value="{{capScope}}"
                  placeholder="本次确认覆盖的范围（必填）"
                  placeholder-class="input-ph"
                  bindinput="onCapInput"
                />
                <input
                  class="slot-input"
                  data-df="cap-note"
                  value="{{capNote}}"
                  placeholder="备注（选填）"
                  placeholder-class="input-ph"
                  bindinput="onCapInput"
                />
                <view wx:if="{{capHint}}" class="slot-note slot-warn">{{capHint}}</view>
                <view class="slot-actions">
                  <view
                    class="slot-btn slot-btn-strong"
                    data-act-cap-confirm-submit="{{item.candidateId}}"
                    bindtap="onSubmitCapConfirm"
                    hover-class="hover-dim"
                  >确认运力</view>
                  <view
                    class="slot-btn"
                    data-act-cap-confirm-cancel="{{item.candidateId}}"
                    bindtap="onCancelCapConfirm"
                    hover-class="hover-dim"
                  >取消</view>
                </view>
              </view>
              <view wx:else class="slot-actions">
                <view
                  class="slot-btn"
                  data-act-cap-confirm-open="{{item.candidateId}}"
                  bindtap="onOpenCapConfirm"
                  hover-class="hover-dim"
                >确认这一条</view>
              </view>
            </block>
          </view>

          <view wx:if="{{!capCandidates.length}}" class="slot-note">还没有登记候选运力</view>

          <!-- ② 两家可比：同一组维度**并排**。纵向卡片要上下滚动 + 靠记忆对齐，
               而"它们在哪一点上不同"恰恰是"要不要选它"的依据 —— 卡片头那句
               「两家可比」在只有纵向列表时是**没有载体的承诺**。
               ⚠️ 只标「有差异」，不标哪一条更好：哪条更合适取决于货量、时效、能否拆批，
                  那是方案判断，投影不替用户判（见 utils/entrust.js 的 buildCapacityComparison）。
               ⚠️ 少于两家不渲染（一条候选没有"并排"可言），判据是 capCompareRows 的长度。 -->
          <view wx:if="{{capCompareRows.length}}" class="cap-compare">
            <view class="slot-note">
              同一组维度并排看 {{capCompareCols.length}} 家：标出「有差异」的维度，就是它们真正不同的地方。
            </view>
            <scroll-view scroll-x class="cap-compare-scroll">
              <view class="cap-compare-grid">
                <view class="cap-compare-row cap-compare-headrow">
                  <view class="cap-compare-label">维度</view>
                  <view
                    wx:for="{{capCompareCols}}"
                    wx:for-item="cc"
                    wx:key="candidateId"
                    class="cap-compare-cell cap-compare-head"
                  >{{cc.head}}</view>
                </view>
                <view wx:for="{{capCompareRows}}" wx:key="key" class="cap-compare-row">
                  <view class="cap-compare-label">
                    <text>{{item.label}}</text>
                    <text wx:if="{{item.diff}}" class="cap-compare-diff">有差异</text>
                  </view>
                  <view
                    wx:for="{{item.cells}}"
                    wx:for-item="cell"
                    wx:key="i"
                    class="cap-compare-cell"
                  >{{cell.text}}</view>
                </view>
              </view>
            </scroll-view>
          </view>

          <!-- 被拒时的**逐条**判定：通过的项也在（后端特意全给；只给没过的那几条，
               会让人改完再撞下一条）。顺序取后端给的 seq。 -->
          <view wx:if="{{capRuleRows.length}}" class="cap-verdict">
            <view class="cap-verdict-title">运力不能确认：{{capRuleTitle}}</view>
            <view class="cap-verdict-sub">
              下面是这一条候选的逐条判定（通过的也在内 —— 只回没过的那几条，会让人改完再撞下一条）。
            </view>
            <view wx:for="{{capRuleRows}}" wx:for-item="rr" wx:key="seq" class="cap-rule">
              <text class="{{rr.outcomeClass}}">{{rr.seq}} {{rr.ruleLabel}} · {{rr.outcomeLabel}}</text>
              <view class="cap-rule-detail">{{rr.detail}}</view>
            </view>
          </view>

          <!-- ② 登记候选运力（页内表单，不用原生弹层） -->
          <block wx:if="{{canRecordCapacity}}">
            <view wx:if="{{capOpen}}" class="slot-form">
              <view class="slot-note">登记一条候选运力事实（这一步不确认任何东西）</view>
              <input
                class="slot-input"
                data-df="cap-carrier"
                value="{{capForm.carrier}}"
                placeholder="承运人（必填）"
                placeholder-class="input-ph"
                bindinput="onCapInput"
              />
              <input
                class="slot-input"
                data-df="cap-vessel"
                value="{{capForm.vesselName}}"
                placeholder="船名（选填）"
                placeholder-class="input-ph"
                bindinput="onCapInput"
              />
              <input
                class="slot-input"
                data-df="cap-tonnes"
                value="{{capForm.capacityTonnes}}"
                placeholder="运力吨位（必填，例如 900）"
                placeholder-class="input-ph"
                type="digit"
                bindinput="onCapInput"
              />
              <input
                class="slot-input"
                data-df="cap-vessels"
                value="{{capForm.vesselCount}}"
                placeholder="船数（默认 1）"
                placeholder-class="input-ph"
                type="number"
                bindinput="onCapInput"
              />
              <view class="slot-note">装载口径（判容量要用到：允许拆批或多船承运时，同样的吨位含义不同）</view>
              <view class="cap-picks">
                <view
                  class="{{capForm.allowsPartialLoad ? 'cap-pick' : 'cap-pick cap-pick-on'}}"
                  data-act-cap-partial="0"
                  bindtap="onCapPickPartial"
                  hover-class="hover-dim"
                >不拆批</view>
                <view
                  class="{{capForm.allowsPartialLoad ? 'cap-pick cap-pick-on' : 'cap-pick'}}"
                  data-act-cap-partial="1"
                  bindtap="onCapPickPartial"
                  hover-class="hover-dim"
                >允许拆批</view>
              </view>
              <input
                class="slot-input"
                data-df="cap-rate"
                value="{{capForm.rate}}"
                placeholder="单价（选填，例如 45）"
                placeholder-class="input-ph"
                type="digit"
                bindinput="onCapInput"
              />
              <input
                class="slot-input"
                data-df="cap-rate-unit"
                value="{{capForm.rateUnit}}"
                placeholder="计价单位（例如 吨）"
                placeholder-class="input-ph"
                bindinput="onCapInput"
              />
              <input
                class="slot-input"
                data-df="cap-currency"
                value="{{capForm.currency}}"
                placeholder="币种（例如 CNY）"
                placeholder-class="input-ph"
                bindinput="onCapInput"
              />
              <input
                class="slot-input"
                data-df="cap-valid"
                value="{{capForm.validUntil}}"
                placeholder="有效期至（例如 2026-12-31）"
                placeholder-class="input-ph"
                bindinput="onCapInput"
              />
              <view class="slot-note">证据类别（选填；可后补，但确认时「类别 + 引用」缺一不可）</view>
              <view class="cap-picks">
                <view
                  wx:for="{{capEvidenceOptions}}"
                  wx:for-item="option"
                  wx:key="key"
                  class="cap-pick {{capForm.evidenceKind === option.key ? 'cap-pick-on' : ''}}"
                  data-act-cap-kind="{{option.key}}"
                  bindtap="onCapPickKind"
                  hover-class="hover-dim"
                >{{option.label}}</view>
              </view>
              <input
                class="slot-input"
                data-df="cap-evidence-ref"
                value="{{capForm.evidenceRef}}"
                placeholder="证据引用（例如 报价单-20260917.pdf）"
                placeholder-class="input-ph"
                bindinput="onCapInput"
              />
              <view wx:if="{{capHint}}" class="slot-note slot-warn">{{capHint}}</view>
              <view class="slot-actions">
                <view
                  class="slot-btn slot-btn-strong"
                  data-act-cap-submit="1"
                  bindtap="onSubmitCap"
                  hover-class="hover-dim"
                >登记候选</view>
                <view
                  class="slot-btn"
                  data-act-cap-cancel="1"
                  bindtap="onCancelCap"
                  hover-class="hover-dim"
                >取消</view>
              </view>
            </view>
            <view wx:else class="slot-actions">
              <view
                class="slot-btn"
                data-act-cap-open="1"
                bindtap="onToggleCap"
                hover-class="hover-dim"
              >登记候选运力</view>
            </view>
          </block>
        </view>

        <!-- ③ 已作出的确认（**冻结副本**）+ 只读复算。
             确认范围 agreed_scope 只落在「采购确认成果」的载荷里，确认行上没有它的落点
             ⇒ 这里给的是**成果引用**（点进成果页看范围与金额），而不是在这一格里编一个空值。 -->
        <view wx:if="{{capConfirmations.length}}" class="card slot-card">
          <view class="row-between slot-head">
            <text class="slot-title">运力确认</text>
            <text class="slot-note">{{capConfirmations.length}} 条</text>
          </view>
          <view class="slot-note">
            下面是确认那一刻的冻结值（候选行后来被改写也不影响它）。想看现在还成不成立，用「复算这条确认」。
          </view>
          <view wx:for="{{capConfirmations}}" wx:key="confirmationId" class="cap-row">
            <view class="row-between">
              <text class="cap-carrier">{{item.carrier}}{{item.vesselName ? ' · ' + item.vesselName : ''}}</text>
              <text class="cap-confirmed">已确认运力</text>
            </view>
            <view class="field-row row-between">
              <text class="field-label">确认运力</text>
              <text class="field-value">{{item.capacityText}} 吨 · {{item.loadBasis}}</text>
            </view>
            <view class="field-row row-between">
              <text class="field-label">单价</text>
              <text class="field-value">{{item.rateText}}{{item.currency ? ' · ' + item.currency : ''}}</text>
            </view>
            <view class="field-row row-between">
              <text class="field-label">有效期至</text>
              <text class="field-value">{{item.validUntil}}</text>
            </view>
            <view class="field-row row-between">
              <text class="field-label">需求快照</text>
              <text class="field-value">{{item.demandText}}</text>
            </view>
            <view class="field-row row-between">
              <text class="field-label">判定基准日</text>
              <text class="field-value">{{item.asOfDate}} · 规则集 {{item.ruleSetVersion}}</text>
            </view>
            <view class="slot-note">{{item.ruleSummary}}</view>
            <view wx:for="{{item.ruleRows}}" wx:for-item="rr" wx:key="seq" class="cap-rule">
              <text class="{{rr.outcomeClass}}">{{rr.seq}} {{rr.ruleLabel}} · {{rr.outcomeLabel}}</text>
              <view class="cap-rule-detail">{{rr.detail}}</view>
            </view>
            <view wx:if="{{item.scopeText}}" class="slot-note">本次确认覆盖的范围：{{item.scopeText}}</view>
            <view wx:else class="cap-warn">本次确认的范围未记录（确认时必填 —— 缺失说明那一版成果载荷异常）</view>
            <view wx:if="{{item.note}}" class="slot-note">{{item.note}}</view>
            <view class="slot-refs">
              <view
                class="slot-ref slot-ref-link"
                data-id="{{item.artifactId}}"
                data-kind="artifact"
                bindtap="onOpenRef"
                hover-class="hover-dim"
              >{{item.artifactRefText}} ›</view>
            </view>
            <view class="slot-actions">
              <view
                class="slot-btn"
                data-act-cap-recheck="{{item.confirmationId}}"
                bindtap="onCapRecheck"
                hover-class="hover-dim"
              >复算这条确认</view>
            </view>
            <!-- `data-act-cap-recheck-verdict` 是**复算结果真的渲染出来了**的锚点。
                 没有它，设备走查只能证到"复算键可点" —— 而「判据不出现」恰恰是
                 2026-09-17 实测到的那一版（`capRecheckId` 是字符串、`item.confirmationId`
                 若是数字则 `===` 恒假）：请求发了、页面什么都没多出来。 -->
            <view
              wx:if="{{capRecheckId === item.confirmationId && capRecheck}}"
              data-act-cap-recheck-verdict="{{item.confirmationId}}"
              class="cap-verdict"
            >
              <view class="cap-verdict-title">{{capRecheck.validLabel}}（复算基准日 {{capRecheck.asOfDate}}）</view>
              <view class="cap-verdict-sub">判定输入的变化：{{capRecheck.changedText}}</view>
              <view wx:if="{{capRecheck.failedText}}" class="cap-verdict-sub cap-warn">{{capRecheck.failedText}}</view>
              <view class="cap-verdict-sub">{{capRecheck.note}}</view>
            </view>
            <view wx:if="{{capRecheckHint}}" class="slot-note slot-warn">{{capRecheckHint}}</view>
          </view>
        </view>
      </block>

      <!-- 七槽位（顺序与 key 由 utils/entrust.js 的 WORKBENCH_SLOTS 决定） -->
      <view wx:for="{{slots}}" wx:key="key" class="card slot-card">
        <view class="row-between slot-head">
          <text class="slot-title">{{item.title}}</text>
          <text wx:if="{{item.tag}}" class="{{item.tagClass}}">{{item.tag}}</text>
        </view>

        <!-- 本期未开放：说清"能力还没做"，而不是显示成"这单没有" -->
        <view wx:if="{{!item.available}}" class="slot-note">{{item.note}}</view>

        <block wx:else>
          <view
            wx:for="{{item.fields}}"
            wx:for-item="f"
            wx:key="label"
            class="field-row row-between"
          >
            <text class="field-label">{{f.label}}</text>
            <text class="{{f.cls}}">{{f.value}}</text>
          </view>

          <view wx:if="{{item.issues.length}}" class="slot-issues">
            <view wx:for="{{item.issues}}" wx:for-item="it" wx:key="text" class="slot-issue">
              <text wx:if="{{it.kindLabel}}" class="slot-issue-kind">{{it.kindLabel}}</text>
              <text class="slot-issue-text">{{it.text}}</text>
            </view>
          </view>

          <!-- 槽位引用可点（UI-05 第二片 / ENT-023；案件引用是 ENT-030 切片四之五）。
               点的是**这一条**的 ID，而不是"去列表里再找一次" ——
               工作台引用的本来就是精确 ID 与版本（PRD 第 187 行），
               让用户自己再找一遍就是把已经确定的事实重新变成可能搞错的事。
               两个形状（成果 / 案件）由投影层各给一行 `text` 与一个 `kind`：
               本页只把 `kind` **原样转交** `onOpenRef`，既不猜字段、
               也不自己决定"这条该跳去哪"（那是 `REF_PROJECTORS` 的事）。 -->
          <view wx:if="{{item.refs.length}}" class="slot-refs">
            <view
              wx:for="{{item.refs}}"
              wx:for-item="rf"
              wx:key="id"
              class="slot-ref slot-ref-link {{rf.cls}}"
              data-id="{{rf.id}}"
              data-kind="{{rf.kind}}"
              bindtap="onOpenRef"
              hover-class="hover-dim"
            >{{rf.text}} ›</view>
          </view>

          <view wx:if="{{item.countsText}}" class="slot-counts">{{item.countsText}}</view>

          <view wx:if="{{item.actionLabel}}" class="slot-actions">
            <!-- 记录任务的**页内输入条**（2026-09-16 取代 `wx.showModal({editable:true})`）：
                 可编辑弹层同样不在渲染树里、确认键点不到 ⇒ "记录任务"这条关键输入
                 在真机上永远无法被验证。写法与案件页的 `act-input` 一致：
                 输入框带 `data-df` 标记、提交/取消各一个锚点，属性名两两不同。
                 ⚠️ 判据是 `taskOpenKey === item.key`：两侧都是**字符串**
                 （页面侧 `String(ds.key)` 归一、`WORKBENCH_SLOTS` 的 key 本就是字符串），
                 WXML 的 `===` 是严格比较，一边字符串一边数字会**永远不相等**
                 ⇒ 表现是"点了记录任务没反应"，且静态门禁查不出来。 -->
            <view wx:if="{{taskOpenKey === item.key}}" class="slot-form">
              <view class="slot-note">记录任务 · {{taskForm.typeLabel}}</view>
              <input
                class="slot-input"
                data-df="task-title"
                value="{{taskForm.title}}"
                placeholder="任务标题（1–128 字）"
                placeholder-class="input-ph"
                maxlength="128"
                bindinput="onTaskInput"
              />
              <view
                class="slot-btn slot-btn-strong"
                data-act-task-submit="{{item.key}}"
                bindtap="onSubmitTask"
                hover-class="hover-dim"
              >提交任务</view>
              <view
                class="slot-btn"
                data-act-task-cancel="{{item.key}}"
                bindtap="onCancelTask"
                hover-class="hover-dim"
              >取消</view>
              <view wx:if="{{taskHint}}" class="slot-note slot-warn">{{taskHint}}</view>
            </view>
            <!-- 任务类型选择：页内展开（不用 showActionSheet —— 超过 6 项在真机底部会被切断，
                 项目约定长列表走专用组件；这里只有 7 项且同在一张卡内，展开更少上下文切换） -->
            <view wx:if="{{item.taskPick && pickKey === item.key}}" class="slot-picks">
              <view
                wx:for="{{taskTypes}}"
                wx:for-item="tt"
                wx:key="key"
                class="slot-pick"
                data-type="{{tt.key}}"
                bindtap="onPickTaskType"
                hover-class="hover-dim"
              >{{tt.label}}</view>
            </view>
            <view
              class="slot-btn"
              data-key="{{item.key}}"
              data-task="{{item.taskType}}"
              bindtap="onRecordTask"
              hover-class="hover-dim"
            >
              {{item.actionLabel}}
            </view>
          </view>
        </block>
      </view>

      <view class="card status-note">
        <view class="status-note-title">当前状态说明</view>
        <view class="status-note-body">{{detail.statusHint || '该状态暂无说明'}}</view>
      </view>
    </block>
  </view>
</view>
