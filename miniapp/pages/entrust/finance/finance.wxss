/* 委托发货 · 财务与结算（§10.1 第 10–11 步的界面入口）
   只写本页自己的类；`.card` / `.btn-ghost` / `.btn-mini` / `.chip` / `.row`
   来自全局 `app.wxss`，不重复定义（重复定义迟早与全局漂移）。 */

.fin-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx 8rpx;
}
.nav-back {
  font-size: 28rpx;
  color: #3B5BDB;
  padding: 8rpx 12rpx;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0F2540;
}
.nav-right { width: 96rpx; }

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F2540;
  margin-bottom: 16rpx;
}

.row {
  flex-direction: column;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #EEF2F7;
}
.row:last-child { border-bottom: none; }

.row-k {
  font-size: 28rpx;
  color: #0F2540;
}
.row-v {
  font-size: 28rpx;
  color: #0F2540;
}
.row-sub {
  font-size: 24rpx;
  color: #6B7A8C;
}
.strong { font-weight: 600; }

.hint {
  font-size: 24rpx;
  color: #6B7A8C;
  margin: 8rpx 0;
}
.blocker {
  font-size: 24rpx;
  color: #F08C00;
  margin: 4rpx 0;
}
.bal,
.totals {
  display: flex;
  flex-direction: column;
  padding: 8rpx 0;
}

.acts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}
.btn {
  display: inline-block;
  margin-top: 16rpx;
  padding: 14rpx 24rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  text-align: center;
  color: #3B5BDB;
  background: rgba(59, 91, 219, .08);
}

.form {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #F7F9FC;
}

.input {
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  background: #FFFFFF;
  border: 1rpx solid #E3E9F2;
  font-size: 26rpx;
  color: #0F2540;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip-on {
  background: rgba(59, 91, 219, .12);
  color: #3B5BDB;
  font-weight: 600;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F2540;
  margin-bottom: 8rpx;
}
.empty-hint {
  font-size: 24rpx;
  color: #6B7A8C;
}
