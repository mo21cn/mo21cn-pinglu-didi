/* 智慧关务 · 归类辅助 —— 只写本页特有排版；`.page` / `.page-content` / `.empty` /
   `.empty-icon` / `.empty-title` / `.empty-hint` / `.btn-primary` 复用 app.wxss 全局类 */

.head-bg {
  background: linear-gradient(135deg, #57D780, #26D554);
  padding-bottom: 24rpx;
}

.nav-inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  font-size: 48rpx;
  line-height: 1;
  color: #FFFFFF;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.nav-spacer {
  width: 64rpx;
}

.head-sub {
  padding: 0 32rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, .9);
}

.hover-dim {
  opacity: .72;
}

/* ---- 通用卡片 ---- */
.cls-card {
  margin: 24rpx 24rpx 0;
  padding: 28rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 45, 61, .06);
}

.cls-card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2D3D;
}

.cls-field {
  margin-top: 20rpx;
}

.cls-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #7A8699;
}

.cls-input {
  height: 76rpx;
  padding: 0 20rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1F2D3D;
}

.cls-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #9AA5B5;
}

.cls-btn {
  margin-top: 24rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  background: #26D554;
  color: #FFFFFF;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.cls-btn.busy {
  background: #A8E7BC;
}

/* ---- 状态徽标 ---- */
.cls-status {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #7A8699;
  background: #F0F2F5;
}

.cls-status.suggested {
  color: #127F45;
  background: #E4F8EC;
}

.cls-status.manual_required {
  color: #9A6200;
  background: #FFF4DE;
}

.cls-status.confirmed {
  color: #0B6BCB;
  background: #E6F1FE;
}

.cls-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9AA5B5;
}

/* ---- 结论 / 无结论 ---- */
.cls-verdict {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #E6F1FE;
  border-radius: 14rpx;
}

.cls-verdict.none {
  background: #F5F7FA;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7A8699;
}

.cls-verdict-label {
  font-size: 22rpx;
  color: #0B6BCB;
}

.cls-verdict-code {
  display: block;
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #0B6BCB;
}

.cls-verdict-by {
  font-size: 22rpx;
  color: #7A8699;
}

/* ---- 降级：一句中文原因 + 机器可读的 kind ---- */
.cls-degraded {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #FFF4DE;
  border-radius: 14rpx;
}

.cls-degraded-tag {
  display: inline-block;
  margin-right: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #9A6200;
  background: #FFE7B8;
}

.cls-degraded-msg {
  font-size: 25rpx;
  line-height: 1.6;
  color: #7A4A00;
}

.cls-degraded-kind {
  font-size: 22rpx;
  color: #B08040;
}

/* ---- 候选 ---- */
.cls-cand {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: #FAFBFC;
  border: 1rpx solid #EDF0F4;
  border-radius: 14rpx;
}

.cls-cand-line {
  display: flex;
  align-items: center;
}

.cls-cand-code {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #1F2D3D;
}

.cls-cand-conf {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #7A8699;
}

.cls-cand-src {
  margin-left: auto;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.cls-cand-src.model {
  color: #5A6472;
  background: #EEF1F5;
}

.cls-cand-src.manual {
  color: #0B6BCB;
  background: #E6F1FE;
}

.cls-cand-label {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #3D4A5C;
}

.cls-cand-why {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #9AA5B5;
}

.cls-empty {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9AA5B5;
}

.cls-err {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #D93026;
}

/* ---- 人工定稿块：视觉上与候选刻意区分，避免被读成"又一个候选" ---- */
.cls-manual {
  border: 2rpx solid #D7EEE1;
}

/* ---- 历史列表 ---- */
.cls-sec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 32rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2D3D;
}

.cls-sec-count {
  font-size: 22rpx;
  font-weight: 400;
  color: #9AA5B5;
}

.cls-item {
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(31, 45, 61, .05);
}

.cls-item-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cls-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2D3D;
}

.cls-item-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9AA5B5;
}

.cls-foot {
  margin: 24rpx 32rpx 40rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #9AA5B5;
}
