/* 智慧关务 · 首页 —— 只写本页特有排版；`.page` / `.page-content` / `.empty` /
   `.empty-icon` / `.btn-primary` 复用 app.wxss 的全局类 */

.head-bg {
  background: linear-gradient(135deg, #57D780, #26D554);
  padding-bottom: 24rpx;
}

.nav-inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  font-size: 48rpx;
  line-height: 1;
  color: #FFFFFF;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.nav-spacer {
  width: 64rpx;
}

.head-sub {
  padding: 0 32rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, .9);
}

.hover-dim {
  opacity: .72;
}

/* ---- 数据源状态条 ---- */
.src-card {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 45, 61, .06);
}

.src-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.src-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2D3D;
}

.src-time {
  font-size: 22rpx;
  color: #98A6B8;
}

.src-notice {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #F4FBF6;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #1B7A44;
  line-height: 1.5;
}

.src-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0F3F7;
}

.src-row:last-child {
  border-bottom: none;
}

.src-main {
  flex: 1;
  padding-right: 16rpx;
}

.src-label {
  display: block;
  font-size: 27rpx;
  color: #1F2D3D;
}

.src-reason {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8C9AAB;
  line-height: 1.5;
}

.src-chip {
  flex: none;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.src-chip.ok {
  background: #E8F8EE;
  color: #1B7A44;
}

.src-chip.off {
  background: #FFF1F0;
  color: #C0392B;
}

/* 官方源不可用时的那句说明 —— 替代输入框存在 */
.src-off {
  margin-top: 16rpx;
  padding: 18rpx;
  background: #FFF8E6;
  border-left: 6rpx solid #F5A623;
  border-radius: 10rpx;
}

.src-off-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #8A5A00;
}

.src-off-hint {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #A07A2A;
  line-height: 1.5;
}

/* ---- 列表区 ---- */
.sec-title {
  display: flex;
  align-items: center;
  margin: 32rpx 24rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2D3D;
}

.sec-tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #EEF2F7;
  font-size: 20rpx;
  font-weight: 400;
  color: #7A8798;
}

.search-row {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 0;
}

.search-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #1F2D3D;
}

.search-btn {
  flex: none;
  margin-left: 16rpx;
  padding: 0 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 16rpx;
  background: #26D554;
  color: #FFFFFF;
  font-size: 27rpx;
}

.search-clear {
  margin: 12rpx 24rpx 0;
  font-size: 23rpx;
  color: #3B5BDB;
}

.list-hint {
  margin: 16rpx 24rpx 0;
  font-size: 23rpx;
  color: #C0392B;
}

.empty-title {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #5B6B7F;
}

.empty-hint {
  display: block;
  margin-top: 10rpx;
  padding: 0 60rpx;
  font-size: 23rpx;
  color: #98A6B8;
  line-height: 1.6;
}

.rec-card {
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 45, 61, .06);
}

.rec-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rec-no {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2D3D;
}

.rec-status {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.rec-status.done {
  background: #E8F8EE;
  color: #1B7A44;
}

.rec-status.doing {
  background: #EEF4FF;
  color: #3B5BDB;
}

.rec-meta {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #8C9AAB;
}

.rec-meta-item {
  margin-right: 12rpx;
}

.foot-note {
  margin: 40rpx 24rpx 60rpx;
  font-size: 22rpx;
  color: #A9B4C2;
  text-align: center;
  line-height: 1.6;
}
