<!--
  船东端首页（找货 · v1）
-->
<view class="page">
  <view class="top-bar">
    <view class="top-bar-row">
      <view class="top-bar-logo">
        <text class="logo-glyph">⚓</text>
      </view>
      <view class="top-bar-search" bindtap="goSearch" hover-class="top-bar-search-hover">
        <text class="search-icon">🔍</text>
        <text class="search-placeholder">搜索货类 / 港口 / 航线</text>
      </view>
      <view class="top-bar-actions">
        <view class="top-icon" bindtap="goAI" hover-class="top-icon-hover">
          <view class="top-icon-glyph top-icon-ai">✨</view>
          <text class="top-icon-label">AI</text>
        </view>
        <view class="top-icon" bindtap="goAssistant" hover-class="top-icon-hover">
          <view class="top-icon-glyph top-icon-cs">💬</view>
          <text class="top-icon-label">客服</text>
        </view>
      </view>
    </view>
  </view>

  <view class="content">
    <view class="tab-bar">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab {{currentTab === item.key ? 'tab-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="switchTab"
        hover-class="tab-hover"
      >
        <text>{{item.label}}</text>
        <view wx:if="{{item.count > 0}}" class="tab-badge">{{item.count}}</view>
      </view>
    </view>

    <view wx:if="{{currentTab === 'find'}}">
      <view class="filter-bar">
        <view class="filter-item" bindtap="onFilterRegion" hover-class="filter-item-hover">
          <text class="filter-label">{{filterRegionLabel}}</text>
          <text class="filter-caret">▾</text>
        </view>
        <view class="filter-item" bindtap="onFilterTime" hover-class="filter-item-hover">
          <text class="filter-label">{{filterTimeLabel}}</text>
          <text class="filter-caret">▾</text>
        </view>
        <view class="filter-item" bindtap="onFilterMore" hover-class="filter-item-hover">
          <text class="filter-label">筛选</text>
          <text class="filter-caret">▾</text>
        </view>
      </view>

      <view wx:if="{{loading && cargoList.length === 0}}" class="loading">加载中...</view>
      <view wx:elif="{{cargoList.length === 0}}" class="empty">
        <view class="empty-icon">📭</view>
        <view>暂无货源</view>
      </view>

      <view wx:else class="cargo-list">
        <view
          wx:for="{{cargoList}}"
          wx:key="id"
          class="cargo-card"
          data-item="{{item}}"
          bindtap="onCargoTap"
          hover-class="cargo-card-hover"
        >
          <view class="cargo-card-head">
            <view class="cargo-card-tags">
              <text class="chip chip-purple">{{cargoTypeLabel(item.cargo_type)}}</text>
              <text wx:if="{{item.offer_price}}" class="chip">¥ {{item.offer_price}}</text>
              <text wx:else class="chip chip-muted">面议</text>
            </view>
            <text class="cargo-card-time">{{item.time_ago}}</text>
          </view>

          <view class="cargo-card-body">
            <view class="cargo-owner">
              <text class="cargo-owner-name">{{item.owner_label}}</text>
              <text class="cargo-owner-dist">{{item.distance_label}}</text>
            </view>
            <view class="cargo-route">
              <view class="route-from">
                <view class="route-dot route-dot-blue"></view>
                <text class="route-name">{{portLabel(item.origin_port)}}</text>
              </view>
              <view class="route-line"></view>
              <view class="route-to">
                <view class="route-dot route-dot-purple"></view>
                <text class="route-name">{{portLabel(item.dest_port)}}</text>
              </view>
            </view>
          </view>

          <view class="cargo-card-foot">
            <view class="cargo-meta">
              <text>{{item.cargo_name}}</text>
              <text class="cargo-meta-sep">·</text>
              <text>{{item.weight_t}} 吨</text>
              <text class="cargo-meta-sep">·</text>
              <text>{{item.expect_date}} 装</text>
            </view>
            <view class="btn-grab" catchtap="onGrab" data-id="{{item.id}}">
              <text>立即抢单</text>
            </view>
          </view>
        </view>
      </view>

      <view class="promo-banner" bindtap="onPromoTap" hover-class="promo-banner-hover">
        <view class="promo-left">
          <view class="promo-title">录入蜂羽宣言</view>
          <view class="promo-sub">抽万元大奖 · 活动进行中</view>
        </view>
        <view class="promo-right">
          <view class="promo-cta">点击</view>
          <view class="promo-cta-sub">参与</view>
        </view>
      </view>
    </view>

    <view wx:if="{{currentTab === 'fleet'}}">
      <view wx:if="{{shipLoading && shipList.length === 0}}" class="loading">加载中...</view>
      <view wx:elif="{{shipList.length === 0}}" class="empty">
        <view class="empty-icon">⚓</view>
        <view>暂无船舶</view>
        <view class="empty-sub">点击下方按钮备案第一艘船</view>
      </view>

      <view wx:else class="ship-list">
        <view
          wx:for="{{shipList}}"
          wx:key="id"
          class="ship-card"
          hover-class="ship-card-hover"
        >
          <view class="ship-card-head">
            <text class="ship-name">{{item.ship_name}}</text>
            <text class="badge badge-{{item.status}}">{{shipStatusLabel(item.status)}}</text>
          </view>
          <view class="ship-row">
            <text>载重 {{item.deadweight_t}} 吨 · 吃水 {{item.draft_m}} 米</text>
            <text>{{item.length_m}} × {{item.width_m}} 米</text>
          </view>
          <view class="ship-row">
            <text>证书：{{item.cert_no}}</text>
          </view>
          <view wx:if="{{item.status === 'rejected'}}" class="reject-reason">
            驳回原因：{{item.reject_reason}}
          </view>
          <view wx:if="{{item.status === 'verified'}}" class="ship-actions">
            <view class="btn-secondary" catchtap="onShipMatch" data-id="{{item.id}}">智能找货</view>
          </view>
        </view>
      </view>

      <view class="add-ship-row">
        <view class="btn-secondary btn-secondary-full" bindtap="goAddShip">+ 备案新船舶</view>
      </view>
    </view>

    <view wx:if="{{currentTab === 'registry'}}">
      <view class="registry-form">
        <view class="form-title">船舶备案</view>
        <view class="form-tip">提交后由平台审核，审核通过后方可接单</view>

        <view class="form-fields">
          <view class="form-row">
            <text class="form-label">船名 *</text>
            <input class="form-input" placeholder="如：平陆001" value="{{regForm.ship_name}}" data-field="ship_name" bindinput="onRegInput" placeholder-class="input-ph" />
          </view>
          <view class="form-row form-row-pick" bindtap="pickShipType">
            <text class="form-label">船型</text>
            <text class="form-value">{{regShipTypeLabel}}  ›</text>
          </view>
          <view class="form-row">
            <text class="form-label">载重吨 *</text>
            <input class="form-input" type="digit" placeholder="如：2000" value="{{regForm.deadweight_t}}" data-field="deadweight_t" bindinput="onRegInput" placeholder-class="input-ph" />
          </view>
          <view class="form-row form-row-half-row">
            <view class="form-half">
              <text class="form-label">船长（米）</text>
              <input class="form-input" type="digit" placeholder="如：88" value="{{regForm.length_m}}" data-field="length_m" bindinput="onRegInput" placeholder-class="input-ph" />
            </view>
            <view class="form-half">
              <text class="form-label">船宽（米）</text>
              <input class="form-input" type="digit" placeholder="如：13.6" value="{{regForm.width_m}}" data-field="width_m" bindinput="onRegInput" placeholder-class="input-ph" />
            </view>
          </view>
          <view class="form-row">
            <text class="form-label">满载吃水（米）*</text>
            <input class="form-input" type="digit" placeholder="如：3.8（撮合硬约束）" value="{{regForm.draft_m}}" data-field="draft_m" bindinput="onRegInput" placeholder-class="input-ph" />
          </view>
          <view class="form-row">
            <text class="form-label">检验证书号 *</text>
            <input class="form-input" placeholder="如：CERT-2026-0001" value="{{regForm.cert_no}}" data-field="cert_no" bindinput="onRegInput" placeholder-class="input-ph" />
          </view>
          <view class="form-row">
            <text class="form-label">证书有效期 *</text>
            <input class="form-input" placeholder="如：2027-12-31" value="{{regForm.cert_expiry}}" data-field="cert_expiry" bindinput="onRegInput" placeholder-class="input-ph" />
          </view>
        </view>

        <button class="btn-primary-reg" loading="{{regSubmitting}}" bindtap="submitRegForm">提交备案（待审核）</button>
      </view>
    </view>

    <view class="content-bottom-space"></view>
  </view>
</view>
