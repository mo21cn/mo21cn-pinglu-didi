/* 船东端首页（03）· 找货 */
page { background: #F5F7FA; }

.page-content { padding: 24rpx 24rpx 0; }

/* ---- 顶栏 ---- */
.top {
  background: linear-gradient(180deg, #E6EDFF 0%, #F2F6FF 100%);
  padding: calc(12rpx + env(safe-area-inset-top)) 28rpx 22rpx;
}
.top-row1 { display: flex; align-items: center; height: 78rpx; }
.top-avatar {
  width: 66rpx; height: 66rpx;
  border-radius: 50%;
  background: #FFFFFF;
  font-size: 32rpx;
  line-height: 66rpx;
  text-align: center;
  margin-right: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(61, 90, 219, .12);
}
.top-loc { flex: 1; display: flex; align-items: center; gap: 8rpx; }
.loc-dot { font-size: 26rpx; }
.loc-text { font-size: 30rpx; font-weight: 600; color: #14233B; }
.caret { font-size: 22rpx; color: #7C8CA0; margin-left: 2rpx; }
.top-role {
  display: flex; align-items: center; gap: 6rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  box-shadow: 0 2rpx 10rpx rgba(61, 90, 219, .10);
}
.top-role-label { font-size: 25rpx; color: #3B5BDB; font-weight: 600; }

.top-row2 { display: flex; align-items: center; gap: 14rpx; margin-top: 20rpx; }
.search-box {
  flex: 1; display: flex; align-items: center; gap: 12rpx;
  height: 74rpx; padding: 0 24rpx;
  background: #FFFFFF; border-radius: 999rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 90, 219, .08);
}
.search-box-hover { background: #F7F9FF; }
.search-ico { font-size: 26rpx; }
.search-ph { font-size: 26rpx; color: #A8B4C4; }
.top-act { display: flex; flex-direction: column; align-items: center; width: 68rpx; }
.act-glyph { font-size: 32rpx; line-height: 1.1; }
.act-label { font-size: 20rpx; color: #5C6B80; margin-top: 2rpx; }
.hover-dim { opacity: .6; }

/* ---- 货源大厅 ---- */
.pill-caret { font-size: 20rpx; color: #7C8CA0; margin-left: 4rpx; }

.sort-item { font-size: 26rpx; }
.sort-icon-btn {
  margin-left: auto;
  display: flex; align-items: center;
  height: 52rpx; padding: 0 20rpx;
  border-radius: 999rpx;
  background: #F4F6FB;
  font-size: 24rpx;
  color: #3D4C63;
}

.cargo-list { padding: 4rpx 24rpx 24rpx; }
.cargo-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid #EEF2F9;
  box-shadow: 0 2rpx 14rpx rgba(61, 90, 219, .06);
  margin-bottom: 20rpx;
}
.cargo-card:last-child { margin-bottom: 0; }
.cargo-card-hover { background: #FAFBFF; }

.cargo-route { display: flex; align-items: center; gap: 12rpx; }
.cr-name { font-size: 32rpx; font-weight: 700; color: #14233B; }
.cr-arrow {
  font-size: 22rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  border-radius: 999rpx;
  padding: 0 14rpx;
  line-height: 32rpx;
}
.cr-price {
  margin-left: auto;
  font-size: 24rpx;
  color: #7048E8;
  background: rgba(112, 72, 232, .08);
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}

.cargo-mid { margin-top: 16rpx; display: flex; align-items: center; gap: 8rpx; }
.cargo-name { font-size: 28rpx; color: #3D4C63; }
.cargo-sep { color: #C3CCD8; }
.cargo-weight { font-size: 28rpx; color: #3D4C63; font-weight: 600; }

.cargo-foot {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F1F4F8;
  display: flex;
  align-items: center;
}
.cargo-owner { flex: 1; display: flex; align-items: center; gap: 14rpx; }
.owner-name { font-size: 25rpx; color: #3D4C63; font-weight: 500; }
.owner-time { font-size: 23rpx; color: #A8B4C4; }

.btn-view {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #3B5BDB;
  font-weight: 600;
  background: rgba(59, 91, 219, .09);
  border: 1rpx solid rgba(59, 91, 219, .22);
}
.btn-view-hover { background: rgba(59, 91, 219, .16); }

/* ---- 我的船队入口 ---- */
.my-entry-card { padding: 0; }
.my-entry { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 28rpx; }
.my-entry-icon {
  width: 68rpx; height: 68rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #E8EEFF 0%, #E4DBFF 100%);
  font-size: 32rpx; line-height: 68rpx; text-align: center;
}
.my-entry-body { flex: 1; }
.my-entry-title { font-size: 29rpx; font-weight: 600; color: #14233B; }
.my-entry-sub { margin-top: 4rpx; font-size: 23rpx; color: #8A99AC; }
.my-entry-caret { font-size: 34rpx; color: #C3CCD8; font-weight: 300; }
.row-hover { background: #F7F9FF; }

/* ---- 返回行 ---- */
.back-row {
  display: flex; align-items: center; gap: 8rpx;
  padding: 4rpx 8rpx 20rpx;
  font-size: 27rpx;
  color: #3B5BDB;
}
.back-arrow { font-size: 40rpx; line-height: 1; font-weight: 300; }

/* ---- 船队卡片 ---- */
.ship-card { padding: 24rpx 28rpx; }
.ship-card-head { display: flex; align-items: center; justify-content: space-between; }
.ship-card-name { font-size: 31rpx; font-weight: 600; color: #14233B; }
.ship-card-row {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  color: #6B7A8C;
}
.reject-reason {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #FA5252;
  background: rgba(250, 82, 82, .07);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}
.ship-card-actions { margin-top: 18rpx; display: flex; justify-content: flex-end; }
.btn-secondary {
  height: 62rpx; line-height: 62rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #3B5BDB;
  background: rgba(59, 91, 219, .09);
}
.add-ship-row { padding: 4rpx 0 24rpx; }
.btn-block { width: 100%; height: 88rpx; line-height: 88rpx; text-align: center; }

/* ---- 备案表单 ---- */
.form-tip { padding: 0 28rpx 20rpx; font-size: 23rpx; color: #A8B4C4; }
.submit-row { padding: 4rpx 0 24rpx; }
.submit-row .btn-primary { height: 88rpx; line-height: 88rpx; }

.empty-sub { margin-top: 8rpx; font-size: 23rpx; color: #B7C2D0; }
