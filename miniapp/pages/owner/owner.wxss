/* 船东工作台 */
.page { padding: 24rpx 32rpx; background: #f6f8fa; min-height: 100vh; box-sizing: border-box; }

.tabs { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.tab { padding: 16rpx 32rpx; background: #fff; border-radius: 999rpx; font-size: 26rpx; color: #6b7a8c; }
.tab-active { background: #0f7cff; color: #fff; font-weight: 600; }

.list { display: flex; flex-direction: column; gap: 20rpx; }
.empty { text-align: center; color: #98a6b8; padding: 80rpx 0; font-size: 26rpx; }

.card { background: #fff; border-radius: 20rpx; padding: 28rpx; box-shadow: 0 4rpx 24rpx rgba(15,37,64,.06); }
.card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.card-title { font-size: 30rpx; font-weight: 600; color: #0f2540; }
.badge { font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 999rpx; }
.badge-pending_verify { color: #9a6a00; background: #fff4d6; }
.badge-verified { color: #0a8f56; background: rgba(10,143,86,.1); }
.badge-rejected { color: #c0392b; background: rgba(192,57,43,.1); }
.card-row { display: flex; justify-content: space-between; font-size: 24rpx; color: #6b7a8c; margin-bottom: 6rpx; }
.reject-reason { margin-top: 12rpx; font-size: 22rpx; color: #c0392b; background: rgba(192,57,43,.06); padding: 12rpx 16rpx; border-radius: 10rpx; }

.form { background: #fff; border-radius: 20rpx; padding: 32rpx; box-shadow: 0 4rpx 24rpx rgba(15,37,64,.06); }
.field { margin-bottom: 28rpx; }
.field-row { display: flex; gap: 20rpx; }
.field-half { flex: 1; }
.label { display: block; font-size: 24rpx; color: #6b7a8c; margin-bottom: 10rpx; }
.input, .picker { background: #f6f8fa; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; color: #0f2540; }
.btn-submit { margin-top: 12rpx; }
.btn-primary { background: #0f7cff; color: #fff; font-size: 30rpx; border-radius: 16rpx; }
.btn-mini { border-radius: 10rpx; font-size: 24rpx; }
.card-actions { display: flex; gap: 16rpx; margin-top: 16rpx; justify-content: flex-end; }
