<!--
  首位屏（01）：身份选择浮窗
  不设主页——进入即选身份，点击直接进入专属工作台
-->
<view class="page">
  <!-- 背景：地图风格底图（纯 CSS 模拟，无外部资源） -->
  <view class="map-bg">
    <view class="map-blob blob-a"></view>
    <view class="map-blob blob-b"></view>
    <view class="map-blob blob-c"></view>
    <view class="map-line line-a"></view>
    <view class="map-line line-b"></view>
    <view class="map-road">G359</view>
  </view>

  <!-- 品牌区 -->
  <view class="hero">
    <view class="logo-row">
      <view class="logo-mark">⛵</view>
      <text class="logo-text">船好多</text>
    </view>
    <view class="logo-slogan">船好货多赚好多</view>
  </view>

  <!-- 身份选择浮窗 -->
  <view class="role-sheet">
    <view class="sheet-handle"></view>
    <view class="sheet-title">请选择您的身份</view>
    <view class="sheet-sub">选择后直接进入专属工作台</view>

    <view class="role-list">
      <view
        class="role-card {{pendingRole === 'shipper' ? 'role-card-pending' : ''}}"
        data-role="shipper"
        bindtap="onPickRole"
        hover-class="role-card-hover"
      >
        <view class="role-icon role-icon-shipper">📦</view>
        <view class="role-body">
          <view class="role-name">我是货主</view>
          <view class="role-desc">发货找船，查看推荐航线</view>
        </view>
        <view class="role-arrow">›</view>
      </view>

      <view
        class="role-card {{pendingRole === 'owner' ? 'role-card-pending' : ''}}"
        data-role="owner"
        bindtap="onPickRole"
        hover-class="role-card-hover"
      >
        <view class="role-icon role-icon-owner">🚢</view>
        <view class="role-body">
          <view class="role-name">我是船东</view>
          <view class="role-desc">寻找货源，发布空船</view>
        </view>
        <view class="role-arrow">›</view>
      </view>
    </view>

    <view class="sheet-foot" bindtap="onPickRole" data-role="port" hover-class="sheet-foot-hover">
      <text>我是港口方</text>
      <text class="sheet-foot-dot">·</text>
      <text class="sheet-foot-weak">后续可切换身份</text>
    </view>
  </view>

  <view wx:if="{{logging}}" class="loading-mask">
    <view class="loading-box">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在进入工作台…</text>
    </view>
  </view>
</view>
