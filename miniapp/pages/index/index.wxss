/* 首位屏（01）· 身份选择浮窗 */
page { background: #E7EFF4; }

.page {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ---- 品牌头图（设计稿导出：平陆运河航拍 + 品牌标识） ---- */
.brand-hero {
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
  display: block;
  background: #B9D3E6;
}

/* ---- 身份浮窗 ---- */
.role-sheet {
  position: relative;
  flex: 0 0 auto;
  background: #FFFFFF;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 20rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 40rpx rgba(61, 90, 219, .12);
  animation: sheet-up .28s ease-out;
}
@keyframes sheet-up {
  from { transform: translateY(60rpx); opacity: .4; }
  to { transform: translateY(0); opacity: 1; }
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #E3E9F2;
  margin: 0 auto 28rpx;
}
.sheet-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #14233B;
  text-align: center;
}
.sheet-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #93A1B3;
  text-align: center;
}
/* 后端未连接提示（预检失败才出现，可点重试） */
.sheet-warn {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: #FFF4F2;
  border: 2rpx solid #FFDCD4;
  color: #C0392B;
  font-size: 24rpx;
  text-align: center;
}

.role-list {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.role-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: #F7F9FD;
  border: 2rpx solid #EDF1F8;
}
.role-card-hover { background: #F0F4FC; }
.role-card-pending {
  border-color: #5C7CFA;
  background: rgba(92, 124, 250, .07);
}
.role-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 22rpx;
  font-size: 46rpx;
  line-height: 92rpx;
  text-align: center;
  flex-shrink: 0;
}
.role-icon-shipper {
  background: linear-gradient(135deg, #E8EEFF 0%, #DDE6FF 100%);
}
.role-icon-owner {
  background: linear-gradient(135deg, #F2EAFF 0%, #E8DDFF 100%);
}
.role-body { flex: 1; }
.role-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #14233B;
}
.role-desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #8A99AC;
}
.role-arrow {
  font-size: 40rpx;
  color: #C3CCD8;
  font-weight: 300;
}

/* ---- 加载遮罩 ---- */
.loading-mask {
  position: fixed;
  inset: 0;
  z-index: 99;
  background: rgba(20, 35, 59, .28);
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-box {
  background: rgba(20, 35, 59, .82);
  border-radius: 20rpx;
  padding: 36rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.loading-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid rgba(255, 255, 255, .3);
  border-top-color: #FFFFFF;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 24rpx; color: #FFFFFF; }
