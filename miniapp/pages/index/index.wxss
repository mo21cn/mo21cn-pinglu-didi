/* 首位屏（01）· 身份选择浮窗 */
page { background: #E7EFF4; }

.page {
  position: relative;
  min-height: 100vh;
  padding-bottom: 0;
  overflow: hidden;
}

/* ---- 背景地图（纯 CSS 模拟地形 + 水系） ---- */
.map-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #DCE9F0 0%, #E9F1F5 55%, #F2F6F8 100%);
}
.map-blob {
  position: absolute;
  border-radius: 44% 56% 62% 38% / 48% 42% 58% 52%;
}
.blob-a {
  width: 560rpx; height: 420rpx;
  left: -120rpx; top: 80rpx;
  background: rgba(174, 205, 172, .55);
}
.blob-b {
  width: 480rpx; height: 520rpx;
  right: -140rpx; top: 200rpx;
  background: rgba(186, 214, 226, .60);
}
.blob-c {
  width: 700rpx; height: 360rpx;
  left: 60rpx; top: 520rpx;
  background: rgba(196, 218, 190, .45);
}
.map-line {
  position: absolute;
  height: 3rpx;
  background: rgba(255, 255, 255, .85);
  border-radius: 3rpx;
}
.line-a { width: 620rpx; left: -60rpx; top: 340rpx; transform: rotate(-9deg); }
.line-b { width: 520rpx; right: -80rpx; top: 470rpx; transform: rotate(6deg); }
.map-road {
  position: absolute;
  left: 60rpx; top: 600rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: #E8B93B;
  padding: 0 10rpx;
  border-radius: 4rpx;
  letter-spacing: 1rpx;
}

/* ---- 品牌区 ---- */
.hero {
  position: relative;
  padding: calc(200rpx + env(safe-area-inset-top)) 60rpx 0;
}
.logo-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.logo-mark {
  width: 104rpx;
  height: 104rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #3B5BDB 0%, #7048E8 100%);
  color: #FFFFFF;
  font-size: 54rpx;
  line-height: 104rpx;
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(61, 90, 219, .28);
}
.logo-text {
  font-size: 68rpx;
  font-weight: 800;
  color: #14233B;
  letter-spacing: 6rpx;
}
.logo-slogan {
  margin-top: 18rpx;
  margin-left: 4rpx;
  font-size: 28rpx;
  color: #55677E;
  letter-spacing: 8rpx;
}

/* ---- 身份浮窗 ---- */
.role-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 20rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 40rpx rgba(61, 90, 219, .12);
  animation: sheet-up .28s ease-out;
}
@keyframes sheet-up {
  from { transform: translateY(60rpx); opacity: .4; }
  to { transform: translateY(0); opacity: 1; }
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #E3E9F2;
  margin: 0 auto 28rpx;
}
.sheet-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #14233B;
  text-align: center;
}
.sheet-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #93A1B3;
  text-align: center;
}

.role-list {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.role-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: #F7F9FD;
  border: 2rpx solid #EDF1F8;
}
.role-card-hover { background: #F0F4FC; }
.role-card-pending {
  border-color: #5C7CFA;
  background: rgba(92, 124, 250, .07);
}
.role-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 22rpx;
  font-size: 46rpx;
  line-height: 92rpx;
  text-align: center;
  flex-shrink: 0;
}
.role-icon-shipper {
  background: linear-gradient(135deg, #E8EEFF 0%, #DDE6FF 100%);
}
.role-icon-owner {
  background: linear-gradient(135deg, #F2EAFF 0%, #E8DDFF 100%);
}
.role-body { flex: 1; }
.role-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #14233B;
}
.role-desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #8A99AC;
}
.role-arrow {
  font-size: 40rpx;
  color: #C3CCD8;
  font-weight: 300;
}

.sheet-foot {
  margin-top: 36rpx;
  text-align: center;
  font-size: 25rpx;
  color: #6B7A8C;
}
.sheet-foot-hover { opacity: .6; }
.sheet-foot-dot { margin: 0 10rpx; color: #C3CCD8; }
.sheet-foot-weak { color: #A8B4C4; }

/* ---- 加载遮罩 ---- */
.loading-mask {
  position: fixed;
  inset: 0;
  z-index: 99;
  background: rgba(20, 35, 59, .28);
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-box {
  background: rgba(20, 35, 59, .82);
  border-radius: 20rpx;
  padding: 36rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.loading-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid rgba(255, 255, 255, .3);
  border-top-color: #FFFFFF;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 24rpx; color: #FFFFFF; }
