/* 首页：登录 / 三角色工作台 */
.page {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  background: #f6f8fa;
  box-sizing: border-box;
}

.header {
  margin-bottom: 48rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #0f2540;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6b7a8c;
}

/* ---- 登录卡片 ---- */
.login-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(15, 37, 64, 0.06);
}

.login-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #6b7a8c;
  margin-bottom: 48rpx;
  text-align: center;
}

.btn-primary {
  width: 100%;
  background: #0f7cff;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 16rpx;
}

/* ---- 用户卡片 ---- */
.user-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(15, 37, 64, 0.06);
}

.user-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #0f2540;
}

.user-role {
  font-size: 22rpx;
  color: #0f7cff;
  background: rgba(15, 124, 255, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.user-logout {
  font-size: 24rpx;
  color: #98a6b8;
}

/* ---- 角色卡片 ---- */
.section-title {
  margin: 40rpx 0 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f2540;
}

.role-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.role-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 24rpx rgba(15, 37, 64, 0.06);
}

.role-active {
  border-color: #0f7cff;
  background: #f5faff;
}

.role-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.role-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #0f2540;
}

.role-badge {
  font-size: 20rpx;
  color: #ffffff;
  background: #0f7cff;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.role-desc {
  font-size: 24rpx;
  color: #6b7a8c;
}

/* ---- 角色切换 ---- */
.switch-row {
  display: flex;
  gap: 20rpx;
}

.btn-switch {
  flex: 1;
  background: #ffffff;
  color: #0f2540;
  font-size: 26rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e3eaf2;
}

.btn-switch-active {
  background: #0f7cff;
  color: #ffffff;
  border-color: #0f7cff;
}
