/* 预约审核详情（L3 三级页）· 港域
   设计语言沿用 UI V2：蓝紫渐变 + 白卡 + 时间轴留痕 */

.page-sub {
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
}

/* ---- ① 预约头卡 ---- */
.appt-card {
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(59, 91, 219, 0.20);
}

.appt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.appt-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
}

.appt-chip {
  font-size: 20rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}

.appt-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.3;
  margin: 14rpx 0 6rpx;
}

.appt-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.appt-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.appt-dot {
  color: rgba(255, 255, 255, 0.40);
}

.appt-note {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.20);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.6;
}

/* ---- ③ 容量预检算式 ---- */
.calc {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 22rpx;
}

.calc-cell {
  flex: 1;
  text-align: center;
}

.calc-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #3B5BDB;
  line-height: 1.2;
}

.calc-cap {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #98A6B8;
}

.calc-op {
  width: 48rpx;
  text-align: center;
  font-size: 30rpx;
  color: #B7C2D0;
}

/* 非待确认态：用一句结论替代算式 */
.check-note {
  padding: 22rpx 28rpx 24rpx;
  font-size: 25rpx;
  color: #3D4C63;
  line-height: 1.7;
}

.warn-box {
  margin: 0 28rpx 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(250, 82, 82, 0.08);
  color: #C92A2A;
  font-size: 23rpx;
  line-height: 1.65;
}

.mono {
  font-family: monospace;
  font-size: 22rpx;
}
