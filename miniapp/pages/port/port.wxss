/* 港口工作台样式（v1 · 蓝紫渐变品牌头） */
.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.top-bar {
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #3B5BDB 0%, #7048E8 100%);
  color: #FFFFFF;
  border-radius: 0 0 24rpx 24rpx;
}
.top-bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.top-bar-logo {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, .2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.top-bar-title {
  font-size: 36rpx;
  font-weight: 700;
}
.top-bar-sub {
  font-size: 24rpx;
  opacity: .85;
  margin-left: 80rpx;
}

.dev-banner {
  margin: 24rpx 32rpx 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #FFF8E6, #FFEDC2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-left: 6rpx solid #F08C00;
}
.dev-banner-icon { font-size: 32rpx; }
.dev-banner-body { flex: 1; }
.dev-banner-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #B57600;
  margin-bottom: 4rpx;
}
.dev-banner-sub {
  font-size: 22rpx;
  color: #8B5A00;
  opacity: .85;
  line-height: 1.5;
}

.tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 24rpx 32rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(61, 91, 219, .06);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #6B7A8C;
}
.tab-active {
  color: #3B5BDB;
  font-weight: 600;
  border-bottom: 4rpx solid #3B5BDB;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 32rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 91, 219, .06);
}
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F2540;
}
.row {
  display: flex;
  font-size: 26rpx;
  color: #6B7A8C;
  padding: 6rpx 0;
}
.label {
  color: #98A6B8;
  width: 160rpx;
}
.badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.badge-pending { background: rgba(240, 140, 0, .10); color: #F08C00; }
.badge-ok { background: rgba(59, 91, 219, .10); color: #3B5BDB; }
.badge-off { background: #F5F7FA; color: #98A6B8; }
.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.btn { border-radius: 12rpx; font-size: 24rpx; }
.btn-primary {
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  color: #FFFFFF;
}
.btn-danger {
  background: #FFFFFF;
  color: #FA5252;
  border: 1rpx solid #FA5252;
}
.btn-block { width: 100%; margin-top: 24rpx; }

.form {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 32rpx;
}
.form-item { margin-bottom: 24rpx; }
.form-item .label {
  display: block;
  width: auto;
  font-size: 26rpx;
  color: #6B7A8C;
  margin-bottom: 8rpx;
}
.input {
  border: 1rpx solid #E5EAF2;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  background: #F8FAFF;
}
.picker {
  border: 1rpx solid #E5EAF2;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: #0F2540;
  background: #F8FAFF;
}
.form-tip {
  font-size: 22rpx;
  color: #98A6B8;
  margin-top: -8rpx;
  margin-bottom: 8rpx;
}

.empty {
  text-align: center;
  color: #98A6B8;
  padding: 120rpx 0;
  font-size: 26rpx;
}
.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
  opacity: .5;
}
