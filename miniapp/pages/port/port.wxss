/* 港口工作台样式（与货主/船东工作台一致） */
.page {
  padding: 24rpx;
  background: #f5f6f8;
  min-height: 100vh;
  box-sizing: border-box;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
}

.tab.active {
  color: #1890ff;
  font-weight: 600;
  border-bottom: 4rpx solid #1890ff;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.row {
  display: flex;
  font-size: 26rpx;
  color: #666;
  padding: 6rpx 0;
}

.label {
  color: #999;
  width: 160rpx;
}

.badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.badge-pending { background: #fff7e6; color: #fa8c16; }
.badge-ok { background: #e6f7ff; color: #1890ff; }
.badge-off { background: #f5f5f5; color: #999; }

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.btn { border-radius: 12rpx; }

.btn-primary { background: #1890ff; color: #fff; }

.btn-danger { background: #fff; color: #ff4d4f; border: 1rpx solid #ff4d4f; }

.btn-block { width: 100%; margin-top: 24rpx; }

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 26rpx;
}

/* 表单 */
.form {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item .label {
  display: block;
  width: auto;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.input {
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
}

.picker {
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.form-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: -8rpx;
}
