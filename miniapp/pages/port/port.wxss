/* 07 港口服务（底栏二级页） */
page { background: #EDF2F6; }

.page { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.hover-dim { opacity: .6; }

/* ---- 地图头（纯 CSS 示意） ---- */
.map-head {
  position: relative;
  height: 420rpx;
  background: linear-gradient(180deg, #E4EEF4 0%, #EFF5F8 100%);
  overflow: hidden;
}
.m-water {
  position: absolute;
  left: -60rpx;
  top: 40rpx;
  width: 620rpx;
  height: 320rpx;
  background: rgba(178, 211, 230, .75);
  border-radius: 46% 54% 60% 40% / 54% 46% 54% 46%;
}
.m-green {
  position: absolute;
  background: rgba(178, 208, 172, .65);
  border-radius: 52% 48% 44% 56% / 46% 56% 44% 54%;
}
.mg1 { width: 420rpx; height: 300rpx; right: -80rpx; top: -40rpx; }
.mg2 { width: 460rpx; height: 260rpx; left: 40rpx; bottom: -60rpx; }
.m-road {
  position: absolute;
  right: 40rpx;
  bottom: 120rpx;
  font-size: 18rpx;
  color: #FFFFFF;
  background: #E8B93B;
  padding: 0 8rpx;
  border-radius: 4rpx;
}
.m-anchor {
  position: absolute;
  left: 50%;
  top: 46%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.anchor-pin {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  color: #FFFFFF;
  font-size: 34rpx;
  line-height: 72rpx;
  text-align: center;
  box-shadow: 0 6rpx 18rpx rgba(61, 90, 219, .32);
}
.anchor-label {
  font-size: 24rpx;
  color: #14233B;
  font-weight: 600;
  background: rgba(255, 255, 255, .88);
  border-radius: 999rpx;
  padding: 2rpx 18rpx;
}
.map-tip {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  font-size: 22rpx;
  color: #55677E;
  background: rgba(255, 255, 255, .9);
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}
.map-locate {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #FFFFFF;
  color: #3B5BDB;
  font-size: 36rpx;
  line-height: 76rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(61, 90, 219, .18);
}

/* ---- 服务面板 ---- */
.sheet {
  position: relative;
  margin-top: -32rpx;
  background: #FFFFFF;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 18rpx 24rpx 40rpx;
  min-height: 400rpx;
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #E3E9F2;
  margin: 0 auto 18rpx;
}

.group { padding: 18rpx 4rpx 10rpx; }
.group-head { display: flex; align-items: center; gap: 14rpx; }
.group-title { font-size: 32rpx; font-weight: 700; color: #14233B; }
.group-tag {
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}
.tag-preview { color: #7048E8; background: rgba(112, 72, 232, .10); }
.tag-soon { color: #98A6B8; background: #F1F4F8; }
.group-caret { margin-left: auto; font-size: 24rpx; color: #C3CCD8; }
.group-tip { padding: 6rpx 0 4rpx; font-size: 23rpx; color: #A8B4C4; }

.grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.grid-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
}
.grid-item-hover { background: #F5F8FF; }
.grid-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: #F2F5FD;
  font-size: 38rpx;
  line-height: 84rpx;
  text-align: center;
}
.grid-icon-real {
  background: linear-gradient(135deg, #E8EEFF 0%, #EDE4FF 100%);
}
.grid-label { font-size: 23rpx; color: #3D4C63; }

.sheet-foot {
  padding: 32rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #A8B4C4;
}

/* ---- 平台运营台 ---- */
.ops-head {
  background: linear-gradient(180deg, #E6EDFF 0%, #F2F6FF 100%);
  padding: 24rpx 28rpx 28rpx;
}
.ops-back { font-size: 26rpx; color: #3B5BDB; }
.ops-title { margin-top: 16rpx; font-size: 40rpx; font-weight: 700; color: #14233B; }
.ops-sub { margin-top: 6rpx; font-size: 24rpx; color: #7C8CA0; }

.tabs {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 24rpx 8rpx;
}
.tab {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6B7A8C;
  background: #FFFFFF;
}
.tab-active {
  color: #FFFFFF;
  font-weight: 600;
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  box-shadow: 0 4rpx 14rpx rgba(80, 78, 220, .26);
}

.ops-card {
  margin: 20rpx 24rpx 0;
  padding: 24rpx 28rpx;
}
.ops-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.ops-card-title { font-size: 29rpx; font-weight: 600; color: #14233B; }
.ops-row {
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  color: #3D4C63;
  padding: 6rpx 0;
}
.ops-label { color: #8A99AC; }
.ops-link {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #3B5BDB;
}
/* 运营台内的筛选条：与 tab 行贴合，去掉共享 filter-bar 的默认左右内边距 */
.ops-filter {
  padding: 0 24rpx 16rpx;
}
.ops-actions {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F1F4F8;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
.ops-btn {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
}
.ops-btn-primary {
  color: #FFFFFF;
  font-weight: 600;
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
}
.ops-btn-danger {
  color: #FA5252;
  background: rgba(250, 82, 82, .09);
  border: 1rpx solid rgba(250, 82, 82, .22);
}
.ops-btn-block { margin: 24rpx 0 0; text-align: center; }

.ops-form-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #F1F4F8;
}
.ops-form-item:last-of-type { border-bottom: none; }
.ops-form-item .ops-label { width: 220rpx; flex-shrink: 0; font-size: 27rpx; }
.picker-value { flex: 1; text-align: right; font-size: 27rpx; color: #14233B; }
.ops-form-tip { padding: 16rpx 0 0; font-size: 22rpx; color: #A8B4C4; }
