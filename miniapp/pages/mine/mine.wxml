<!--
  08 我的（底栏二级页）
  用户卡 + 会员卡 + 资产行 + 常用功能网格（多数为原型占位）
  底部保留：切换身份 / 退出登录（已开发能力出口）
-->
<view class="page">
  <view class="head-bg">
    <view class="nav" style="padding-top: {{statusBarHeight}}px">
      <view class="nav-inner">
        <text class="nav-title">我的</text>
        <view class="nav-preview" bindtap="onPreviewTip" hover-class="hover-dim">功能预览</view>
      </view>
    </view>

    <!-- 用户卡 -->
    <view class="user-card" bindtap="onEditProfile" hover-class="hover-dim">
      <view class="avatar">{{userInitials}}</view>
      <view class="user-body">
        <view class="user-name">{{userName}}</view>
        <view class="user-phone">📱 {{phoneText}}</view>
        <view class="user-tags">
          <text class="tag-warn">未实名</text>
          <text class="tag-plain">人气值：0</text>
        </view>
      </view>
      <view class="user-right">
        <view class="bell" catchtap="onBell" hover-class="hover-dim">
          <text class="bell-icon">🔔</text>
          <view class="bell-red"></view>
        </view>
        <text class="user-caret">›</text>
      </view>
    </view>
  </view>

  <view class="page-content">
    <!-- 会员卡 -->
    <view class="vip-card">
      <view class="vip-left">
        <view class="vip-title">邀您升级会员</view>
        <view class="vip-sub">解锁更多会员权益</view>
      </view>
      <view class="vip-right">
        <view class="vip-btn" catchtap="onUpgrade" hover-class="vip-btn-hover">去升级</view>
        <view class="vip-tag">即将开放</view>
      </view>
    </view>

    <!-- 委托发货入口（ENT-012 / AC-02 入口隔离）
         整块由服务端静默探测结果驱动：无权限时这里什么都不渲染，
         而不是给一个点进去必然 403 的按钮。 -->
    <view
      wx:if="{{showEntrust}}"
      class="section-card entrust-entry"
      bindtap="onEntrust"
      hover-class="row-hover"
    >
      <view class="row-between">
        <view class="entrust-entry-main">
          <view class="entrust-entry-title">📋 委托发货</view>
          <view class="entrust-entry-sub">受理货主委托 · 派发任务 · 查看成果</view>
        </view>
        <text class="entrust-entry-caret">›</text>
      </view>
      <view wx:if="{{entrustHint}}" class="entrust-entry-hint">{{entrustHint}}</view>
    </view>

    <!-- 「我的委托」入口（S1 工作项 5）——**货主侧**，与上面那块经理入口并列，
         但由**另一个**服务端探测驱动（`showMineEntrust` ← `view=owner`）。
         为什么不是同一块：两块回答的问题不同（"我能受理委托吗" vs
         "我提的单现在怎么样了"），一个货主账号通常只满足后者。 -->
    <view
      wx:if="{{showMineEntrust}}"
      class="section-card entrust-entry"
      data-act-mine-entrust="1"
      bindtap="onMineEntrust"
      hover-class="row-hover"
    >
      <view class="row-between">
        <view class="entrust-entry-main">
          <view class="entrust-entry-title">📦 我的委托</view>
          <view class="entrust-entry-sub">提交的委托 · 真实状态与承接组织</view>
        </view>
        <text class="entrust-entry-caret">›</text>
      </view>
    </view>

    <!-- 资产行 -->
    <view class="section-card assets">
      <view class="asset-cell" data-key="balance" bindtap="onAssetTap" hover-class="row-hover">
        <view class="asset-num">0.00</view>
        <view class="asset-label">账户余额 ›</view>
      </view>
      <view class="asset-line"></view>
      <view class="asset-cell" data-key="fuel" bindtap="onAssetTap" hover-class="row-hover">
        <view class="asset-num">0.00</view>
        <view class="asset-label">优惠油电 ›</view>
      </view>
      <view class="asset-line"></view>
      <view class="asset-cell" data-key="bank" bindtap="onAssetTap" hover-class="row-hover">
        <view class="asset-num asset-num-weak">未维护</view>
        <view class="asset-label">银行卡 ›</view>
      </view>
    </view>

    <!-- 常用功能 -->
    <view class="section-card">
      <view class="section-head">
        <text class="section-head-title">常用功能</text>
      </view>
      <view class="fn-grid">
        <view
          wx:for="{{functions}}"
          wx:key="key"
          class="fn-item {{item.warn ? 'fn-item-warn' : ''}}"
          data-key="{{item.key}}"
          bindtap="onFunction"
          hover-class="row-hover"
        >
          <view class="fn-icon">
            {{item.icon}}
            <view wx:if="{{item.badge}}" class="fn-badge">{{item.badge}}</view>
          </view>
          <view class="fn-label {{item.warn ? 'fn-label-warn' : ''}}">{{item.label}}</view>
        </view>
      </view>
      <view class="fn-foot">除「退出」外，以上功能为原型占位，后续开放</view>
    </view>

    <!-- 账号（已开发能力出口） -->
    <view class="section-card">
      <view class="section-head">
        <text class="section-head-title">账号</text>
        <text class="section-head-more">当前身份：{{roleLabel}}</text>
      </view>
      <view class="role-switch-row">
        <view
          wx:for="{{roleList}}"
          wx:key="key"
          class="role-chip {{currentRole === item.key ? 'role-chip-active' : ''}}"
          data-role="{{item.key}}"
          bindtap="onSwitchRole"
          hover-class="row-hover"
        >
          <text class="role-chip-icon">{{item.icon}}</text>
          <text class="role-chip-label">{{item.label}}</text>
        </view>
      </view>
      <view class="logout-row">
        <view class="logout-btn" bindtap="onLogout" hover-class="hover-dim">退出登录</view>
      </view>
    </view>

    <view class="version">v0.5.1 · UI V2 · 2026.09</view>
  </view>
</view>
