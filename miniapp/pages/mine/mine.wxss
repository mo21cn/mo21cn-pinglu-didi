/* 我的工作台（v1 · 占位骨架） */
.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.user-banner {
  position: relative;
  padding: 60rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #3B5BDB 0%, #5C3AEC 50%, #7048E8 100%);
  color: #FFFFFF;
  overflow: hidden;
  border-radius: 0 0 32rpx 32rpx;
}
.banner-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}
.banner-bg::before,
.banner-bg::after {
  content: '';
  position: absolute;
  border-radius: 50%;
}
.banner-bg::before {
  width: 280rpx;
  height: 280rpx;
  background: rgba(255, 255, 255, .10);
  top: -100rpx;
  right: -80rpx;
}
.banner-bg::after {
  width: 180rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, .08);
  bottom: -60rpx;
  left: 30%;
}
.banner-content {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  background: rgba(255, 255, 255, .25);
  border: 4rpx solid rgba(255, 255, 255, .35);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
}
.user-info {
  flex: 1;
  min-width: 0;
}
.user-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-role-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: rgba(255, 255, 255, .25);
  border: 1rpx solid rgba(255, 255, 255, .35);
  border-radius: 999rpx;
  font-size: 22rpx;
}
.user-edit {
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, .18);
  border: 1rpx solid rgba(255, 255, 255, .35);
  border-radius: 999rpx;
  font-size: 22rpx;
}
.user-edit-hover { background: rgba(255, 255, 255, .28); }

.stats-row {
  position: relative;
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  background: rgba(255, 255, 255, .15);
  border: 1rpx solid rgba(255, 255, 255, .25);
  border-radius: 20rpx;
}
.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-num {
  font-size: 36rpx;
  font-weight: 700;
}
.stat-label {
  font-size: 22rpx;
  opacity: .85;
}
.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, .25);
}

.dev-banner {
  margin: 24rpx 32rpx 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #FFF8E6, #FFEDC2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-left: 6rpx solid #F08C00;
}
.dev-banner-icon { font-size: 32rpx; }
.dev-banner-body { flex: 1; }
.dev-banner-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #B57600;
  margin-bottom: 4rpx;
}
.dev-banner-sub {
  font-size: 22rpx;
  color: #8B5A00;
  opacity: .85;
  line-height: 1.5;
}

.section-card {
  margin: 24rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 91, 219, .06);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F2540;
  margin-bottom: 16rpx;
}

.role-switch-row {
  display: flex;
  gap: 12rpx;
}
.role-chip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 0;
  background: #F5F7FA;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}
.role-chip-hover { background: #EDF1FF; }
.role-chip-active {
  background: linear-gradient(135deg, #EDF1FF, #F0E7FF);
  border-color: #3B5BDB;
}
.role-chip-icon { font-size: 36rpx; }
.role-chip-label {
  font-size: 24rpx;
  color: #0F2540;
}
.role-chip-active .role-chip-label {
  color: #3B5BDB;
  font-weight: 600;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 8rpx;
  background: #F8FAFF;
  border-radius: 16rpx;
  position: relative;
}
.entry-hover { background: #EDF1FF; }
.entry-dev { opacity: .6; }
.entry-icon { font-size: 40rpx; }
.entry-label {
  font-size: 22rpx;
  color: #0F2540;
}
.entry-tag {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  padding: 2rpx 8rpx;
  background: #FA5252;
  color: #FFFFFF;
  font-size: 18rpx;
  border-radius: 999rpx;
}

.logout-row {
  padding: 32rpx 32rpx 0;
}
.logout-btn {
  width: 100%;
  padding: 24rpx 0;
  text-align: center;
  background: #FFFFFF;
  color: #FA5252;
  font-size: 28rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(250, 82, 82, .25);
}
.logout-btn-hover { background: rgba(250, 82, 82, .06); }

.bottom-version {
  text-align: center;
  font-size: 20rpx;
  color: #98A6B8;
  margin-top: 24rpx;
}
