/* 06 我的订单（底栏二级页） */
page { background: #F5F7FA; }

/* ---- 自定义导航栏 ---- */
.nav {
  background: #FFFFFF;
  position: relative;
}
.nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.nav-title { font-size: 34rpx; font-weight: 600; color: #14233B; }
.nav-bell {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 34rpx;
}
.nav-bell-red {
  position: absolute;
  right: 24rpx;
  top: 14rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FA5252;
}

/* ---- 统计行 ---- */
.stat-row {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 8rpx 12rpx 28rpx;
  border-bottom-left-radius: 28rpx;
  border-bottom-right-radius: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(61, 90, 219, .06);
}
.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 0;
  border-radius: 16rpx;
}
.stat-cell-hover { background: #F5F8FF; }
.stat-cell-active { background: rgba(59, 91, 219, .08); }
.stat-num { font-size: 36rpx; font-weight: 700; color: #14233B; }
.stat-cell-active .stat-num { color: #3B5BDB; }
.stat-label { font-size: 22rpx; color: #8A99AC; }
.stat-cell-active .stat-label { color: #3B5BDB; }

.page-content { padding: 24rpx 24rpx 0; }

/* ---- 待处理事项 ---- */
.todo-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F1F4F8;
}
.todo-row:last-child { border-bottom: none; }
.row-hover { background: #F7F9FF; }
.todo-ico {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(59, 91, 219, .08);
  font-size: 28rpx;
  line-height: 60rpx;
  text-align: center;
  flex-shrink: 0;
}
.todo-title { flex: 1; font-size: 28rpx; color: #14233B; }
.todo-count { font-size: 26rpx; color: #3B5BDB; font-weight: 600; }
.todo-caret { font-size: 32rpx; color: #C3CCD8; font-weight: 300; }

/* ---- 订单卡 ---- */
.order-list { padding: 4rpx 24rpx 24rpx; }
.order-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid #EEF2F9;
  box-shadow: 0 2rpx 14rpx rgba(61, 90, 219, .06);
  margin-bottom: 20rpx;
}
.order-card:last-child { margin-bottom: 0; }
.order-head { display: flex; align-items: center; }
.order-route { flex: 1; display: flex; align-items: center; gap: 12rpx; }
.or-name { font-size: 32rpx; font-weight: 700; color: #14233B; }
.or-arrow {
  font-size: 22rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  border-radius: 999rpx;
  padding: 0 14rpx;
  line-height: 32rpx;
}
.order-mid { margin-top: 16rpx; display: flex; align-items: center; gap: 8rpx; }
.order-cargo { font-size: 28rpx; color: #3D4C63; }
.order-sep { color: #C3CCD8; }
.order-weight { font-size: 28rpx; color: #3D4C63; font-weight: 600; }
.order-sub {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #8A99AC;
}
.order-price { color: #7048E8; font-weight: 600; }

.order-actions {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F1F4F8;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
.act-ghost, .act-primary {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
}
.act-ghost {
  color: #3B5BDB;
  background: rgba(59, 91, 219, .09);
  border: 1rpx solid rgba(59, 91, 219, .22);
}
.act-primary {
  color: #FFFFFF;
  font-weight: 600;
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  box-shadow: 0 4rpx 14rpx rgba(80, 78, 220, .28);
}

/* ---- 合同弹层 ---- */
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(20, 35, 59, .45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.modal {
  width: 100%;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
}
.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.modal-title { font-size: 30rpx; font-weight: 600; color: #14233B; }
.modal-close { font-size: 32rpx; color: #98A6B8; padding: 0 8rpx; }
.risk-box {
  background: rgba(240, 140, 0, .07);
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
}
.risk-title { font-size: 25rpx; color: #F08C00; font-weight: 600; margin-bottom: 10rpx; }
.risk-item { display: flex; gap: 10rpx; font-size: 23rpx; color: #6B7A8C; margin-top: 8rpx; }
.risk-sev {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  color: #FFFFFF;
}
.risk-sev-high { background: #FA5252; }
.risk-sev-medium { background: #F08C00; }
.risk-sev-low { background: #12B886; }
.risk-text { flex: 1; }
.contract-scroll { max-height: 46vh; }
.contract-text { font-size: 24rpx; color: #3D4C63; line-height: 1.8; white-space: pre-wrap; }
.modal-foot { padding-top: 18rpx; text-align: center; }
.modal-note { font-size: 21rpx; color: #A8B4C4; }
