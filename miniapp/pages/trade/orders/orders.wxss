/* 订单二级页（v1） */
.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.user-banner {
  padding: 32rpx;
  background: linear-gradient(135deg, #3B5BDB 0%, #7048E8 100%);
  color: #FFFFFF;
}
.banner-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.banner-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.banner-avatar {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, .25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}
.banner-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.banner-greeting {
  font-size: 30rpx;
  font-weight: 600;
}
.banner-sub {
  font-size: 22rpx;
  opacity: .85;
}
.banner-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, .18);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .25);
}
.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}
.stat-label {
  font-size: 20rpx;
  opacity: .85;
}

.status-tabs {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 32rpx;
  background: #FFFFFF;
  overflow-x: auto;
  white-space: nowrap;
  box-shadow: 0 2rpx 12rpx rgba(61, 91, 219, .06);
}
.status-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  background: #F5F7FA;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6B7A8C;
  flex-shrink: 0;
}
.status-tab-hover { background: #EDF1FF; }
.status-tab-active {
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  color: #FFFFFF;
  font-weight: 600;
}
.status-tab-count {
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  background: #FA5252;
  color: #FFFFFF;
  font-size: 18rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}
.status-tab-active .status-tab-count {
  background: rgba(255, 255, 255, .3);
}

.todo-section {
  padding: 24rpx 32rpx 0;
}
.todo-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F2540;
  margin-bottom: 16rpx;
}
.todo-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.todo-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 91, 219, .06);
}
.todo-card-hover { background: #F8FAFF; }
.todo-urgent {
  border-left: 6rpx solid #FA5252;
}
.todo-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #E7ECFF, #F0E7FF);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
.todo-body {
  flex: 1;
  min-width: 0;
}
.todo-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F2540;
  margin-bottom: 4rpx;
}
.todo-item-sub {
  font-size: 22rpx;
  color: #6B7A8C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.todo-arrow {
  font-size: 32rpx;
  color: #98A6B8;
  line-height: 1;
}

.order-list {
  padding: 24rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 91, 219, .08);
}
.order-card-hover { background: #F8FAFF; }
.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.order-id {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F2540;
}

.order-route {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  background: #F8FAFF;
  border-radius: 12rpx;
}
.route-stop {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}
.route-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.route-dot-blue { background: #3B5BDB; }
.route-dot-purple { background: #7048E8; }
.route-name {
  font-size: 26rpx;
  color: #0F2540;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.route-arrow {
  color: #98A6B8;
  font-size: 24rpx;
  flex-shrink: 0;
}

.order-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.meta-row {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.meta-label {
  font-size: 22rpx;
  color: #98A6B8;
}
.meta-value {
  font-size: 26rpx;
  color: #0F2540;
  font-weight: 500;
}
.meta-price {
  color: #FA5252;
  font-weight: 700;
  font-size: 30rpx;
}

.order-actions {
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid #F1F4F8;
  flex-wrap: wrap;
}

.action-btn-ghost {
  padding: 12rpx 24rpx;
  background: #F1F4F8;
  color: #6B7A8C;
  font-size: 24rpx;
  border-radius: 999rpx;
}
.action-btn-primary {
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(61, 91, 219, .25);
}
.action-btn-contract {
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  color: #F08C00;
  font-size: 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid #F0D89C;
}

.empty-state {
  text-align: center;
  color: #98A6B8;
  padding: 120rpx 0;
  font-size: 26rpx;
}
.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
  opacity: .5;
}

.content-bottom-space { height: 40rpx; }

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(10, 20, 35, .55);
  z-index: 99;
  display: flex;
  align-items: flex-end;
}
.modal {
  width: 100%;
  max-height: 88vh;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F2540;
}
.modal-close {
  font-size: 34rpx;
  color: #98A6B8;
  padding: 8rpx;
}
.risk-box {
  background: #FFF8E6;
  border-radius: 14rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
}
.risk-title {
  font-size: 24rpx;
  color: #F08C00;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.risk-item {
  display: flex;
  gap: 10rpx;
  margin-bottom: 8rpx;
  align-items: flex-start;
}
.risk-sev {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-top: 4rpx;
}
.risk-sev-high { color: #FA5252; background: rgba(250, 82, 82, .12); }
.risk-sev-medium { color: #F08C00; background: rgba(240, 140, 0, .12); }
.risk-sev-low { color: #12B886; background: rgba(18, 184, 134, .12); }
.risk-text {
  font-size: 24rpx;
  color: #5B4A1E;
  line-height: 1.5;
  flex: 1;
}
.contract-scroll {
  flex: 1;
  max-height: 52vh;
  background: #F6F8FA;
  border-radius: 14rpx;
  padding: 20rpx;
  box-sizing: border-box;
}
.contract-text {
  font-size: 24rpx;
  color: #0F2540;
  line-height: 1.7;
  white-space: pre-wrap;
}
.modal-foot {
  margin-top: 16rpx;
  text-align: center;
}
.modal-note {
  font-size: 20rpx;
  color: #98A6B8;
}
