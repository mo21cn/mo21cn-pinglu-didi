<!-- 订单列表页：角色视角 + 交易操作 -->
<view class="page">
  <view class="filters">
    <view
      wx:for="{{statusFilter}}"
      wx:key="key"
      class="filter {{activeStatus === item.key ? 'filter-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchStatus"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{list.length === 0}}" class="empty">暂无订单</view>

  <view class="list">
    <view wx:for="{{list}}" wx:key="id" class="card">
      <view class="card-head">
        <text class="card-title">订单 #{{item.id}}</text>
        <text class="badge badge-{{item.status}}">{{statusLabels[item.status]}}</text>
      </view>
      <view class="card-row">
        <text>货源 #{{item.cargo_id}} · 船舶 #{{item.ship_id}}</text>
        <text wx:if="{{item.freight_price}}">¥ {{item.freight_price}}</text>
        <text wx:else>面议</text>
      </view>
      <view class="card-row">
        <text>成交：{{item.matched_at}}</text>
      </view>

      <!-- 货主操作 -->
      <view wx:if="{{role === 'shipper' && item.status === 'matched'}}" class="card-actions">
        <button class="btn-mini btn-ghost" size="mini" data-id="{{item.id}}" bindtap="onCancel">撤单</button>
        <button class="btn-mini btn-primary" size="mini" data-id="{{item.id}}" bindtap="onPay">支付运费</button>
      </view>
      <view wx:if="{{role === 'shipper' && item.status === 'shipped'}}" class="card-actions">
        <button class="btn-mini btn-primary" size="mini" data-id="{{item.id}}" bindtap="onComplete">确认签收</button>
      </view>

      <!-- 船东操作 -->
      <view wx:if="{{role === 'owner' && item.status === 'matched'}}" class="card-actions">
        <button class="btn-mini btn-ghost" size="mini" data-id="{{item.id}}" bindtap="onCancel">撤单</button>
        <button class="btn-mini btn-primary" size="mini" data-id="{{item.id}}" bindtap="onShip">确认启运</button>
      </view>

      <!-- 双方：智能合同（草稿生成 + 风险提示，不具法律效力） -->
      <view wx:if="{{item.status === 'matched' || item.status === 'shipped'}}" class="card-actions">
        <button class="btn-mini btn-contract" size="mini" data-id="{{item.id}}" bindtap="onContract">生成合同</button>
      </view>
    </view>
  </view>

  <!-- 合同预览弹层 -->
  <view wx:if="{{contract.show}}" class="modal-mask" bindtap="closeContract">
    <view class="modal" catchtap="">
      <view class="modal-head">
        <text class="modal-title">运输合同草稿 · 订单 #{{contract.orderId}}</text>
        <text class="modal-close" bindtap="closeContract">✕</text>
      </view>

      <view wx:if="{{contract.risks.length}}" class="risk-box">
        <view class="risk-title">⚠️ 风险提示（{{contract.risks.length}}）</view>
        <view wx:for="{{contract.risks}}" wx:key="title" class="risk-item">
          <text class="risk-sev risk-sev-{{item.severity}}">{{item.severity === 'high' ? '高' : item.severity === 'medium' ? '中' : '低'}}</text>
          <text class="risk-text">{{item.title}}：{{item.detail}}</text>
        </view>
      </view>

      <scroll-view scroll-y class="contract-scroll">
        <text class="contract-text" user-select>{{contract.text}}</text>
      </scroll-view>
      <view class="modal-foot">
        <text class="modal-note">草稿不具法律效力，签署前请人工审核</text>
      </view>
    </view>
  </view>
</view>
