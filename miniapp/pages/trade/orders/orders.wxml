<!--
  06 我的订单（底栏二级页）
  统计行（全部/待承运/运输中/已完成/已撤单）→ 待处理事项 → 最近订单
-->
<view class="page">
  <!-- 统计行 -->
  <view class="stat-row">
    <view
      wx:for="{{stats}}"
      wx:key="key"
      class="stat-cell {{activeKey === item.key ? 'stat-cell-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchStat"
      hover-class="stat-cell-hover"
    >
      <view class="stat-num">{{item.count}}</view>
      <view class="stat-label">{{item.label}}</view>
    </view>
  </view>

  <view class="page-content">
    <!-- 待处理事项 -->
    <view wx:if="{{todoList.length}}" class="section-card">
      <view class="section-head">
        <text class="section-head-title">待处理事项</text>
      </view>
      <view
        wx:for="{{todoList}}"
        wx:key="key"
        class="todo-row"
        data-key="{{item.key}}"
        bindtap="onTodoTap"
        hover-class="row-hover"
      >
        <view class="todo-ico">{{item.icon}}</view>
        <view class="todo-title">{{item.title}}</view>
        <view class="todo-count">{{item.count}} 笔</view>
        <text class="todo-caret">›</text>
      </view>
    </view>

    <!-- 订单列表 -->
    <view class="section-card">
      <view class="section-head">
        <text class="section-head-title">{{activeKey ? activeLabel + '订单' : '最近订单'}}</text>
        <text class="section-head-more" bindtap="resetFilter">查看全部 ›</text>
      </view>

      <view wx:if="{{list.length}}" class="list-hint">「查看合同」进入合同页 · 长按订单卡快速预览</view>

      <view wx:if="{{loading && list.length === 0}}" class="empty">加载中...</view>
      <view wx:elif="{{list.length === 0}}" class="empty">
        <view class="empty-icon">📋</view>
        <view>暂无{{activeLabel}}订单</view>
      </view>

      <view wx:else class="order-list">
        <view
          wx:for="{{list}}"
          wx:key="id"
          class="order-card"
          hover-class="row-hover"
          data-id="{{item.id}}"
          bindlongpress="onPreviewContract"
        >
          <view class="order-head">
            <view class="order-route">
              <text class="or-name">{{item.origin_label}}</text>
              <text class="or-arrow">→</text>
              <text class="or-name">{{item.dest_label}}</text>
            </view>
            <text class="badge badge-{{item.status}}">{{statusLabels[item.status]}}</text>
          </view>

          <view class="order-mid">
            <text class="order-cargo">{{item.cargo_name}}</text>
            <text class="order-sep">·</text>
            <text class="order-weight">{{item.weight_text}}</text>
          </view>

          <view class="order-sub">
            <text>{{item.date_text}}</text>
            <text class="order-price">{{item.freight_price ? '¥ ' + item.freight_price : '运费面议'}}</text>
          </view>

          <view class="order-actions">
            <view
              wx:if="{{item.status === 'matched' || item.status === 'shipped'}}"
              class="act-ghost"
              data-id="{{item.id}}"
              catchtap="onContractPage"
            >查看合同</view>

            <block wx:if="{{role === 'shipper'}}">
              <view wx:if="{{item.status === 'matched'}}" class="act-ghost" data-id="{{item.id}}" catchtap="onCancel">撤单</view>
              <view wx:if="{{item.status === 'matched'}}" class="act-primary" data-id="{{item.id}}" catchtap="onPay">去支付</view>
              <view wx:if="{{item.status === 'shipped'}}" class="act-primary" data-id="{{item.id}}" catchtap="onComplete">确认收货</view>
              <view wx:if="{{item.status === 'completed' || item.status === 'cancelled'}}" class="act-ghost" data-id="{{item.id}}" catchtap="onDetail">查看详情</view>
            </block>

            <block wx:if="{{role === 'owner'}}">
              <view wx:if="{{item.status === 'matched'}}" class="act-ghost" data-id="{{item.id}}" catchtap="onCancel">撤单</view>
              <view wx:if="{{item.status === 'matched'}}" class="act-primary" data-id="{{item.id}}" catchtap="onShip">确认启运</view>
              <view wx:if="{{item.status !== 'matched'}}" class="act-ghost" data-id="{{item.id}}" catchtap="onDetail">查看详情</view>
            </block>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 合同弹层（F11 智能合同 Agent） -->
  <view wx:if="{{contract.show}}" class="modal-mask" bindtap="closeContract">
    <view class="modal" catchtap="">
      <view class="modal-head">
        <text class="modal-title">运输合同草稿 · 订单 #{{contract.orderId}}</text>
        <text class="modal-close" bindtap="closeContract">✕</text>
      </view>

      <view wx:if="{{contract.risks.length}}" class="risk-box">
        <view class="risk-title">⚠️ 风险提示（{{contract.risks.length}}）</view>
        <view wx:for="{{contract.risks}}" wx:key="title" class="risk-item">
          <text class="risk-sev risk-sev-{{item.severity}}">{{item.severity === 'high' ? '高' : item.severity === 'medium' ? '中' : '低'}}</text>
          <text class="risk-text">{{item.title}}：{{item.detail}}</text>
        </view>
      </view>

      <scroll-view scroll-y class="contract-scroll">
        <text class="contract-text" user-select>{{contract.text}}</text>
      </scroll-view>
      <view class="modal-foot">
        <text class="modal-note">草稿不具法律效力，签署前请人工审核</text>
      </view>
    </view>
  </view>
</view>
