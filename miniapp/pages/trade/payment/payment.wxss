/* 支付详情（L3 三级页）· 支付域
   设计语言沿用 UI V2：蓝紫渐变 + 白卡 + 时间轴留痕 */

/* 底部固定条含"提示行 + 按钮行"，留白加大 */
.page-sub {
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
}

/* ---- ① 金额头卡 ---- */
.amount-card {
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(59, 91, 219, 0.20);
}

.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.amount-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
}

.amount-chip {
  font-size: 20rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}

.amount-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
  margin: 14rpx 0 10rpx;
  letter-spacing: 1rpx;
}

.amount-cny {
  font-size: 34rpx;
  font-weight: 500;
  margin-right: 6rpx;
}

.amount-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.amount-dot {
  color: rgba(255, 255, 255, 0.40);
}

.amount-note {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.20);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.6;
}

/* ---- ② 尚无支付单 ---- */
.nocp-body {
  padding: 8rpx 28rpx 28rpx;
}

.nocp-text {
  font-size: 26rpx;
  color: #3D4C63;
  line-height: 1.7;
}

.nocp-hint {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #F08C00;
  background: rgba(240, 140, 0, 0.08);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  line-height: 1.6;
}

/* 流水号等长串右对齐时允许折行 */
.mono {
  font-size: 23rpx;
  color: #3D4C63;
  word-break: break-all;
}

/* ---- 底部固定操作条（提示行 + 按钮行） ---- */
.pay-bar {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}
