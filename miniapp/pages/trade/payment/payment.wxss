/* 支付详情（L3 三级页）· 支付域
   设计语言沿用 UI V2：蓝紫渐变 + 白卡 + 时间轴留痕 */

/* 底部固定条含"提示行 + 按钮行"，留白加大 */
.page-sub {
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
}

/* ---- ① 金额头卡 ---- */
.amount-card {
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(59, 91, 219, 0.20);
}

.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.amount-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
}

.amount-chip {
  font-size: 20rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}

.amount-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
  margin: 14rpx 0 10rpx;
  letter-spacing: 1rpx;
}

.amount-cny {
  font-size: 34rpx;
  font-weight: 500;
  margin-right: 6rpx;
}

.amount-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.amount-dot {
  color: rgba(255, 255, 255, 0.40);
}

.amount-note {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.20);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.6;
}

/* ---- ② 尚无支付单 ---- */
.nocp-body {
  padding: 8rpx 28rpx 28rpx;
}

.nocp-text {
  font-size: 26rpx;
  color: #3D4C63;
  line-height: 1.7;
}

.nocp-hint {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #F08C00;
  background: rgba(240, 140, 0, 0.08);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  line-height: 1.6;
}

/* 流水号等长串右对齐时允许折行 */
.mono {
  font-size: 23rpx;
  color: #3D4C63;
  word-break: break-all;
}

/* ---- ④ 资金状态留痕时间轴 ---- */
.tl {
  padding: 8rpx 28rpx 20rpx;
}

.tl-item {
  display: flex;
  gap: 20rpx;
}

.tl-rail {
  width: 32rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tl-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #E3E9F2;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.tl-line {
  width: 2rpx;
  flex: 1;
  background: #EEF1F6;
  margin-top: 6rpx;
}

.tl-item.tl-done .tl-dot {
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  box-shadow: 0 0 0 6rpx rgba(59, 91, 219, 0.12);
}

.tl-body {
  flex: 1;
  padding-bottom: 28rpx;
}

.tl-item:last-child .tl-body {
  padding-bottom: 4rpx;
}

.tl-title {
  font-size: 27rpx;
  font-weight: 500;
  color: #98A6B8;
}

.tl-item.tl-done .tl-title {
  font-weight: 600;
  color: #0F2540;
}

.tl-time {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #B7C2D0;
}

.tl-item.tl-done .tl-time {
  color: #6B7A8C;
}

.tl-note {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #98A6B8;
  line-height: 1.5;
  word-break: break-all;
}

.tl-foot {
  padding: 18rpx 28rpx 24rpx;
  border-top: 1rpx solid #F1F4F8;
  font-size: 22rpx;
  color: #98A6B8;
  line-height: 1.6;
}

/* ---- 兜底态 ---- */
.err-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx 28rpx;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(61, 90, 219, 0.08);
}

.err-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F2540;
}

.err-detail {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #6B7A8C;
  line-height: 1.6;
}

.err-btn {
  display: inline-block;
  margin-top: 32rpx;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  color: #FFFFFF;
  font-size: 28rpx;
}

/* ---- 底部固定操作条（提示行 + 按钮行） ---- */
.pay-bar {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}
