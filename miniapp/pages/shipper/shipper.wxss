/* 货主端首页（02）· 找船 */
page { background: #F5F7FA; }

.page-content { padding: 24rpx 24rpx 0; }

/* ---- 顶栏 ---- */
.top {
  background: linear-gradient(180deg, #E6EDFF 0%, #F2F6FF 100%);
  padding: calc(12rpx + env(safe-area-inset-top)) 28rpx 22rpx;
}
.top-row1 {
  display: flex;
  align-items: center;
  height: 78rpx;
}
/* 头像与用户 ID 样式在 app.wxss（.top-user/.avatar-vec/.top-user-id），货主与船东共用 */
.top-loc {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.loc-dot { font-size: 26rpx; }
.loc-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #14233B;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.caret { font-size: 22rpx; color: #7C8CA0; margin-left: 2rpx; }
.top-role {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  box-shadow: 0 2rpx 10rpx rgba(61, 90, 219, .10);
}
.top-role-label { font-size: 25rpx; color: #3B5BDB; font-weight: 600; }

.top-row2 {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 74rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 90, 219, .08);
}
.search-box-hover { background: #F7F9FF; }
.search-ico { font-size: 26rpx; }
.search-ph { font-size: 26rpx; color: #A8B4C4; }
.top-act {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 68rpx;
}
.act-glyph { font-size: 32rpx; line-height: 1.1; }
.act-label { font-size: 20rpx; color: #5C6B80; margin-top: 2rpx; }
.hover-dim { opacity: .6; }

/* ---- 我要发货 ---- */
.loc-value { flex: 1; display: flex; align-items: center; justify-content: flex-end; gap: 10rpx; }
.pin { font-size: 20rpx; line-height: 1; }
.pin-blue { color: #3B5BDB; }
.pin-purple { color: #7048E8; }

.dual-row {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 28rpx 8rpx;
}
.dual-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #F7F9FD;
  border: 1rpx solid #EDF1F8;
}
.dual-item-active { background: rgba(92, 124, 250, .07); border-color: rgba(92, 124, 250, .35); }
.dual-body { flex: 1; min-width: 0; }
.dual-label { font-size: 24rpx; color: #6B7A8C; }
.dual-value {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #3B5BDB;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dual-caret { font-size: 26rpx; color: #C3CCD8; }

.panel {
  margin: 0 28rpx 8rpx;
  border-radius: 16rpx;
  background: #FAFBFE;
  border: 1rpx dashed #DDE4F0;
  overflow: hidden;
}
.field-row-sm { min-height: 84rpx; padding: 0 24rpx; }

.card-cta {
  margin: 24rpx 28rpx 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 18rpx;
}
.cta-hover { opacity: .88; }
.card-tip {
  padding: 0 28rpx 26rpx;
  font-size: 22rpx;
  color: #A8B4C4;
  line-height: 1.5;
}
.row-hover { background: #F7F9FF; }

/* ---- 推荐船源 ---- */
.ship-list { padding: 4rpx 28rpx 20rpx; }
.ship-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1F4F8;
}
.ship-item:last-child { border-bottom: none; }
.ship-thumb {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #E8EEFF 0%, #E4DBFF 100%);
  font-size: 36rpx;
  line-height: 76rpx;
  text-align: center;
  flex-shrink: 0;
}
.ship-body { flex: 1; min-width: 0; }
.ship-name-row { display: flex; align-items: center; gap: 10rpx; }
.ship-name { font-size: 30rpx; font-weight: 600; color: #14233B; }
.ship-meta { margin-top: 6rpx; font-size: 24rpx; color: #8A99AC; }
.ship-side { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; }
.ship-home { font-size: 22rpx; color: #12B886; }
.ship-link { font-size: 23rpx; color: #3B5BDB; }

/* ---- 推荐航线 ---- */
.route-list { padding: 4rpx 28rpx 20rpx; }
.route-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F1F4F8;
}
.route-item:last-child { border-bottom: none; }
.route-body { flex: 1; }
.route-names { display: flex; align-items: center; gap: 14rpx; }
.route-name { font-size: 29rpx; font-weight: 600; color: #14233B; }
.route-arrow {
  font-size: 24rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  border-radius: 999rpx;
  padding: 0 14rpx;
  line-height: 34rpx;
}
.route-sub { margin-top: 6rpx; font-size: 23rpx; color: #8A99AC; }
.route-caret { font-size: 34rpx; color: #C3CCD8; font-weight: 300; }

/* ---- 我的货源快捷入口 ---- */
.my-entry-card { padding: 0; }
.my-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
}
.my-entry-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  background: rgba(59, 91, 219, .08);
  font-size: 32rpx;
  line-height: 68rpx;
  text-align: center;
}
.my-entry-body { flex: 1; }
.my-entry-title { font-size: 29rpx; font-weight: 600; color: #14233B; }
.my-entry-sub { margin-top: 4rpx; font-size: 23rpx; color: #8A99AC; }

/* ---- 校验失败字段高亮：把「缺什么」直接指到字段上（配合 onFindShips 的自动展开） ---- */
.field-row-miss { background: #FFF6F7; }
.field-row-miss .field-label { color: #C0455A; }
.field-row-miss .field-value-placeholder { color: #D98A96; }
/* 放在 .dual-item-active 之后：同时命中时以「缺失」配色优先 */
.dual-item-miss { background: #FFF6F7; border-color: #F3C6CD; }
