/* 05 发布空船（二级页） */
page { background: #F5F7FA; }

.page-sub { padding: 24rpx 24rpx 0; }
.section-card { margin-bottom: 24rpx; }

.row-hover { background: #F7F9FF; }
.hover-dim { opacity: .6; }
.cta-hover { opacity: .88; }

.preview-banner {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(112, 72, 232, .07);
  border: 1rpx solid rgba(112, 72, 232, .18);
  margin-bottom: 24rpx;
}
.preview-tag {
  font-size: 21rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #3B5BDB, #7048E8);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
  flex-shrink: 0;
}
.preview-text { font-size: 23rpx; color: #6B5AA8; }

.ship-brief {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 28rpx 22rpx;
  font-size: 24rpx;
  color: #6B7A8C;
}

.no-ship { padding: 40rpx 28rpx 32rpx; text-align: center; }
.no-ship-text { font-size: 25rpx; color: #8A99AC; line-height: 1.6; }
.no-ship-btn {
  display: inline-block;
  margin-top: 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #3B5BDB;
  background: rgba(59, 91, 219, .09);
  border: 1rpx solid rgba(59, 91, 219, .22);
}

.no-limit-tag {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #3B5BDB;
  background: rgba(59, 91, 219, .09);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  flex-shrink: 0;
}

.field-note {
  padding: 0 28rpx 24rpx;
  font-size: 22rpx;
  color: #A8B4C4;
}

.remark-box {
  position: relative;
  padding: 20rpx 28rpx 32rpx;
}
.remark-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 27rpx;
  color: #14233B;
  line-height: 1.6;
  box-sizing: border-box;
}
.remark-count {
  position: absolute;
  right: 28rpx;
  bottom: 10rpx;
  font-size: 22rpx;
  color: #B7C2D0;
}
